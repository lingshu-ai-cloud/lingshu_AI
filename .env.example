# 复制为 .env 并填入密钥

# 服务端口（默认 8788）
PORT=8788
# 本地单进程默认 all；Docker Compose 会为 app/worker 分别覆盖角色。
PROCESS_ROLE_SPLIT_ENABLED=false
PROCESS_ROLE=all
# Local JSON accounts/data are only for an intentional demo or isolated test.
# Normal development now uses PocketBase as the sole source of truth.
ENABLE_LOCAL_DEV_FALLBACK=false
# Local content-production walkthrough: skips workflow admission, evidence,
# budget, quality and material-match review gates so every production node can
# be inspected. The UI switch is honored only on a loopback host; the server
# switch is ignored when NODE_ENV=production. External paid-provider actions
# still require an explicit click. Set false to test the normal local flow.
CONTENT_CREATION_TEST_BYPASS=true
VITE_CONTENT_CREATION_TEST_BYPASS=true
# Required whenever ENABLE_LOCAL_DEV_FALLBACK=true; keep the same random value
# across restarts and instances or existing local demo sessions become invalid.
LOCAL_DEMO_TOKEN_SECRET=
# Runtime schema mutation is an emergency repair switch. Normal startup relies
# exclusively on versioned PocketBase migrations.
RUNTIME_SCHEMA_REPAIR_ENABLED=false
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_REQUESTS=300
# Number of trusted reverse proxies in front of Express. Leave 0 for direct
# local access; the production Docker topology has one Caddy proxy.
TRUST_PROXY_HOPS=0
LEGACY_JSON_UPLOAD_LIMIT_MB=32
VOICE_JSON_UPLOAD_LIMIT_MB=24
# Collapse short auth bursts while preserving bounded revocation latency.
# Maximum accepted value is 30000 ms; set 0 for immediate revocation semantics.
PB_AUTH_CACHE_TTL_MS=5000
PB_REQUEST_TIMEOUT_MS=10000
READINESS_CACHE_TTL_MS=2000

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── MiniMax 语音合成 / 真人音色克隆 ───────────────────────────────────────────
# 配置后配音会优先使用 MiniMax；普通音色走 T2A，录入真人音色会先 upload + voice_clone。
MINIMAX_API_KEY=
# 默认使用国际站 endpoint；如账号要求 GroupId，可填写下方两项。
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_GROUP_ID=
# MINIMAX_GROUP_ID_PARAM=GroupId
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_TTS_EMOTION=happy
# MINIMAX_TTS_SPEED=1
# MINIMAX_TTS_VOLUME=1
# MINIMAX_TTS_PITCH=0
# MINIMAX_TTS_SAMPLE_RATE=32000
# MINIMAX_TTS_BITRATE=128000
# 社媒正式口播：变更供应商策略版本会主动隔离旧缓存。
# TTS_PROVIDER_POLICY_VERSION=v1
# TTS_PREFER_EXPRESSIVE_PROVIDER=true
# TTS_ASR_QA_ENABLED=true
# TTS_ASR_QA_REQUIRED=true
# 克隆成功后立即用这句短文调用正式 TTS，避免音色因 7 天未激活被清理。
# MINIMAX_ACTIVATION_TEXT=你好，这是我的品牌授权音色。
# 可按语种/音色覆盖系统 voice_id，例如：
# MINIMAX_VOICE_ZH_V1=Chinese (Mandarin)_Warm_Bestie
# MINIMAX_VOICE_ZH_V2=Chinese (Mandarin)_Reliable_Executive
# MINIMAX_VOICE_EN_V1=English_FriendlyPerson

# Gemini TTS 不稳定时，可配置 Piper 做跨平台本地 TTS 兜底（Windows/macOS/Linux）。
# PIPER_BIN=/absolute/path/to/piper
# PIPER_MODEL_ZH=/absolute/path/to/zh_CN-huayan-medium.onnx
# PIPER_MODEL_EN=/absolute/path/to/en_US-lessac-medium.onnx
# PIPER_MODEL_ES=/absolute/path/to/es_ES-sharvard-medium.onnx
# PIPER_MODEL_AR=/absolute/path/to/ar_JO-kareem-medium.onnx
# 也可配置默认模型；未配置对应语种时使用默认模型。
# PIPER_MODEL=/absolute/path/to/default.onnx
# 真人音色克隆：安装 Coqui TTS 后填 CLI 路径，例如 /path/to/venv/bin/tts 或 Windows 的 tts.exe。
# XTTS_BIN=/absolute/path/to/tts
# XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# XTTS_TIMEOUT_MS=120000
# Gemini/Veo 视频生成默认关闭；当前视频生成走 Seedance。
GEMINI_VIDEO_ENABLED=false
# GEMINI_VIDEO_MODEL=veo-2.0-generate-001
# GEMINI_VIDEO_TIMEOUT_MS=360000
# GEMINI_VIDEO_POLL_INTERVAL_MS=10000

# ── Seedance / ModelArk 视频生成 ────────────────────────────────────────────
SEEDANCE_API_KEY=
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_FIRST_FRAME_ESTIMATED_CNY=0.22
# Optional short photo-talking admission estimate; see .env.production.example.
HEYGEN_PHOTO_ESTIMATED_CNY_PER_SECOND=
SEEDANCE_VIDEO_ENABLED=false
# 社媒零素材/概念画面；只有同时配置供应商 Key 时才会发起调用。
SOCIAL_AI_VISUAL_ENABLED=false
SOCIAL_AI_VISUAL_VIDEO_PROVIDER=seedance
SOCIAL_AI_VISUAL_MAX_COST_CNY_PER_SHOT=2
SOCIAL_AI_VISUAL_TIMEOUT_MS=180000
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_REFERENCE_ENABLED=false
# 逐句复刻会先用千问 Image 重建“原构图 + 企业人物”的目标首帧，再交给 Seedance 延展视频。
# 启用前还必须配置 DASHSCOPE_API_KEY，以及下方完整的对象存储 endpoint/access key/secret/bucket。
SEEDANCE_SENTENCE_ENABLED=false
SEEDANCE_SENTENCE_RESOLUTION=720p
# 逐句人物首帧使用千问 Image 多图编辑。默认模型支持源镜头首帧和人物参考图输入。
QWEN_IMAGE_MODEL=qwen-image-3.0
# DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOCIAL_QWEN_IMAGE_ESTIMATED_COST_CNY=0.3
SEEDANCE_REFERENCE_ESTIMATED_CNY_PER_SECOND=
SEEDANCE_REFERENCE_RESOLUTION=720p
SEEDANCE_REFERENCE_GENERATE_AUDIO=true
# Optional verified invoice conversion for task-level reconciliation.
SEEDANCE_CNY_PER_1K_TOKENS=
# SEEDANCE_VIDEO_TIMEOUT_MS=600000
# SEEDANCE_VIDEO_POLL_INTERVAL_MS=8000
# 正式 customer 租户的 Seedance 月预算硬限制。按保守单价预占，防止账单超过上限。
SEEDANCE_TENANT_MONTHLY_BUDGET_CNY=200
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_480P=0.9
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_720P=1.5
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_1080P=3

# ── HeyGen 数字人口播（第三方服务，无需本地 GPU） ──────────────────────────
# 服务端密钥，禁止写入前端变量。流程说明见 docs/HeyGen与多语言验收.md。
HEYGEN_API_KEY=
# 只有明确设为 true，且预算账本准入时才允许提交付费口播或人物创建。
HEYGEN_GENERATION_ENABLED=false
# HeyGen 私人音色与人物仅对绑定的企业开放；不要将同一工作区私人资产暴露给其他租户。
HEYGEN_PRIVATE_ASSET_TENANT_ID=
# 创建照片人物和视频分身必须分别配置预算预留；留空时对应创建入口禁用，避免未设上限的付费请求。
# 这些金额是本地准入预占，不是 HeyGen 最终账单或供应商侧硬限额。
STUDIO_PRESENTER_PAID_BUDGET_CNY=
STUDIO_PRESENTER_PAID_OPENING_USED_CNY=
STUDIO_HEYGEN_PHOTO_AVATAR_RESERVE_CNY=
STUDIO_HEYGEN_DIGITAL_TWIN_RESERVE_CNY=
# 单镜 HeyGen 口播与 ASR 的独立预算账本；四项金额都必须明确配置，否则付费提交保持关闭。
STUDIO_PAID_BUDGET_CNY=
STUDIO_PAID_OPENING_USED_CNY=
STUDIO_HEYGEN_RESERVE_CNY=
STUDIO_ASR_RESERVE_CNY=
HEYGEN_ESTIMATED_CNY_PER_SECOND=
# 下列字段仅用于读取历史私有推理服务任务；新建任务统一使用 HeyGen。
# DIGITAL_HUMAN_API_URL=
# DIGITAL_HUMAN_API_KEY=

# ── PocketBase ───────────────────────────────────────────────────────────────
PB_URL=http://localhost:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# ── 腾讯云 PostgreSQL + Redis/BullMQ ────────────────────────────────────────
# 本地默认仍使用 PocketBase；迁移演练通过后，将 DATA_BACKEND 改为 postgres。
DATA_BACKEND=pocketbase
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_APPLICATION_NAME=lingshu-ai-local
# local 保留进程内兼容队列；生产切换为 bullmq 并配置腾讯云 Redis。
QUEUE_BACKEND=local
REDIS_URL=
BULLMQ_PREFIX=lingshu-local
SOCIAL_CONTENT_PRODUCTION_CONCURRENCY=1
# Durable content queue. Database limits configured in 用户管理 override these
# defaults per customer, social account and task type.
CONTENT_EXECUTION_WORKER_CONCURRENCY=4
CONTENT_EXECUTION_POLL_INTERVAL_MS=2000
CONTENT_EXECUTION_LEASE_MS=1800000
CONTENT_MAX_RUNNING_PER_TENANT=2
CONTENT_MAX_RUNNING_PER_ACCOUNT=1
CONTENT_MAX_RUNNING_PER_TASK_TYPE=2
CONTENT_NETWORK_MAX_ATTEMPTS=4
CONTENT_SYSTEM_MAX_ATTEMPTS=3
CONTENT_RECONCILIATION_MAX_ATTEMPTS=12

# ── 订阅收费墙 ───────────────────────────────────────────────────────────────
# true = studio 路由（AI 脚本/选材/封面/文案/渲染）要求登录 + 有效订阅，否则 401/402
# 留空 / false = 直通开放（默认，便于本地开发与 demo）
SUBSCRIPTION_ENFORCED=false
# 渲染授权令牌签名密钥（HMAC）。生产务必改成随机长字符串。
RENDER_TOKEN_SECRET=
# Product API bearer keys are stored only as HMAC-SHA256 digests. Use an
# independent random value of at least 32 bytes; changing it revokes all keys.
PRODUCT_API_KEY_PEPPER=

# ── Demo / 测试账号额度 ──────────────────────────────────────────────────────
# DEMO_MODE=true 或 trial/trialing 账号生效。试用期固定 5 天。
# 注册为白名单激活模式：必须配置允许账号，否则注册接口默认拒绝。
# DEMO_ALLOWED_ACCOUNTS=test1@example.com,test2@example.com
# DEMO_DAILY_TOKEN_LIMIT=30000
# DEMO_TOTAL_TOKEN_LIMIT=30000

# ── 本地管理员账号 ──────────────────────────────────────────────────────────
# 仅在非生产环境启用，用于登录管理员控制台；不要与试用账号共用。
# LOCAL_ADMIN_EMAIL=admin@local.test
# LOCAL_ADMIN_PASSWORD=change-me-to-a-strong-password
# ADMIN_DASHBOARD_EMAILS=admin@local.test
# 管理员临时进入租户后台的 HMAC 签名密钥。生产环境必须设置。
# 可用 `openssl rand -base64 32` 生成；运维访问默认关闭，客户显式授权后会话默认有效 30 分钟。
# SUPPORT_ACCESS_SECRET=
# SUPPORT_ACCESS_TTL_MINUTES=30
# 私有素材短期访问链接与素材会话签名密钥（生产必须配置）
# ASSET_ACCESS_SECRET=

# ── 素材存储：开发使用本地，生产使用腾讯 COS ─────────────────────────────────
OBJECT_STORAGE_DRIVER=local
LOCAL_OBJECT_STORAGE_ROOT=data/media/object-storage
# 只有显式配置公网 HTTPS 地址后，本地存储产物才能交给外部视频供应商及千问数字人源字幕对齐服务读取。
LOCAL_OBJECT_STORAGE_PUBLIC_BASE_URL=
# 生产环境设置 OBJECT_STORAGE_DRIVER=cos，并填写以下四项。
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_URL=
# 大文件自动走 COS 分块上传；失败会主动终止分块，避免常规失败遗留碎片。
OBJECT_STORAGE_MULTIPART_THRESHOLD_BYTES=20971520
# 只清理操作系统临时目录中带灵枢固定前缀的过期工作区，不删除 COS 对象。
LOCAL_TEMP_CLEANUP_ENABLED=true
LOCAL_TEMP_RETENTION_HOURS=24
LOCAL_TEMP_CLEANUP_INTERVAL_HOURS=6
# 以下 R2 字段只保留给历史备份迁移脚本，不再用于应用素材存储。
R2_BACKUP_PREFIX=lingshu-backups
R2_BACKUP_LOCAL_RETENTION_DAYS=7

# ── (可选) 千问 / DashScope ──────────────────────────────────────────────────
OVERSEAS_LLM_BACKEND=qwen
STUDIO_SCRIPT_BACKEND=qwen
VIDEO_ANALYSIS_PROVIDER=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── TikTok 采集 / Apify 兜底 ─────────────────────────────────────────────────
# 本地采集优先；本地失败后使用 Apify 兜底。设为 0 可关闭对应兜底。
APIFY_TOKEN=
# 云服务器建议保留 Apify 兜底；IG actor 采用异步 run + 轮询，超时可按网络情况调大。
# APIFY_TIMEOUT_MS=240000
# APIFY_VIDEO_TIMEOUT_MS=240000
# APIFY_POLL_INTERVAL_MS=5000
APIFY_TIKTOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIKTOK_VIDEO_FALLBACK_ENABLED=1
# 视频下载兜底额度：单账号每天最多 3 条，全服务器每天最多 25 条。
APIFY_TIKTOK_VIDEO_TENANT_DAILY_LIMIT=3
APIFY_TIKTOK_VIDEO_DAILY_LIMIT=25

# ── Instagram 采集：Apify 为主，不使用服务器登录态 cookie ────────────────────
# IG 封了匿名访问；账号主页/关键词默认走 Apify，避免使用客户或采集账号登录态。
# 视频下载兜底与 TikTok 共用同一份日额度（APIFY_TIKTOK_VIDEO_*_DAILY_LIMIT）。
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_CRAWL_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_VIDEO_FALLBACK_ENABLED=1
# yt-dlp 登录态 cookie（Netscape cookies.txt，逗号分隔多个）。
# 仅用于我们自己的 YouTube / TikTok 采集账号；Facebook / Instagram 默认不读取该 cookie。
YT_DLP_COOKIE_FILES=

# ── Facebook 对标账号主页采集：Apify posts actor 为主，公开搜索兜底 ─────────────
# Facebook 关键词仍走公开视频搜索；账号主页默认走 Apify，actor 会只收视频帖、跳过图片帖。
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_FACEBOOK_CRAWL_FALLBACK_ENABLED=1

# ── 本地 Mac 采集 Worker ─────────────────────────────────────────────────────
# 云服务器和 Mac worker 必须配置同一个 token。生产环境必须改成随机长字符串。
# Mac 上的 worker 会轮询 CRAWL_WORKER_SERVER_URL，把 YouTube / TikTok 任务拉到本机执行。
# CRAWL_WORKER_TOKEN=

# Agent Worker 上报真实页面导航、点击、输入和截图事件时使用。
# 生产环境必须配置随机长字符串，并通过 x-agent-worker-token 传递。
# AGENT_WORKER_TOKEN=
# CRAWL_WORKER_SERVER_URL=https://your-server.example.com
# CRAWL_WORKER_ID=mac-studio-01
# CRAWL_WORKER_POLL_MS=15000
# Mac 离线/任务失败兜底：任务排队超过该时间、租约过期或 worker 标记失败后由云端接管。
# TikTok 账号主页云端接管会优先走 Apify；YouTube 走云端 yt-dlp/匿名抓取。
CRAWL_WORKER_CLOUD_FALLBACK_ENABLED=1
# CRAWL_WORKER_CLOUD_FALLBACK_AFTER_MS=120000
# CRAWL_WORKER_CLOUD_FALLBACK_POLL_MS=30000

# Social account OAuth. Fill these only in local .env or server .env.production.
# Do not commit real OAuth client secrets to Git.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
ADVANCED_MANUAL_CONNECT_ENABLED=false
# Legacy official-account scheduler performs external publishing. It is always
# opt-in and requires the durable_operation_leases migration before enabling.
PUBLISH_SCHEDULER_ENABLED=false
PUBLISH_SCHEDULER_LEASE_MS=1800000
LEGACY_EXTERNAL_EFFECT_LEASE_MS=1800000
STARTER_RUN_MUTATION_LEASE_MS=300000
# 数字员工后台编排器：持续推进运行状态，并按配置生成阶段复盘。
DIGITAL_EMPLOYEE_RUNTIME_ENABLED=true
DIGITAL_EMPLOYEE_RUNTIME_INTERVAL_MS=60000
DIGITAL_EMPLOYEE_RUNTIME_MAX_RUNS=200
# 198 标准版专用执行器。当前数据库租约尚未支持跨进程 CAS，只允许一个实例显式开启。
STARTER_198_ORCHESTRATOR_WORKER_ENABLED=false
STARTER_198_ORCHESTRATOR_WORKER_INTERVAL_MS=30000
STARTER_198_ORCHESTRATOR_WORKER_MAX_RUNS=20
# 198 发布包与报价文件修复 Worker 均为严格显式启用。先完成 PocketBase
# migrations、确认 PB_URL/管理员凭据和持久化 data 卷，再只在一个实例改为 true。
STARTER_PUBLICATION_PACKAGE_WORKER_ENABLED=false
STARTER_PUBLICATION_PACKAGE_WORKER_INTERVAL_MS=15000
STARTER_PUBLICATION_PACKAGE_WORKER_LEASE_MS=1800000
STARTER_QUOTE_ARTIFACT_WORKER_ENABLED=false
STARTER_QUOTE_ARTIFACT_WORKER_INTERVAL_MS=30000
STARTER_QUOTE_ARTIFACT_WORKER_MAX_DRAFTS=100
STARTER_QUOTE_ARTIFACT_WORKER_MAX_TENANTS=100

# Agent 真实浏览器执行与监控直播。启用后，制作/采集/分层/草稿步骤由
# 原业务页面内的 Chromium 按钮点击触发；观察大屏不会额外启动业务任务。
DIGITAL_EMPLOYEE_BROWSER_EXECUTION=false
# 留空时自动寻找本机 Chrome / Chromium，不复用用户浏览器资料。
AGENT_BROWSER_EXECUTABLE_PATH=
AGENT_BROWSER_MAX_SESSIONS=12
# 原应用地址：生产使用同环境后端；本地 Vite 开发可用 http://127.0.0.1:5177。
AGENT_BROWSER_APP_ORIGIN=http://127.0.0.1:8790

# 广告专用应用（独立于社媒发布授权）。版本按当前获批应用支持范围设置。
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_API_VERSION=
# 生产站点的 HTTPS 回调，路径必须一致。
META_ADS_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=
# 兼容旧 Google Ads 应用；新 Cloud 项目权限以平台配置为准。
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 启用后台真实广告优化前，先完成账户连接、计划授权与自动规则配置。
PLATFORM_ADS_AUTOMATION_ENABLED=false
# Production defaults to disabled. First release: paused_only (Meta create/pause only).
# full requires separately completed live-delivery acceptance and authorization.
PLATFORM_ADS_RELEASE_MODE=paused_only

# 团队 AI 账号与 Codex 用量管理台。开发环境默认可用；生产环境必须显式设为 true。
# Provider 登录只保留在成员自己的电脑；中台数据目录只保存归属、租约、脱敏快照和用量事件。
ACCOUNT_HUB_ENABLED=false
# ACCOUNT_HUB_DATA_DIR=/absolute/encrypted-volume/account-hub
# 以下 CLI 路径只在成员本机连接器进程读取，不用于服务端登录或注销。
# ACCOUNT_HUB_CODEX_BIN=/absolute/path/to/codex
# ACCOUNT_HUB_CLAUDE_BIN=/absolute/path/to/claude

# 智能报价能力包：生产环境需显式开启，便于灰度与快速回退。
QUOTE_SKILL_ENABLED=false
# 可选：逗号分隔的租户 ID。留空表示对全部租户开放。
QUOTE_SKILL_TENANT_ALLOWLIST=

# Runway Act-Two 仅作为分镜内参考人物技术栈；默认关闭。需要对象存储、逐镜预算与月度预算同时配置。
RUNWAY_ACT_TWO_ENABLED=false
RUNWAYML_API_SECRET=
RUNWAY_ACT_TWO_CNY_PER_CREDIT=
RUNWAY_ACT_TWO_ESTIMATED_CNY_PER_SECOND=
DIGITAL_HUMAN_REFERENCE_MAX_CNY_PER_SHOT=
DIGITAL_HUMAN_REFERENCE_MONTHLY_BUDGET_CNY=
DIGITAL_HUMAN_MAX_ATTEMPTS_PER_SHOT=3
DIGITAL_HUMAN_MAX_FIRST_FRAMES_PER_VIDEO=3
DIGITAL_HUMAN_FIRST_FRAME_BUDGET_CNY=2
# 逗号分隔的供应商输出域名后缀；留空时仅接受 CloudFront HTTPS 输出。
RUNWAY_OUTPUT_HOST_SUFFIXES=
# 显式指向已安装 opencv/mediapipe/skimage 的隔离 Python；留空则姿态、手部和背景改为人工验收。
DIGITAL_HUMAN_VISUAL_QA_PYTHON=
DIGITAL_HUMAN_SEMANTIC_QA_ENABLED=false
QWEN_DIGITAL_HUMAN_QA_MODEL=qwen3-vl-flash
QWEN_FIRST_FRAME_ESTIMATED_CNY=0.22
DIGITAL_HUMAN_FAST_HEAD_ENABLED=false
DIGITAL_HUMAN_FAST_HEAD_PYTHON=

# Volcengine Ark real-person enrollment and Assets API.
# Uses Access Key credentials, separate from SEEDANCE_API_KEY. Never expose these to the browser.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_ARK_ASSET_REGION=cn-beijing
VOLCENGINE_ARK_PROJECT_NAME=default
# Public HTTPS app origin used as the return destination after Ark's one-time liveness check.
PUBLIC_BASE_URL=
# Non-presenter storyboard AIGC project budget estimates (CNY)
STORYBOARD_AIGC_BATCH_BUDGET_CNY=30
STORYBOARD_AIGC_MAX_RETRIES=1
STORYBOARD_AIGC_FIRST_FRAME_ESTIMATED_CNY=0.3
STORYBOARD_CLONE_GEOMETRY_QWEN_ENABLED=false
STORYBOARD_AIGC_CLONE_GEOMETRY_ESTIMATED_CNY=0.1
