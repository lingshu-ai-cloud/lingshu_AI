# 灵枢 AI 本地部署统一配置模板
# 复制为 ~/.config/lingshu-ai/.env.local 后填写；绝对不要提交真实值到 Git。

# ── 核心大模型 ──────────────────────────────────────────────────────────────
# 至少配置 Gemini 或 DashScope 其中一个；推荐以 Qwen 为默认、Gemini 做视觉能力。
OVERSEAS_LLM_BACKEND=qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VIDEO_ENABLED=false
# GEMINI_PROXY=http://127.0.0.1:7890

# ── 社媒采集 / Apify 兜底 ───────────────────────────────────────────────────
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_TIKTOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIKTOK_VIDEO_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_CRAWL_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_VIDEO_FALLBACK_ENABLED=1
APIFY_FACEBOOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIMEOUT_MS=240000
APIFY_VIDEO_TIMEOUT_MS=240000

# 仅填写自有采集账号导出的 cookies.txt；不要分享个人浏览器 Cookie。
YT_DLP_COOKIE_FILES=

# ── 配音 / 音色克隆 ─────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_GROUP_ID=

# ── 视频生成 ────────────────────────────────────────────────────────────────
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=true
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128

# ── PocketBase ──────────────────────────────────────────────────────────────
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_AUTO_START=false

# ── Cloudflare R2（不使用云素材存储时可留空）────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=overseas-assets
R2_PUBLIC_URL=

# ── 社媒发布 OAuth（仅需抓取时可留空）───────────────────────────────────────
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── 本地应用 ────────────────────────────────────────────────────────────────
PORT=8790
PROCESS_ROLE=all
DEMO_MODE=true
SUBSCRIPTION_ENFORCED=false
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=
ADMIN_DASHBOARD_EMAILS=admin@local.test

# 以下签名密钥每台环境单独随机生成，不应多人共用。
RENDER_TOKEN_SECRET=
OAUTH_STATE_SECRET=
ASSET_ACCESS_SECRET=
SUPPORT_ACCESS_SECRET=
SUPPORT_ACCESS_TTL_MINUTES=30
TENANT_PLATFORM_APP_KEY=
# 独立生成至少 32 字节；修改此值会使所有已签发 Product API 密钥失效。
PRODUCT_API_KEY_PEPPER=

# Legacy official-account publishing remains off unless a designated worker is
# intentionally enabled after applying the durable operation lease migration.
PUBLISH_SCHEDULER_ENABLED=false
PUBLISH_SCHEDULER_LEASE_MS=1800000
LEGACY_EXTERNAL_EFFECT_LEASE_MS=1800000
STARTER_RUN_MUTATION_LEASE_MS=300000
# 数字员工 WhatsApp 批量跟进：部署确认后再显式开启，且只允许单活 Worker；租户授权、批次审批和 Meta 凭据仍是强制门槛。
FOLLOWUP_WORKER_ENABLED=false
FOLLOWUP_WORKER_INTERVAL_MS=15000
FOLLOWUP_WORKER_MAX_ATTEMPTS=3
FOLLOWUP_WORKER_RECIPIENT_DELAY_MS=1000
DIGITAL_EMPLOYEE_RUNTIME_ENABLED=true
DIGITAL_EMPLOYEE_RUNTIME_INTERVAL_MS=60000
DIGITAL_EMPLOYEE_RUNTIME_MAX_RUNS=200
# 本地按需开启；不要与另一台 starter_198 worker 同时消费同一数据库。
STARTER_198_ORCHESTRATOR_WORKER_ENABLED=false
STARTER_198_ORCHESTRATOR_WORKER_INTERVAL_MS=30000
STARTER_198_ORCHESTRATOR_WORKER_MAX_RUNS=20
# 默认关闭。完成 starter migrations、确认 PB 管理凭据与 data/publishing-uploads
# 持久目录后，按需在唯一消费实例显式改为 true。
STARTER_PUBLICATION_PACKAGE_WORKER_ENABLED=false
STARTER_PUBLICATION_PACKAGE_WORKER_INTERVAL_MS=15000
STARTER_PUBLICATION_PACKAGE_WORKER_LEASE_MS=1800000
STARTER_QUOTE_ARTIFACT_WORKER_ENABLED=false
STARTER_QUOTE_ARTIFACT_WORKER_INTERVAL_MS=30000
STARTER_QUOTE_ARTIFACT_WORKER_MAX_DRAFTS=100
STARTER_QUOTE_ARTIFACT_WORKER_MAX_TENANTS=100
