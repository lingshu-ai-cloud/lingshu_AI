# Audit base: 73c78766c985871cd925453aeb5f3e937ec8b3f7
# Review template only. Never source this file or start services with it.
# Merge into complete production config through approved secret manager.
NODE_ENV=production
DATA_BACKEND=postgres
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@postgres.invalid:5432/REPLACE_DATABASE
# require encrypts without certificate validation; verify-full validates CA.
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=10
DATABASE_APPLICATION_NAME=lingshu-infrastructure-review
QUEUE_BACKEND=bullmq
REDIS_URL=rediss://:REPLACE_PASSWORD@redis.invalid:6379/0
BULLMQ_PREFIX=REPLACE_INSTALLATION_PREFIX
BULLMQ_HEALTH_TIMEOUT_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_MAX_AGE_MS=60000
PROCESS_ROLE_SPLIT_ENABLED=true
# Review profile has no background worker. Compose overrides worker role.
PROCESS_ROLE=web
DISABLE_LOCAL_AUTH_FALLBACK=true
ENABLE_LOCAL_DEV_FALLBACK=false
PB_URL=http://pocketbase:8090
PB_ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
PB_ADMIN_PASSWORD=REPLACE_PB_PASSWORD
PB_AUTH_CACHE_TTL_MS=5000
PB_REQUEST_TIMEOUT_MS=10000
RUNTIME_SCHEMA_REPAIR_ENABLED=false
PORT=8788
APP_HOST_PORT=18788
READINESS_CACHE_TTL_MS=2000
# Operational acceptance requires the full agreed capabilities, never trim to pass.
REQUIRED_CAPABILITIES=text_generation,qwen_generation,platform_ads
RENDER_TOKEN_SECRET=REPLACE_RENDER_SECRET
TENANT_PLATFORM_APP_KEY=REPLACE_PLATFORM_APP_KEY
SUPPORT_ACCESS_SECRET=REPLACE_SUPPORT_SECRET
ASSET_ACCESS_SECRET=REPLACE_ASSET_SECRET
OAUTH_STATE_SECRET=REPLACE_OAUTH_SECRET
PRODUCT_API_KEY_PEPPER=REPLACE_PRODUCT_API_KEY_PEPPER
# Admin provisioning secrets, distinct from PB superuser.
WORKBENCH_ADMIN_EMAIL=REPLACE_WORKBENCH_EMAIL
WORKBENCH_ADMIN_PASSWORD=REPLACE_WORKBENCH_PASSWORD
# Files must retain stable object keys and be separately backed up.
OBJECT_STORAGE_DRIVER=cos
OBJECT_STORAGE_ENDPOINT=https://objects.invalid
OBJECT_STORAGE_REGION=REPLACE_REGION
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_OBJECT_ACCESS_KEY
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_OBJECT_SECRET
OBJECT_STORAGE_BUCKET_NAME=REPLACE_BUCKET
# Preparation: mutation/crawl/provider workers off; web profile is the primary guard.
MIGRATION_APPLY=false
MIGRATION_COPY_FILES=false
MIGRATION_RUN_ID=REPLACE_UNIQUE_MIGRATION_RUN_ID
PUBLISH_SCHEDULER_ENABLED=false
FOLLOWUP_WORKER_ENABLED=false
STARTER_198_ORCHESTRATOR_WORKER_ENABLED=false
STARTER_PUBLICATION_PACKAGE_WORKER_ENABLED=false
STARTER_QUOTE_ARTIFACT_WORKER_ENABLED=false
DIGITAL_EMPLOYEE_RUNTIME_ENABLED=false
AGENT_NOTIFICATION_OUTBOX_WORKER_ENABLED=false
SOCIAL_WEEKLY_REVIEW_WORKER_ENABLED=false
SOCIAL_WEEKLY_EXECUTION_WORKER_ENABLED=false
SOCIAL_WEEKLY_PUBLISHING_WORKER_ENABLED=false
SOCIAL_WEEKLY_REAL_PUBLISHING_ENABLED=false
SOCIAL_ENGAGEMENT_INGESTION_WORKER_ENABLED=false
PLATFORM_ADS_AUTOMATION_ENABLED=false
CRAWLER_OPS_WORKER_ENABLED=0
PB_VIDEO_BACKFILL_ENABLED=false
INSTAGRAM_CONTENT_PUBLISH_ENABLED=false
HEYGEN_GENERATION_ENABLED=false
SEEDANCE_VIDEO_ENABLED=false
SOCIAL_AI_VISUAL_ENABLED=false
QUOTE_SKILL_ENABLED=false
PUBLISH_SCHEDULER_LEASE_MS=1800000
LEGACY_EXTERNAL_EFFECT_LEASE_MS=1800000
STARTER_RUN_MUTATION_LEASE_MS=300000
STARTER_PUBLICATION_PACKAGE_WORKER_LEASE_MS=1800000
SOCIAL_CONTENT_PRODUCTION_CONCURRENCY=1
CONTENT_EXECUTION_WORKER_CONCURRENCY=4
CONTENT_EXECUTION_POLL_INTERVAL_MS=2000
CONTENT_EXECUTION_LEASE_MS=1800000
CONTENT_MAX_RUNNING_PER_TENANT=2
CONTENT_MAX_RUNNING_PER_ACCOUNT=1
CONTENT_MAX_RUNNING_PER_TASK_TYPE=2
CONTENT_NETWORK_MAX_ATTEMPTS=4
CONTENT_SYSTEM_MAX_ATTEMPTS=3
CONTENT_RECONCILIATION_MAX_ATTEMPTS=12
# Paid/provider credentials deliberately absent from preparation.
DASHSCOPE_API_KEY=
GEMINI_API_KEY=
APIFY_TOKEN=
YOUTUBE_API_KEY=
