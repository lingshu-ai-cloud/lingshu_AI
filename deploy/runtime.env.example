# Copy this file to /opt/lingshu/<environment>/.env.runtime on that server.
# Keep the real file on the server only and set its mode to 600.

APP_DOMAIN=internal.example.com
PUBLIC_BASE_URL=https://internal.example.com

PORT=8788
PB_URL=http://pocketbase:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

GEMINI_API_KEY=
MINIMAX_API_KEY=
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=false
APIFY_TOKEN=

SUBSCRIPTION_ENFORCED=false
RENDER_TOKEN_SECRET=
DIGITAL_HUMAN_ACCEPTANCE_ATTESTATION_SECRET=
RENDER_AUTHORIZATIONS_FILE=/app/data/render-authorizations.json
STUDIO_RENDER_JOBS_FILE=/app/data/studio-render-jobs.json
STUDIO_RENDER_LEASE_MINUTES=45
STUDIO_RENDER_BATCH_TOKEN_TTL_SECONDS=3600
REGISTRATION_CREDENTIAL_KEY=
SUPPORT_ACCESS_SECRET=
ASSET_ACCESS_SECRET=
TENANT_PLATFORM_APP_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=overseas-assets
R2_PUBLIC_URL=
R2_BACKUP_PREFIX=lingshu-backups

# Public server side of the Windows GPU pull-worker channel.
DIGITAL_HUMAN_PULL_WORKER_ENABLED=true
DIGITAL_HUMAN_PROVIDER=musetalk-v1.5-local
DIGITAL_HUMAN_PUBLIC_BASE_URL=https://internal.example.com
DIGITAL_HUMAN_WORKER_CREDENTIALS_JSON=
# DIGITAL_HUMAN_ALLOW_LEGACY_WORKER_KEY_BREAK_GLASS=false
DIGITAL_HUMAN_WORKER_LEASE_MS=120000
DIGITAL_HUMAN_WORKER_MAX_ATTEMPTS=3
DIGITAL_HUMAN_WORKER_ONLINE_TTL_MS=90000
DIGITAL_HUMAN_WORKER_MIN_TOTAL_VRAM_MB=7000
DIGITAL_HUMAN_WORKER_MIN_FREE_VRAM_MB=3500
DIGITAL_HUMAN_WORKER_MIN_DISK_FREE_BYTES=5368709120
DIGITAL_HUMAN_FFPROBE_PATH=/usr/bin/ffprobe
DIGITAL_HUMAN_SERVER_PROBE_TIMEOUT_MS=180000

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

ADVANCED_MANUAL_CONNECT_ENABLED=false
CRAWL_WORKER_CLOUD_FALLBACK_ENABLED=1
