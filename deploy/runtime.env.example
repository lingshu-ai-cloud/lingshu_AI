# Copy this file to /opt/lingshu/<environment>/.env.runtime on that server.
# Keep the real file on the server only and set its mode to 600.

APP_DOMAIN=internal.example.com
PUBLIC_BASE_URL=https://internal.example.com

PORT=8788
PB_URL=http://pocketbase:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

GEMINI_API_KEY=
MINIMAX_API_KEY=
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=false
APIFY_TOKEN=

SUBSCRIPTION_ENFORCED=false
RENDER_TOKEN_SECRET=
REGISTRATION_CREDENTIAL_KEY=
SUPPORT_ACCESS_SECRET=
ASSET_ACCESS_SECRET=
TENANT_PLATFORM_APP_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=overseas-assets
R2_PUBLIC_URL=
R2_BACKUP_PREFIX=lingshu-backups

YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

ADVANCED_MANUAL_CONNECT_ENABLED=false
CRAWL_WORKER_CLOUD_FALLBACK_ENABLED=1

# Deployment metadata is stored in .release.env, not here. Existing Compose
# installations must first be adopted with deploy/adopt-existing-release.sh.
