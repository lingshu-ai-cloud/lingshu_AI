{
  "fonts": {
    "sans": "\"SF Pro Text\",\"PingFang SC\",\"Noto Sans SC\",ui-sans-serif,system-ui,sans-serif",
    "mono": "\"SFMono-Regular\",ui-monospace,monospace"
  },
  "typography": {
    "display": {
      "size": 36,
      "line": 44,
      "weight": 600
    },
    "headline": {
      "size": 28,
      "line": 36,
      "weight": 600
    },
    "title-large": {
      "size": 20,
      "line": 28,
      "weight": 600
    },
    "title-medium": {
      "size": 16,
      "line": 24,
      "weight": 600
    },
    "title-small": {
      "size": 14,
      "line": 22,
      "weight": 600
    },
    "body-large": {
      "size": 16,
      "line": 24,
      "weight": 400
    },
    "body-medium": {
      "size": 14,
      "line": 22,
      "weight": 400
    },
    "body-small": {
      "size": 12,
      "line": 18,
      "weight": 400
    },
    "label-large": {
      "size": 14,
      "line": 20,
      "weight": 600
    },
    "label-medium": {
      "size": 12,
      "line": 18,
      "weight": 500
    },
    "label-small": {
      "size": 11,
      "line": 18,
      "weight": 500
    },
    "metric": {
      "size": 24,
      "line": 32,
      "weight": 600
    }
  },
  "colors": {
    "bg": "#FFFFFF",
    "text": "#171717",
    "text-secondary": "#52525B",
    "text-tertiary": "#71717A",
    "fill": "#F5F5F5",
    "border": "#D4D4D8",
    "border-secondary": "#E4E4E7",
    "primary": "#2563EB",
    "violet": "#6546E8",
    "info-bg": "#EFF6FF",
    "success": "#168568",
    "success-bg": "#EDF8F4",
    "warning": "#A16207",
    "warning-bg": "#FFFBEB",
    "error": "#DC3545",
    "error-bg": "#FFF1F2",
    "selected": "#F4F4F5",
    "hover": "#FAFAFA",
    "disabled": "#A1A1AA",
    "primary-hover": "#93C5FD",
    "primary-active": "#4338CA",
    "mask": "rgba(24, 24, 27, .32)",
    "on-primary": "#FFFFFF"
  },
  "gradients": {
    "action": "linear-gradient(110deg, #2563EB 0%, #6546E8 100%)",
    "action-hover": "linear-gradient(110deg, #1D4ED8 0%, #5635D6 100%)",
    "progress": "linear-gradient(110deg, #36A2EB 0%, #9966FF 100%)"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radius": {
    "control": 6,
    "panel": 8,
    "overlay": 10
  },
  "control": {
    "small": 32,
    "default": 36,
    "large": 40,
    "touch": 44
  },
  "shadow": {
    "overlay": "0 16px 48px rgba(24, 24, 27, .14)",
    "secondary": "0 10px 30px rgba(24, 24, 27, .10)"
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 150,
      "exit": 200,
      "enter": 250,
      "standard": 300,
      "slow": 400
    },
    "ease": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0,
        1
      ],
      "exit": [
        0.3,
        0,
        1,
        1
      ]
    },
    "spring": {
      "fast": 1400,
      "standard": 700,
      "slow": 300
    },
    "dampingRatio": 0.9
  }
}
