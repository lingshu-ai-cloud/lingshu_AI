# `data/` is runtime state mounted separately by Compose. It may contain tenant
# identities, auth registries, customer conversations, uploads and provider
# receipts. No file below it is permitted in a Docker build context; immutable
# demo media belongs under public/demo instead.
data/
data/**

*.bak.*
*.tmp
*.log
# Runtime UI assets under public/ include PNG/GIF files. Generated media is
# excluded by the data directories above instead of a global extension rule.
