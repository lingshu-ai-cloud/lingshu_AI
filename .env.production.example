# Copy this file to .env.production on the server and fill real values.

# Public application domain. Point its DNS A record to your server IPv4.
APP_DOMAIN=lingshu.site
PUBLIC_BASE_URL=https://lingshu.site

# PocketBase version used by Dockerfile.pocketbase.
PB_VERSION=0.39.9
# These external volumes must be created explicitly before first start. Never
# point them at preview/test volumes.
PB_DATA_VOLUME_NAME=lingshu-production-pb-data
APP_DATA_VOLUME_NAME=lingshu-production-app-data

# PocketBase stays on the private Docker network. The container creates or
# updates this superuser during startup; never expose port 8090 publicly.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-strong-password

# Workbench administrator. This is a normal application login account and is
# intentionally separate from the PocketBase superuser above.
WORKBENCH_ADMIN_EMAIL=ops@example.com
WORKBENCH_ADMIN_PASSWORD=change-me-to-another-strong-password
WORKBENCH_ADMIN_NAME=灵枢管理员

# Server port inside the app container.
PORT=8788
PB_REQUEST_TIMEOUT_MS=5000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=20000
TRUST_PROXY_HOPS=1
# Startup/readiness performs an O_EXCL write+fsync+rename canary and requires
# this much free space on the external application data volume.
APP_DATA_ROOT=/app/data
APP_DATA_MIN_FREE_BYTES=536870912

# Security.
RENDER_TOKEN_SECRET=change-me-to-a-long-random-secret
TENANT_PLATFORM_APP_KEY=generate-with-openssl-rand-base64-32
CREDENTIAL_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
REGISTRATION_CREDENTIAL_KEY=generate-with-openssl-rand-base64-32
SUPPORT_ACCESS_SECRET=generate-with-openssl-rand-base64-32
ASSET_ACCESS_SECRET=generate-with-openssl-rand-base64-32
SUBSCRIPTION_ENFORCED=true
DISABLE_LOCAL_AUTH_FALLBACK=true
ENABLE_LOCAL_STORE_FALLBACK=false
METRICS_TOKEN=generate-with-openssl-rand-base64-32
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
JSON_BODY_LIMIT=2mb
WEBHOOK_JSON_BODY_LIMIT=1mb
ENTERPRISE_JSON_BODY_LIMIT=20mb
MEDIA_JSON_BODY_LIMIT=120mb
# Optional additional administrator emails, separated by commas.
ADMIN_DASHBOARD_EMAILS=

# LLM backend. Configure at least one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Or use Qwen / DashScope.
# OVERSEAS_LLM_BACKEND=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Digital employee voiceover. Keep `required` for production: a configured
# provider failure stops the render, and no-credential runs produce no
# publishable artifact instead of a silently muted video.
DIGITAL_EMPLOYEE_VOICEOVER_MODE=required
# auto tries DashScope/Qwen first, then MiniMax. qwen/minimax pins one provider.
DIGITAL_EMPLOYEE_TTS_PROVIDER=auto
DIGITAL_EMPLOYEE_TTS_VOICE=v1
DIGITAL_EMPLOYEE_TTS_TIMEOUT_MS=90000
DIGITAL_EMPLOYEE_TTS_MAX_AUDIO_BYTES=15728640
DIGITAL_EMPLOYEE_TTS_MAX_DURATION_SECONDS=60
DIGITAL_EMPLOYEE_TTS_MAX_TEXT_CHARS=5000
# Studio provider downloads use the same fail-closed policy: HTTPS, public DNS,
# vendor-host allowlists, no redirects, and streamed byte limits.
STUDIO_TTS_MAX_AUDIO_BYTES=15728640
STUDIO_TTS_MAX_SUBTITLE_BYTES=1048576
STUDIO_TTS_ALLOW_LOCAL_FALLBACK=false
# Increment only when intentionally invalidating immutable synthesized-audio cache entries.
DIGITAL_EMPLOYEE_TTS_CACHE_VERSION=1
# Qwen TTS reuses DASHSCOPE_API_KEY above. Generated audio downloads are
# restricted to these public DNS suffixes and redirects/private IPs are denied.
# DASHSCOPE_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_TTS_AUDIO_HOST_SUFFIXES=aliyuncs.com
# Configure at least DASHSCOPE_API_KEY or MINIMAX_API_KEY before enabling real publish.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_FORMAT=mp3
MINIMAX_TTS_ASSET_HOST_SUFFIXES=minimax.io,minimaxi.com,aliyuncs.com
MINIMAX_TTS_SPEED=1
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=0
MINIMAX_TTS_SAMPLE_RATE=32000
MINIMAX_TTS_BITRATE=128000

# Optional video generation.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=false
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# 正式 customer 租户每月最多预占 200 元 Seedance 成本。
SEEDANCE_TENANT_MONTHLY_BUDGET_CNY=200
# 保守估算价可按方舟实际账单调整；调低前应保留足够安全余量。
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_480P=0.9
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_720P=1.5
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_1080P=3

# Optional crawler / social publishing keys.
YOUTUBE_API_KEY=
APIFY_TOKEN=
# 本地 TikTok 采集优先；失败后使用 Apify 兜底。设为 0 可关闭对应兜底。
APIFY_TIKTOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIKTOK_VIDEO_FALLBACK_ENABLED=1
# 视频下载兜底额度：单账号每天最多 3 条，全服务器每天最多 25 条。
APIFY_TIKTOK_VIDEO_TENANT_DAILY_LIMIT=3
APIFY_TIKTOK_VIDEO_DAILY_LIMIT=25
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_INSTAGRAM_CRAWL_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_VIDEO_FALLBACK_ENABLED=1
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_FACEBOOK_CRAWL_FALLBACK_ENABLED=1
# Shared secret used by the optional Mac crawl worker.
CRAWL_WORKER_TOKEN=generate-with-openssl-rand-base64-32
# Optional, temporary overlap during a worker-token rotation. Remove it after all workers update.
CRAWL_WORKER_TOKEN_PREVIOUS=
R2_PUBLIC_URL=
# Disaster recovery uses encrypted, consistent volume snapshots. Never upload
# plaintext customer or message exports to object storage.

# S3-compatible object storage (for example Tencent Cloud COS). When set,
# these values take precedence over the legacy R2 endpoint and credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=
# Private material links expire after 15 minutes by default (60-3600 seconds).
MATERIAL_SIGNED_URL_TTL_SECONDS=900

# Social account OAuth. Configure these once as the platform admin.
# Register these callback URLs in the corresponding developer consoles:
# https://lingshu.site/api/overseas/youtube/oauth/callback
# https://lingshu.site/api/overseas/social/oauth/instagram/callback
# https://lingshu.site/api/overseas/social/oauth/facebook/callback
# https://lingshu.site/api/overseas/social/oauth/tiktok/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
# Pin a reviewed Graph API version; all Meta/WhatsApp calls use this value.
META_GRAPH_VERSION=v25.0
# Provider deadlines do not imply a failed delivery: timeout/5xx outcomes are
# fenced for reconciliation and must not be blindly retried.
WHATSAPP_PROVIDER_TIMEOUT_MS=30000
PROVIDER_HTTP_TIMEOUT_MS=30000
WHATSAPP_INBOUND_RECEIPT_LEASE_MS=1800000
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Change to true only after TikTok approves this exact Direct Post API client.
TIKTOK_DIRECT_POST_AUDITED=false

# Keep manual token entry hidden from customers unless implementation staff need it.
ADVANCED_MANUAL_CONNECT_ENABLED=false

# Digital employee durable outbox. Leave the URL empty to use the internal
# run_events + cursor/SSE delivery path; events are still durably marked sent.
DIGITAL_EMPLOYEE_EVENT_WEBHOOK_URL=
# Required when WEBHOOK_URL is set in production. Comma-separated exact HTTPS
# origins only (no wildcard or path), for example https://events.example.com.
DIGITAL_EMPLOYEE_EVENT_WEBHOOK_ALLOWED_ORIGINS=
DIGITAL_EMPLOYEE_EVENT_WEBHOOK_SECRET=
DIGITAL_EMPLOYEE_EVENT_WEBHOOK_TIMEOUT_MS=5000
DIGITAL_EMPLOYEE_OUTBOX_MAX_ATTEMPTS=8
DIGITAL_EMPLOYEE_OUTBOX_POLL_MS=2000
DIGITAL_EMPLOYEE_OUTBOX_RECONCILE_MS=300000
DIGITAL_EMPLOYEE_OUTBOX_RECONCILE_MAX_RECORDS=250000
DIGITAL_EMPLOYEE_OUTBOX_MAX_BACKLOG=1000
DIGITAL_EMPLOYEE_OUTBOX_MAX_AGE_SECONDS=300

# Cross-instance workers. Production must not disable the digital employee
# runner. Lease durations should exceed normal datastore latency but remain
# below the relevant task timeout.
DISABLE_DIGITAL_EMPLOYEE_WORKER=false
DIGITAL_EMPLOYEE_RUN_LEASE_MS=45000
DIGITAL_EMPLOYEE_TASK_LEASE_MS=30000
DIGITAL_EMPLOYEE_TASK_TIMEOUT_MS=120000
DIGITAL_EMPLOYEE_HANDOFF_SAGA_STALE_MS=15000
DIGITAL_EMPLOYEE_RENDER_TASK_TIMEOUT_MS=600000
# Renderer inline inputs are capped independently from the HTTP body limit.
# Keep these byte limits at or below 25 MiB per asset and 75 MiB total.
RENDER_INLINE_ASSET_MAX_BYTES=26214400
RENDER_INLINE_TOTAL_MAX_BYTES=78643200
DIGITAL_EMPLOYEE_RENDER_MAX_ASSET_BYTES=26214400
DIGITAL_EMPLOYEE_RENDER_MAX_TOTAL_BYTES=78643200
DIGITAL_EMPLOYEE_RENDER_MAX_OUTPUT_BYTES=536870912
# Server containers must never try to open Finder/Desktop applications.
DISABLE_DESKTOP_OPEN_OUTPUT=true
PUBLISH_SCHEDULER_ENABLED=true
PUBLISH_SCHEDULER_LEASE_MS=900000
# Must be shorter than the effective publish lease. Timeout means the remote
# outcome is unknown and requires account-by-account reconciliation.
PUBLISH_ACCOUNT_TIMEOUT_MS=600000
# Keep dry-run until all target account credentials, approval payload hashes,
# idempotency, and platform acceptance checks have passed in a change window.
DIGITAL_EMPLOYEE_REAL_PUBLISH_ENABLED=false
