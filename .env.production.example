# Copy this file to .env.production on the server and fill real values.

# Public application domain. Point its DNS A record to your server IPv4.
APP_DOMAIN=lingshu.site
PUBLIC_BASE_URL=https://lingshu.site

# PocketBase version used by Dockerfile.pocketbase.
PB_VERSION=0.39.5

# PocketBase stays on the private Docker network. The container creates or
# updates this superuser during startup; never expose port 8090 publicly.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-strong-password

# Workbench administrator. This is a normal application login account and is
# intentionally separate from the PocketBase superuser above.
WORKBENCH_ADMIN_EMAIL=ops@example.com
WORKBENCH_ADMIN_PASSWORD=change-me-to-another-strong-password
WORKBENCH_ADMIN_NAME=灵枢管理员

# Server port inside the app container.
PORT=8788
# Keep `all` for the current topology. `web`/`worker` are intentionally guarded
# until durable queueing and scheduler registration have been migrated.
PROCESS_ROLE=all

# Security.
RENDER_TOKEN_SECRET=change-me-to-a-long-random-secret
TENANT_PLATFORM_APP_KEY=generate-with-openssl-rand-base64-32
SUPPORT_ACCESS_SECRET=generate-with-openssl-rand-base64-32
SUPPORT_ACCESS_TTL_MINUTES=30
ASSET_ACCESS_SECRET=generate-with-openssl-rand-base64-32
# Dedicated server-side HMAC pepper. Generate independently with
# `openssl rand -base64 48`; changing it invalidates all issued Product API keys.
PRODUCT_API_KEY_PEPPER=generate-independently-with-openssl-rand-base64-48
# Keep false until a production purchase flow can issue entitlements.
SUBSCRIPTION_ENFORCED=false
DISABLE_LOCAL_AUTH_FALLBACK=true
# Optional additional administrator emails, separated by commas.
ADMIN_DASHBOARD_EMAILS=

# LLM backend. Configure at least one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Or use Qwen / DashScope.
# OVERSEAS_LLM_BACKEND=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional video generation.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=false
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# 正式 customer 租户每月最多预占 200 元 Seedance 成本。
SEEDANCE_TENANT_MONTHLY_BUDGET_CNY=200
# 保守估算价可按方舟实际账单调整；调低前应保留足够安全余量。
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_480P=0.9
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_720P=1.5
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_1080P=3

# Optional crawler / social publishing keys.
YOUTUBE_API_KEY=
APIFY_TOKEN=
# 本地 TikTok 采集优先；失败后使用 Apify 兜底。设为 0 可关闭对应兜底。
APIFY_TIKTOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIKTOK_VIDEO_FALLBACK_ENABLED=1
# 视频下载兜底额度：单账号每天最多 3 条，全服务器每天最多 25 条。
APIFY_TIKTOK_VIDEO_TENANT_DAILY_LIMIT=3
APIFY_TIKTOK_VIDEO_DAILY_LIMIT=25
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_INSTAGRAM_CRAWL_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_VIDEO_FALLBACK_ENABLED=1
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_FACEBOOK_CRAWL_FALLBACK_ENABLED=1
# Shared secret used by the optional Mac crawl worker.
CRAWL_WORKER_TOKEN=generate-with-openssl-rand-base64-32
R2_PUBLIC_URL=
R2_BACKUP_PREFIX=lingshu-backups
R2_BACKUP_LOCAL_RETENTION_DAYS=7

# S3-compatible object storage (for example Tencent Cloud COS). When set,
# these values take precedence over the legacy R2 endpoint and credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=
# Private material links expire after 15 minutes by default (60-3600 seconds).
MATERIAL_SIGNED_URL_TTL_SECONDS=900

# Social account OAuth. Configure these once as the platform admin.
# Register these callback URLs in the corresponding developer consoles:
# https://lingshu.site/api/overseas/youtube/oauth/callback
# https://lingshu.site/api/overseas/social/oauth/instagram/callback
# https://lingshu.site/api/overseas/social/oauth/facebook/callback
# https://lingshu.site/api/overseas/social/oauth/tiktok/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Keep manual token entry hidden from customers unless implementation staff need it.
ADVANCED_MANUAL_CONNECT_ENABLED=false
# Legacy official-account publishing is an advanced/internal capability. Keep
# it off until durable_operation_leases is deployed and provider recovery has
# been rehearsed. Only the exact value true enables it.
PUBLISH_SCHEDULER_ENABLED=false
PUBLISH_SCHEDULER_LEASE_MS=1800000
LEGACY_EXTERNAL_EFFECT_LEASE_MS=1800000
STARTER_RUN_MUTATION_LEASE_MS=300000
# 数字员工逐客跟进 Worker。显式启用后仅处理租户已授权、批次已批准、Meta 凭据有效且到期的逐客任务。
# 当前采用单活 Worker；不要在多个服务副本同时启用。
FOLLOWUP_WORKER_ENABLED=false
FOLLOWUP_WORKER_INTERVAL_MS=15000
FOLLOWUP_WORKER_MAX_ATTEMPTS=3
FOLLOWUP_WORKER_RECIPIENT_DELAY_MS=1000
DIGITAL_EMPLOYEE_RUNTIME_ENABLED=true
DIGITAL_EMPLOYEE_RUNTIME_INTERVAL_MS=60000
DIGITAL_EMPLOYEE_RUNTIME_MAX_RUNS=200
# 198 标准版专用执行器。完成 starter migrations、PB 依赖检查后，
# 在一个指定消费实例显式改为 true；完成数据库级 fencing 前不得多实例启用。
STARTER_198_ORCHESTRATOR_WORKER_ENABLED=false
STARTER_198_ORCHESTRATOR_WORKER_INTERVAL_MS=30000
STARTER_198_ORCHESTRATOR_WORKER_MAX_RUNS=20
# Side-effecting repair workers stay off until starter migrations, PB_URL/admin
# credentials and the persistent publishing upload volume have been verified.
# Enable each with the exact value `true` on one designated consumer instance.
STARTER_PUBLICATION_PACKAGE_WORKER_ENABLED=false
STARTER_PUBLICATION_PACKAGE_WORKER_INTERVAL_MS=15000
STARTER_PUBLICATION_PACKAGE_WORKER_LEASE_MS=1800000
STARTER_QUOTE_ARTIFACT_WORKER_ENABLED=false
STARTER_QUOTE_ARTIFACT_WORKER_INTERVAL_MS=30000
STARTER_QUOTE_ARTIFACT_WORKER_MAX_DRAFTS=100
STARTER_QUOTE_ARTIFACT_WORKER_MAX_TENANTS=100

# Conversation-embedded quote skill. Enable only after PocketBase provisioning and smoke tests.
QUOTE_SKILL_ENABLED=false
# Comma-separated tenant IDs for staged rollout; empty means all tenants.
QUOTE_SKILL_TENANT_ALLOWLIST=

# Digital production is opt-in. Keep disabled until asset QA and billing reconciliation.
HEYGEN_GENERATION_ENABLED=false
QWEN_ASR_GENERATION_ENABLED=false
# Admission budget for HeyGen + Qwen ASR only; excludes script/TTS/image calls.
# Fill all amounts explicitly after reconciling prior charges. No automatic reset/refund.
# Reservations are conservative estimates, NOT a provider-side maximum bill.
STUDIO_PAID_BUDGET_CNY=
STUDIO_PAID_OPENING_USED_CNY=
STUDIO_HEYGEN_RESERVE_CNY=
STUDIO_ASR_RESERVE_CNY=
