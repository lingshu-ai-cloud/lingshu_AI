# Copy this file to .env.production on the server and fill real values.

# Public application domain. Point its DNS A record to your server IPv4.
APP_DOMAIN=lingshu.site
PUBLIC_BASE_URL=https://lingshu.site

# PocketBase version used by Dockerfile.pocketbase.
PB_VERSION=0.39.5

# PocketBase stays on the private Docker network. The container creates or
# updates this superuser during startup; never expose port 8090 publicly.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-strong-password

# Workbench administrator. This is a normal application login account and is
# intentionally separate from the PocketBase superuser above.
WORKBENCH_ADMIN_EMAIL=ops@example.com
WORKBENCH_ADMIN_PASSWORD=change-me-to-another-strong-password
WORKBENCH_ADMIN_NAME=灵枢管理员

# Server port inside the app container.
PORT=8788

# Security.
RENDER_TOKEN_SECRET=change-me-to-a-long-random-secret
# Optional independent HMAC key for server-attested trilingual acceptance.
# Defaults to RENDER_TOKEN_SECRET when omitted.
DIGITAL_HUMAN_ACCEPTANCE_ATTESTATION_SECRET=
# Optional durable paths; defaults are data/render-authorizations.json and data/studio-render-jobs.json.
RENDER_AUTHORIZATIONS_FILE=
STUDIO_RENDER_JOBS_FILE=
STUDIO_RENDER_LEASE_MINUTES=45
STUDIO_RENDER_BATCH_TOKEN_TTL_SECONDS=3600
TENANT_PLATFORM_APP_KEY=generate-with-openssl-rand-base64-32
REGISTRATION_CREDENTIAL_KEY=generate-with-openssl-rand-base64-32
SUPPORT_ACCESS_SECRET=generate-with-openssl-rand-base64-32
ASSET_ACCESS_SECRET=generate-with-openssl-rand-base64-32
SUBSCRIPTION_ENFORCED=true
DISABLE_LOCAL_AUTH_FALLBACK=true
# Optional additional administrator emails, separated by commas.
ADMIN_DASHBOARD_EMAILS=

# LLM backend. Configure at least one.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Or use Qwen / DashScope.
# OVERSEAS_LLM_BACKEND=qwen
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional Apache-2.0 local Qwen3-TTS fallback. Enable only when the Node
# process is co-located with the GPU/WSL runtime; a remote Linux web server
# cannot address a customer's Windows GPU through these local paths.
# LOCAL_QWEN3_TTS_ENABLED=false
# LOCAL_QWEN3_TTS_PYTHON=/opt/lingshu-qwen3-tts/.venv/bin/python
# LOCAL_QWEN3_TTS_SCRIPT=/app/scripts/qwen3-tts-local.py
# LOCAL_QWEN3_TTS_MODEL_DIR=/opt/lingshu-models/Qwen3-TTS-12Hz-0.6B-CustomVoice
# LOCAL_QWEN3_TTS_SPEAKER=Ryan
# LOCAL_QWEN3_TTS_DEVICE=cuda:0
# LOCAL_QWEN3_TTS_DTYPE=bfloat16
# LOCAL_QWEN3_TTS_ATTENTION=sdpa
# LOCAL_QWEN3_TTS_FFMPEG=/usr/bin/ffmpeg
# LOCAL_QWEN3_TTS_LOUDNESS_LUFS=-18
# LOCAL_QWEN3_TTS_TRUE_PEAK_DB=-1.5
# LOCAL_QWEN3_TTS_LOUDNESS_RANGE=7
# Ryan-only pitch calibration; re-measure when changing speaker.
# LOCAL_QWEN3_TTS_PITCH_SEMITONES_ZH=0
# LOCAL_QWEN3_TTS_PITCH_SEMITONES_EN=0
# LOCAL_QWEN3_TTS_PITCH_SEMITONES_ES=-3
# LOCAL_QWEN3_TTS_TIMEOUT_MS=180000
# LOCAL_QWEN3_TTS_MIN_FREE_VRAM_MB=4300
# LOCAL_QWEN3_TTS_ALLOW_CPU_FALLBACK=false

# Optional video generation.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_ENABLED=false
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# 正式 customer 租户每月最多预占 200 元 Seedance 成本。
SEEDANCE_TENANT_MONTHLY_BUDGET_CNY=200
# 保守估算价可按方舟实际账单调整；调低前应保留足够安全余量。
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_480P=0.9
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_720P=1.5
# SEEDANCE_ESTIMATED_CNY_PER_SECOND_1080P=3

# Optional crawler / social publishing keys.
YOUTUBE_API_KEY=
APIFY_TOKEN=
# 本地 TikTok 采集优先；失败后使用 Apify 兜底。设为 0 可关闭对应兜底。
APIFY_TIKTOK_CRAWL_FALLBACK_ENABLED=1
APIFY_TIKTOK_VIDEO_FALLBACK_ENABLED=1
# 视频下载兜底额度：单账号每天最多 3 条，全服务器每天最多 25 条。
APIFY_TIKTOK_VIDEO_TENANT_DAILY_LIMIT=3
APIFY_TIKTOK_VIDEO_DAILY_LIMIT=25
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_INSTAGRAM_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_INSTAGRAM_CRAWL_FALLBACK_ENABLED=1
APIFY_INSTAGRAM_VIDEO_FALLBACK_ENABLED=1
APIFY_FACEBOOK_ACTOR=apify/facebook-posts-scraper
APIFY_FACEBOOK_CRAWL_FALLBACK_ENABLED=1
# Shared secret used by the optional Mac crawl worker.
CRAWL_WORKER_TOKEN=generate-with-openssl-rand-base64-32
R2_PUBLIC_URL=
R2_BACKUP_PREFIX=lingshu-backups
R2_BACKUP_LOCAL_RETENTION_DAYS=7

# S3-compatible object storage (for example Tencent Cloud COS). When set,
# these values take precedence over the legacy R2 endpoint and credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=
# Private material links expire after 15 minutes by default (60-3600 seconds).
MATERIAL_SIGNED_URL_TTL_SECONDS=900

# Digital-human jobs stay on the web server while a Windows GPU worker pulls
# them over HTTPS. Never expose the worker's local HTTP port to the Internet.
DIGITAL_HUMAN_PULL_WORKER_ENABLED=true
DIGITAL_HUMAN_PROVIDER=musetalk-v1.5-local
DIGITAL_HUMAN_PUBLIC_BASE_URL=https://lingshu.site
# Production requires one revocable, worker-bound and tenant-scoped credential.
# Keep this JSON on one line. The worker uses the matching entry's `key`.
DIGITAL_HUMAN_WORKER_CREDENTIALS_JSON=[{"id":"gpu-office-01-v1","workerId":"gpu-office-01","key":"generate-with-openssl-rand-base64-48","tenantScopes":["replace-with-tenant-id"]}]
# Legacy shared keys are rejected in production. This is emergency-only,
# temporary, and must be removed immediately after credential recovery.
# DIGITAL_HUMAN_ALLOW_LEGACY_WORKER_KEY_BREAK_GLASS=false
DIGITAL_HUMAN_WORKER_LEASE_MS=120000
DIGITAL_HUMAN_WORKER_MAX_ATTEMPTS=3
# Must be longer than the worker heartbeat interval. An expired worker is not
# advertised as available and new customer jobs fail closed with HTTP 503.
DIGITAL_HUMAN_WORKER_ONLINE_TTL_MS=90000
DIGITAL_HUMAN_WORKER_MIN_TOTAL_VRAM_MB=7000
DIGITAL_HUMAN_WORKER_MIN_FREE_VRAM_MB=3500
DIGITAL_HUMAN_WORKER_MIN_DISK_FREE_BYTES=5368709120
# Install ffprobe on the web server or provide its absolute path. ffmpeg-static
# remains the decode fallback; every uploaded result is decoded independently.
DIGITAL_HUMAN_FFPROBE_PATH=/usr/bin/ffprobe
DIGITAL_HUMAN_SERVER_PROBE_TIMEOUT_MS=180000
# 本地 GPU Worker 必须使用最终成片 fail-closed 门禁。
DIGITAL_HUMAN_WORKER_FINAL_VALIDATION_MODE=strict
# GPU Worker environment: remote input is HTTPS/443 only; delivery is durable
# and acknowledged artifacts are retained for 24 hours before cleanup.
DIGITAL_HUMAN_WORKER_INPUT_PORTS=443
DIGITAL_HUMAN_WORKER_RESULT_MAX_ATTEMPTS=8
DIGITAL_HUMAN_WORKER_DEAD_LETTER_MAX_RECOVERIES=2
DIGITAL_HUMAN_WORKER_JOB_RETENTION_MS=86400000
DIGITAL_HUMAN_WORKER_CLEANUP_INTERVAL_MS=900000

# Social account OAuth. Configure these once as the platform admin.
# Register these callback URLs in the corresponding developer consoles:
# https://lingshu.site/api/overseas/youtube/oauth/callback
# https://lingshu.site/api/overseas/social/oauth/instagram/callback
# https://lingshu.site/api/overseas/social/oauth/facebook/callback
# https://lingshu.site/api/overseas/social/oauth/tiktok/callback
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
META_SOCIAL_APP_ID=
META_SOCIAL_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Keep manual token entry hidden from customers unless implementation staff need it.
ADVANCED_MANUAL_CONNECT_ENABLED=false
# 数字员工逐客跟进 Worker。显式启用后仅处理租户已授权、批次已批准、Meta 凭据有效且到期的逐客任务。
# 当前采用单活 Worker；不要在多个服务副本同时启用。
FOLLOWUP_WORKER_ENABLED=false
FOLLOWUP_WORKER_INTERVAL_MS=15000
FOLLOWUP_WORKER_MAX_ATTEMPTS=3
FOLLOWUP_WORKER_RECIPIENT_DELAY_MS=1000
DIGITAL_EMPLOYEE_RUNTIME_ENABLED=true
DIGITAL_EMPLOYEE_RUNTIME_INTERVAL_MS=60000
DIGITAL_EMPLOYEE_RUNTIME_MAX_RUNS=200
