<view class="operator-nav safe-bottom">
  <view wx:for="{{items}}" wx:key="key" class="nav-item {{active === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="select" aria-role="button" aria-label="{{item.label}}">
    <view class="nav-icon {{item.key}}"></view>
    <text wx:if="{{item.key === 'customers' && (todayBadge || storedTodayBadge)}}" class="nav-badge">{{(todayBadge || storedTodayBadge) > 99 ? '99+' : (todayBadge || storedTodayBadge)}}</text>
    <text class="nav-label">{{item.label}}</text>
  </view>
</view>
