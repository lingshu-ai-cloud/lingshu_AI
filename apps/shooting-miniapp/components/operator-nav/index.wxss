.operator-nav{position:fixed;z-index:40;left:0;right:0;bottom:0;min-height:104rpx;padding:8rpx 12rpx calc(8rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-start;background:#fff;border-top:1rpx solid var(--ls-border-secondary);box-sizing:content-box}.nav-item{position:relative;flex:1;min-height:88rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;font-weight:500}.nav-item:active{background:var(--ls-selected);border-radius:var(--ls-radius-control)}.nav-icon{position:relative;width:34rpx;height:34rpx;box-sizing:border-box;color:currentColor}.nav-icon.work{border:3rpx solid currentColor;border-radius:4rpx}.nav-icon.work::before,.nav-icon.work::after{content:'';position:absolute;background:currentColor}.nav-icon.work::before{left:14rpx;top:0;bottom:0;width:3rpx}.nav-icon.work::after{left:0;right:0;top:14rpx;height:3rpx}.nav-icon.review{border:3rpx solid currentColor;border-radius:50%}.nav-icon.review::after{content:'';position:absolute;left:8rpx;top:8rpx;width:13rpx;height:7rpx;border-left:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:rotate(-45deg)}.nav-icon.assistant{height:30rpx;margin-top:1rpx;border:3rpx solid currentColor;border-radius:8rpx}.nav-icon.assistant::after{content:'';position:absolute;left:5rpx;bottom:-7rpx;width:8rpx;height:8rpx;border-left:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:skewY(-35deg);background:#fff}.nav-label{line-height:32rpx}.nav-item.active{color:var(--ls-text);font-weight:600}.nav-item.active::before{content:'';position:absolute;top:-9rpx;left:50%;width:48rpx;height:4rpx;border-radius:2rpx;background:var(--ls-action-gradient);transform:translateX(-50%)}
