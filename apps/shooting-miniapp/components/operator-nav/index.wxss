.operator-nav{position:fixed;z-index:40;left:0;right:0;bottom:0;height:calc(112rpx + env(safe-area-inset-bottom));padding:22rpx 20rpx env(safe-area-inset-bottom);display:grid;grid-template-columns:repeat(3,1fr);align-items:stretch;box-sizing:border-box;border-top:1rpx solid rgba(210,218,232,.86);background:rgba(255,255,255,.98);box-shadow:0 -8rpx 26rpx rgba(23,35,61,.07)}
.nav-item{position:relative;min-height:72rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;color:var(--ls-text-tertiary);font-size:20rpx;font-weight:500}.nav-item:active{opacity:.62}.nav-icon{position:relative;width:27rpx;height:27rpx;box-sizing:border-box;color:currentColor}.nav-icon.today{border:3rpx solid currentColor;border-radius:5rpx}.nav-icon.today::before,.nav-icon.today::after{content:'';position:absolute;background:currentColor}.nav-icon.today::before{left:5rpx;right:5rpx;top:6rpx;height:3rpx;box-shadow:0 7rpx 0 currentColor}.nav-icon.today::after{left:7rpx;top:-6rpx;width:3rpx;height:7rpx;box-shadow:8rpx 0 0 currentColor}.nav-icon.materials{border:3rpx solid currentColor;border-radius:5rpx}.nav-icon.materials::before{content:'';position:absolute;left:4rpx;right:4rpx;bottom:4rpx;height:8rpx;border-left:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:skewY(-28deg)}.nav-icon.materials::after{content:'';position:absolute;top:5rpx;right:5rpx;width:5rpx;height:5rpx;border-radius:50%;background:currentColor}.nav-icon.shooting{border:3rpx solid currentColor;border-radius:50%}.nav-icon.shooting::before{content:'';position:absolute;inset:6rpx;border:3rpx solid currentColor;border-radius:50%}.nav-icon.shooting::after{content:'';position:absolute;top:-7rpx;left:8rpx;width:8rpx;height:5rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:3rpx 3rpx 0 0}.nav-label{line-height:28rpx;white-space:nowrap}.nav-item.active{color:var(--ls-primary);font-weight:650}.nav-item.active::after{content:'';position:absolute;bottom:-2rpx;left:50%;width:50rpx;height:4rpx;border-radius:4rpx;background:var(--ls-primary);transform:translateX(-50%)}
.nav-badge{position:absolute;top:0;left:calc(50% + 11rpx);min-width:26rpx;height:26rpx;padding:0 7rpx;border:3rpx solid #fff;border-radius:999rpx;background:var(--ls-error);color:#fff;font-size:17rpx;line-height:26rpx;text-align:center;box-sizing:content-box}
.nav-icon.assistant::before{content:"✦";position:absolute;inset:-6rpx;font-size:40rpx;line-height:40rpx;text-align:center}.nav-item.active .nav-icon.assistant{color:var(--ls-violet)}

.nav-icon.customers{border:3rpx solid currentColor;border-radius:50%;width:18rpx;height:18rpx;margin-bottom:9rpx}.nav-icon.customers::after{content:"";position:absolute;left:-8rpx;top:17rpx;width:28rpx;height:14rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:18rpx 18rpx 0 0}
