.operator-nav{position:fixed;z-index:40;left:0;right:0;bottom:0;height:calc(92rpx + env(safe-area-inset-bottom));padding:0 44rpx env(safe-area-inset-bottom);display:grid;grid-template-columns:1fr 1fr;column-gap:20rpx;align-items:stretch;box-sizing:border-box;border-top:1rpx solid rgba(210,218,232,.86);background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(246,248,252,.96));box-shadow:0 -8rpx 26rpx rgba(23,35,61,.07)}.nav-item{position:relative;min-height:72rpx;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:10rpx;color:var(--ls-text-tertiary);font-size:22rpx;font-weight:500;transition:color .2s ease,opacity .2s ease}.nav-item+.nav-item{border-left:1rpx solid rgba(210,218,232,.58)}.nav-item:active{opacity:.62}.nav-icon{position:relative;width:28rpx;height:28rpx;box-sizing:border-box;color:currentColor;transition:transform .2s ease}.nav-icon.work{border:3rpx solid currentColor;border-radius:4rpx}.nav-icon.work::before,.nav-icon.work::after{content:'';position:absolute;background:currentColor}.nav-icon.work::before{left:11rpx;top:0;bottom:0;width:3rpx}.nav-icon.work::after{left:0;right:0;top:11rpx;height:3rpx}.nav-icon.assistant{height:25rpx;border:3rpx solid currentColor;border-radius:7rpx}.nav-icon.assistant::after{content:'';position:absolute;left:5rpx;bottom:-6rpx;width:7rpx;height:7rpx;border-left:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:skewY(-35deg);background:transparent}.nav-label{line-height:30rpx;white-space:nowrap}.nav-item.active{color:var(--ls-primary);font-weight:650}.nav-item.active::before{content:'';position:absolute;bottom:0;left:50%;width:58rpx;height:5rpx;border-radius:5rpx 5rpx 0 0;background:var(--ls-primary);box-shadow:0 -3rpx 10rpx rgba(37,99,235,.28);transform:translateX(-50%)}.nav-item.active .nav-icon{transform:translateY(-2rpx)}
