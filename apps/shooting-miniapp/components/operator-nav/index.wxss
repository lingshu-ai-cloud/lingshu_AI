.operator-nav{position:fixed;z-index:40;left:0;right:0;bottom:0;height:104rpx;padding:10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));display:flex;align-items:flex-start;background:rgba(255,255,255,.98);border-top:1rpx solid var(--ls-border-secondary);box-sizing:content-box}.nav-item{flex:1;min-height:88rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;font-weight:500}.nav-mark{height:28rpx;display:flex;align-items:center}.nav-dot{width:12rpx;height:12rpx;border:3rpx solid currentColor;border-radius:50%}.nav-item.active{color:var(--ls-primary);font-weight:600}.nav-item.active .nav-mark{width:56rpx;border-radius:20rpx;background:var(--ls-info-bg);justify-content:center}.nav-item.active .nav-dot{background:currentColor}
