:host { position: absolute; z-index: 4; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; }
.safe-layer { position: absolute; top: 0; right: 0; bottom: 0; left: 0; color: rgba(255,255,255,.86); }
.safe-outline { position: absolute; top: 12%; right: 8%; bottom: 22%; left: 8%; border: 1rpx solid rgba(255,255,255,.42); border-radius: 8rpx; }
.safe-label { position: absolute; top: 10rpx; left: 12rpx; padding: 4rpx 9rpx; border-radius: 7rpx; background: rgba(8,12,22,.22); color: rgba(255,255,255,.62); font-size: 16rpx; letter-spacing: 1rpx; }
.risk-band { position: absolute; background: rgba(255, 177, 77, .055); border-color: rgba(255, 205, 120, .26); }
.risk-top { display: none; top: 0; left: 0; right: 0; height: 12%; border-bottom-width: 1rpx; border-bottom-style: dashed; }
.risk-right { right: 0; border-left-width: 1rpx; border-left-style: dashed; }
.risk-bottom { left: 0; right: 0; bottom: 0; border-top-width: 1rpx; border-top-style: dashed; }
.safe-layer-tiktok .risk-right { top: 8%; bottom: 22%; width: 16%; }
.safe-layer-tiktok .risk-bottom { height: 22%; }
.safe-layer-facebook .risk-top { display: block; }
.safe-layer-facebook .risk-right { top: 12%; bottom: 22%; width: 12%; }
.safe-layer-facebook .risk-bottom { height: 22%; }
.risk-label { position: absolute; color: rgba(255,255,255,.72); font-size: 15rpx; white-space: nowrap; }
.risk-label-top { right: 18rpx; bottom: 9rpx; }
.risk-label-right { top: 50%; right: 8rpx; transform: rotate(90deg) translateX(50%); transform-origin: right center; }
.risk-label-bottom { top: 10rpx; right: 18rpx; }
.safe-layer-recording .risk-band { background: rgba(255, 177, 77, .055); border-color: rgba(255, 205, 120, .24); }
.safe-layer-recording .risk-label, .safe-layer-recording .safe-label { opacity: .58; }
.publish-preview { position: absolute; z-index: 3; top: 0; right: 0; bottom: 0; left: 0; color: rgba(255,255,255,.54); font-size: 17rpx; }
.preview-top { position: absolute; top: 5.5%; left: 50%; transform: translateX(-50%); padding: 6rpx 13rpx; border-radius: 14rpx; background: rgba(8,12,22,.16); white-space: nowrap; }
.preview-actions { position: absolute; z-index: 2; right: 2.6%; bottom: 27%; display: flex; flex-direction: column; align-items: center; gap: 15rpx; }
.preview-action { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 54rpx; }
.preview-avatar, .preview-dot { width: 34rpx; height: 34rpx; border: 2rpx solid rgba(255,255,255,.48); border-radius: 50%; background: rgba(8,12,22,.12); box-sizing: border-box; }
.preview-dot { width: 28rpx; height: 28rpx; }
.preview-action-label { margin-top: 3rpx; color: rgba(255,255,255,.52); font-size: 15rpx; }
.preview-copy { position: absolute; z-index: 2; left: 4%; right: 20%; bottom: 12.5%; padding: 10rpx 12rpx; border-radius: 10rpx; background: rgba(8,12,22,.13); }
.preview-account { display: flex; align-items: center; height: 30rpx; font-size: 18rpx; font-weight: 600; }
.preview-line { margin-top: 7rpx; color: rgba(255,255,255,.48); font-size: 16rpx; }
.preview-line-wide { width: 82%; padding-bottom: 5rpx; border-bottom: 1rpx solid rgba(255,255,255,.28); }
.preview-bottom { position: absolute; left: 0; right: 0; bottom: 2.5%; padding: 12rpx 18rpx; border-top: 1rpx solid rgba(255,255,255,.22); background: rgba(8,12,22,.14); text-align: center; white-space: nowrap; }
.preview-top-facebook { left: 5%; right: 5%; transform: none; text-align: left; }
.preview-actions-facebook { right: 2.8%; bottom: 29%; gap: 18rpx; }
.preview-copy-facebook { right: 15%; bottom: 12%; }
.preview-avatar-inline { display: inline-block; width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.preview-bottom-facebook { bottom: 2.5%; }
.safe-layer-recording .publish-preview { opacity: .46; }
.safe-layer-recording .safe-outline { border-color: rgba(255,255,255,.26); }
