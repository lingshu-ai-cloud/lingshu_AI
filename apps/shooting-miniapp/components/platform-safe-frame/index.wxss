:host { position: absolute; inset: 0; pointer-events: none; }
.safe-layer { position: absolute; inset: 0; color: rgba(255,255,255,.86); }
.safe-edge { position: absolute; background: rgba(5, 9, 18, .08); }
.safe-edge-top { top: 0; left: 0; right: 0; height: 14%; }
.safe-edge-right { top: 14%; right: 0; bottom: 18%; width: 12%; }
.safe-edge-bottom { left: 0; right: 0; bottom: 0; height: 18%; }
.safe-edge-left { top: 14%; left: 0; bottom: 18%; width: 6%; }
.safe-outline { position: absolute; top: 14%; right: 12%; bottom: 18%; left: 6%; border: 1rpx solid rgba(255,255,255,.58); border-radius: 10rpx; box-shadow: inset 0 0 0 1rpx rgba(0,0,0,.10); }
.safe-label { position: absolute; top: 12rpx; right: 12rpx; padding: 5rpx 10rpx; border-radius: 8rpx; background: rgba(8,12,22,.30); color: rgba(255,255,255,.82); font-size: 17rpx; letter-spacing: 1rpx; }
.safe-layer-tiktok .safe-edge-top { height: 16%; }
.safe-layer-tiktok .safe-edge-right { top: 16%; bottom: 20%; width: 18%; }
.safe-layer-tiktok .safe-edge-bottom { height: 20%; }
.safe-layer-tiktok .safe-edge-left { top: 16%; bottom: 20%; }
.safe-layer-tiktok .safe-outline { top: 16%; right: 18%; bottom: 20%; }
