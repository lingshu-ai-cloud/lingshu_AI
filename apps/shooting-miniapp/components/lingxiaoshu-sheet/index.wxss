@import "../../styles/message-action-menu.wxss";
.assistant-overlay{position:fixed;z-index:120;inset:0;background:var(--ls-mask);animation:fade-in var(--ls-motion-enter) var(--ls-ease-enter)}
.assistant-sheet{position:absolute;left:0;right:0;bottom:0;height:74vh;max-height:calc(100vh - env(safe-area-inset-top) - 88rpx);overflow:hidden;border-radius:32rpx 32rpx 0 0;background:#fff;box-shadow:0 -22rpx 64rpx rgba(23,35,61,.18);animation:sheet-in var(--ls-motion-enter) var(--ls-ease-enter)}
.assistant-head{height:104rpx;padding:0 28rpx;display:grid;grid-template-columns:88rpx 1fr 88rpx;align-items:center;border-bottom:1rpx solid var(--ls-border-secondary);box-sizing:border-box}
.head-button{width:88rpx;height:88rpx;min-height:88rpx;margin:0;padding:0;border:0;background:transparent;color:var(--ls-text);line-height:88rpx}
.close-button{font-size:48rpx;font-weight:300;text-align:left}.head-end{width:88rpx;height:88rpx}
.assistant-identity{display:flex;align-items:center;justify-content:center;gap:14rpx;min-width:0}.assistant-mark{width:54rpx;height:54rpx;border-radius:15rpx;display:flex;align-items:center;justify-content:center;background:var(--ls-action-gradient);color:#fff;font-size:30rpx}.assistant-title,.assistant-online{display:block}.assistant-title{font-size:30rpx;line-height:40rpx;font-weight:650}.assistant-online{color:var(--ls-text-tertiary);font-size:18rpx;line-height:26rpx}
.assistant-body{height:calc(74vh - 104rpx);padding:28rpx 28rpx 0;box-sizing:border-box;background:#fff}
.assistant-empty{min-height:calc(74vh - 330rpx);padding:54rpx 8rpx 28rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;box-sizing:border-box}.empty-mark{width:62rpx;height:62rpx;border-radius:17rpx;display:flex;align-items:center;justify-content:center;background:var(--ls-action-gradient);color:#fff;font-size:32rpx}.empty-title{margin-top:22rpx;color:var(--ls-text);font-size:36rpx;line-height:50rpx;font-weight:650}.empty-note{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:34rpx}.quick-prompts{max-width:600rpx;margin-top:30rpx;display:flex;flex-wrap:wrap;justify-content:center;gap:12rpx}.quick-prompt{min-height:72rpx;padding:0 20rpx;display:flex;align-items:center;gap:10rpx;border:1rpx solid var(--ls-border);border-radius:36rpx;background:#fff;color:var(--ls-text-secondary);font-size:23rpx;box-sizing:border-box}.quick-prompt:active{background:var(--ls-selected);border-color:var(--ls-primary)}.quick-icon{width:32rpx;height:32rpx;display:flex;align-items:center;justify-content:center;color:var(--ls-primary);font-size:22rpx;font-weight:650}.quick-icon.capability-icon-content{color:var(--ls-violet)}.quick-icon.capability-icon-customers{color:#0784b8}.quick-icon.capability-icon-shooting{color:var(--ls-warning)}.assistant-daily-line{width:100%;margin-top:28rpx;padding-top:20rpx;border-top:1rpx solid var(--ls-border-secondary);display:flex;align-items:center;justify-content:center;gap:12rpx;color:var(--ls-text-tertiary);font-size:20rpx;line-height:30rpx}.daily-label{color:var(--ls-primary);font-weight:650}
.assistant-message{max-width:86%;margin-bottom:18rpx;padding:20rpx 22rpx;border-radius:20rpx;background:var(--ls-fill);box-sizing:border-box}.assistant-message.user{margin-left:auto;background:var(--ls-action-gradient);color:#fff}.message-speaker{display:block;margin-bottom:4rpx;font-size:19rpx;opacity:.68}.message-copy{font-size:26rpx;line-height:40rpx;white-space:pre-wrap}
.capability-dismiss{position:absolute;z-index:2;top:104rpx;right:0;bottom:0;left:0;background:transparent}.assistant-sheet .message-action-menu{bottom:calc(128rpx + env(safe-area-inset-bottom))}.message-action-icon.capability-icon-content{background:linear-gradient(145deg,#a366f4,#7047dc);color:#fff}.message-action-icon.capability-icon-customers{background:linear-gradient(145deg,#55b9e9,#1685bd);color:#fff}.message-action-icon.capability-icon-shooting{background:linear-gradient(145deg,#ffc44c,#e98a00);color:#fff}
.thinking{padding:16rpx 4rpx;color:var(--ls-text-tertiary);font-size:22rpx}.assistant-action{min-height:88rpx;margin-top:12rpx;padding:18rpx 20rpx;display:flex;align-items:center;justify-content:space-between;border:1rpx solid var(--ls-border-secondary);border-radius:16rpx;background:#fff;color:var(--ls-primary);font-size:23rpx;box-sizing:border-box}.preview-card{margin-top:16rpx;padding:22rpx;border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;background:#fff}.preview-title{display:block;font-size:27rpx;font-weight:650}.preview-impact,.preview-step{display:block;margin-top:8rpx;color:var(--ls-text-secondary);font-size:23rpx;line-height:36rpx}.preview-actions{display:flex;gap:12rpx;margin-top:18rpx}.preview-button{flex:1;min-height:88rpx}.preview-button.primary{background:var(--ls-action-gradient);color:#fff}.assistant-error{margin-top:16rpx;padding:16rpx 20rpx;border-radius:14rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:22rpx}.body-spacer{height:180rpx}
.assistant-input-row{position:absolute;z-index:3;left:24rpx;right:24rpx;bottom:calc(18rpx + env(safe-area-inset-bottom));height:92rpx;display:flex;align-items:center;gap:12rpx}.capability-trigger{width:88rpx;height:88rpx;flex:0 0 88rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border:1rpx solid var(--ls-border);border-radius:50%;background:#fff;color:var(--ls-text);font-size:45rpx;font-weight:300;line-height:1}.assistant-composer{min-width:0;min-height:92rpx;flex:1;padding:8rpx 10rpx 8rpx 20rpx;display:flex;align-items:center;gap:8rpx;border:1rpx solid var(--ls-border);border-radius:48rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(23,35,61,.12);box-sizing:border-box}.assistant-composer.recording{border-color:var(--ls-primary)}.composer-input{min-width:0;flex:1;height:70rpx;font-size:25rpx}.send-hit,.voice-entry,.keyboard-entry{width:88rpx;height:88rpx;min-width:88rpx;max-width:88rpx;flex:0 0 88rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box}.send-glyph{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--ls-action-gradient);color:#fff;font-size:30rpx;line-height:1}.send-glyph.disabled-state{background:var(--ls-fill);color:var(--ls-text-tertiary)}.voice-entry{gap:4rpx}.voice-bar{width:4rpx;height:18rpx;border-radius:4rpx;background:var(--ls-text-secondary)}.voice-bar.medium{height:28rpx}.voice-bar.tall{height:38rpx}.voice-hold{min-width:0;min-height:72rpx;flex:1;display:flex;align-items:center;justify-content:center;color:var(--ls-text);font-size:25rpx;font-weight:650}.voice-hold.holding{color:var(--ls-primary)}.keyboard-entry{color:var(--ls-text-secondary);font-size:31rpx}.voice-status{position:absolute;z-index:4;left:36rpx;right:36rpx;bottom:calc(130rpx + env(safe-area-inset-bottom));min-height:72rpx;padding:12rpx 20rpx;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;border-radius:18rpx;background:var(--ls-primary);color:#fff;font-size:22rpx}
@keyframes fade-in{from{opacity:0}to{opacity:1}}@keyframes sheet-in{from{transform:translateY(100%)}to{transform:translateY(0)}}@media (prefers-reduced-motion:reduce){.assistant-overlay,.assistant-sheet{animation:none}}
