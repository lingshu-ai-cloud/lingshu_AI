@import "styles/tokens.wxss";
page { background: var(--ls-bg); color: var(--ls-text); font-size: 30rpx; }
button { border-radius: 16rpx; }

@import "styles/components.wxss";

/* Shared compact week selector used above the three workbench metrics. */
.week-card{padding:0 20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;transition:padding-bottom .18s ease}.week-card.expanded{padding-bottom:20rpx}.week-heading{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;color:var(--ls-text-tertiary);font-size:22rpx}.week-action{min-width:112rpx;min-height:88rpx;display:flex;align-items:center}.week-action:last-child{justify-content:flex-end}.week-summary{min-width:0;flex:1;display:flex;align-items:center;justify-content:center;gap:10rpx}.week-range{color:var(--ls-text);font-weight:600;text-align:center}.week-chevron{width:24rpx;color:var(--ls-text-tertiary);font-size:20rpx;text-align:center}.days{display:flex;justify-content:space-between}.day{position:relative;width:72rpx;min-height:88rpx;border-radius:var(--ls-radius-control);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ls-text-tertiary)}.day.selected{background:var(--ls-selected);color:var(--ls-text)}.weekday{font-size:20rpx}.day-number{font-size:28rpx;font-weight:600}.day-indicator{position:absolute;bottom:6rpx;width:6rpx;height:6rpx;border-radius:50%;background:var(--ls-warning)}
