<view class="page">
  <view wx:if="{{!loggedIn}}" class="login panel">
    <view class="brand">灵枢</view><view class="title">随时掌握工作的进展</view><view class="muted">使用现有企业账号登录</view>
    <input placeholder="邮箱或账号" value="{{email}}" bindinput="inputEmail"/><input placeholder="密码" password value="{{password}}" bindinput="inputPassword"/>
    <button class="primary" loading="{{loading}}" bindtap="signIn">进入工作台</button>
  </view>
  <block wx:else>
    <view wx:if="{{offline}}" class="warning network-banner">网络已断开 · 显示上次同步结果，操作需联网</view><view class="header"><view><text class="brand">灵枢</text><view class="muted">{{userName}}</view></view><text class="link" bindtap="signOut">退出</text></view>
    <view wx:if="{{tab === 'work'}}">
      <view class="section-head"><view class="title">工作播报</view><text class="link" bindtap="openShooting">＋ 拍摄上传</text></view>
      <view wx:if="{{workspaceNote}}" class="muted">{{workspaceNote}}</view><view class="week-nav"><text data-offset="-1" bindtap="changeWeek">‹ 上周</text><text>{{week.start}} — {{week.end}}</text><text data-offset="1" bindtap="changeWeek">下周 ›</text></view>
      <view class="metrics panel"><view wx:for="{{metrics}}" wx:key="key" class="metric" data-key="{{item.key}}" bindtap="openMetric"><view class="metric-value">{{item.value}}<text class="metric-arrow">›</text></view><view class="muted">{{item.label}}</view></view></view>
      <view class="muted sync">{{loading ? '正在同步真实工作数据…' : '最近刷新 ' + (updatedAt || '尚未同步')}}</view>
      <view class="section-head"><view class="section-title">Agent 正在做什么</view><text class="link" bindtap="showAgents">全部 ›</text></view>
      <view class="agent-list"><view wx:for="{{agents}}" wx:key="role" class="agent-row"><view class="agent-avatar">枢</view><view class="grow"><view class="strong">{{item.label}} <text class="status">{{item.statusLabel}}</text></view><view class="muted">{{item.currentTask || '当前无活跃任务'}}</view></view></view><view wx:if="{{!agents.length}}" class="empty">暂无 Agent 状态</view></view>
      <view class="section-head"><view class="section-title">内容排期</view><text class="muted">点日期，看当天任务</text></view>
      <view class="days"><view wx:for="{{days}}" wx:key="date" class="day {{selectedDay === item.date ? 'selected-day' : ''}}" data-date="{{item.date}}" bindtap="selectDay"><text>周{{item.label}}</text><text class="day-number">{{item.number}}</text><text class="day-count">{{item.count ? item.count + ' 项' : '·'}}</text></view></view>
      <view wx:for="{{dayPosts}}" wx:key="id" class="schedule panel" data-id="{{item.id}}" bindtap="openPost"><view class="task-title">{{item.title}}</view><view class="muted">{{item.platform}} · {{item.statusLabel}}</view><view wx:if="{{item.publishError}}" class="warning">{{item.publishError}}</view><text class="link">查看任务进展 ›</text></view>
      <view wx:if="{{!dayPosts.length}}" class="empty">这一天没有内容排期</view>
      <view class="section-head"><view class="section-title">本周任务推进</view></view><view wx:for="{{tasks}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="openTask"><view class="strong">{{item.title}}</view><view class="muted">{{item.agentLabel}} · {{item.statusLabel}}</view><view wx:if="{{item.blocked_reason}}" class="warning">{{item.blocked_reason}}</view></view><view wx:if="{{!tasks.length && !loading}}" class="empty">{{error ? '工作记录未成功同步，请刷新重试' : '当前范围暂无任务记录'}}</view><button class="secondary" loading="{{loading}}" bindtap="refresh">刷新工作数据</button>
    </view>
    <view wx:elif="{{tab === 'todo'}}">
      <view class="section-head"><view class="title">需要你处理</view><text class="link" bindtap="showSnoozed">稍后 {{snoozed.length}}</text></view><view class="muted">{{matters.length}} 件事项 · 按紧急程度排序</view>
      <view wx:if="{{activeMatter}}" class="deck"><view class="deck-back"></view><view class="matter panel" style="transform: translateX({{cardX}}px) rotate({{cardX / 25}}deg)" bindtap="viewMatter" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"><view class="eyebrow">{{activeMatter.priority === 'urgent' || activeMatter.priority === 'critical' ? '紧急处理' : activeMatter.priority === 'high' ? '优先处理' : '待你处理'}}</view><view class="matter-title">{{activeMatter.title}}</view><view class="matter-reason">{{activeMatter.reason}}</view><view wx:if="{{activeMatter.dueAt}}" class="warning">截止：{{activeMatter.dueAt}}</view><view wx:if="{{activeMatter.task}}" class="muted">{{activeMatter.task.agentLabel}} · {{activeMatter.task.statusLabel}}</view><view wx:if="{{processing}}" class="muted">正在提交并核验最新状态…</view><view class="matter-action">{{activeMatter.action}}</view><view class="swipe-label">{{swipeLabel || '← 稍后处理　　查看详情 →'}}</view></view></view>
      <view wx:else class="empty clear"><view class="clear-icon">✓</view><view class="section-title">{{queueAvailable ? '暂时没有需要你处理的事项' : '待处理队列尚未成功同步'}}</view><view class="muted">Agent 的工作进展可在“工作”查看</view></view>
      <view wx:if="{{activeMatter}}" class="actions"><button class="secondary" disabled="{{processing || offline}}" bindtap="snooze">稍后</button><button class="primary" disabled="{{processing}}" bindtap="processMatter">查看并处理 ›</button></view>
      <view wx:if="{{undoVisible}}" class="undo" bindtap="undoSnooze">已移到稍后 · 撤销</view><view class="muted footnote">滑动只选择处理方式，确认或上传成功后才更新任务状态。稍后设置同步到当前账号。</view><button class="secondary" loading="{{loading}}" bindtap="refresh">刷新事项</button>
    </view>
    <view wx:else class="assistant">
      <view class="assistant-switch"><text class="{{assistantMode === 'chat' ? 'active' : ''}}" data-mode="chat" bindtap="switchAssistant">对话</text><text class="{{assistantMode === 'notifications' ? 'active' : ''}}" data-mode="notifications" bindtap="switchAssistant">通知 {{notifications.length}}</text></view>
      <block wx:if="{{assistantMode === 'chat'}}"><view wx:if="{{!messages.length}}" class="welcome"><view class="assistant-avatar">枢</view><view class="title">我在这。今天想推进什么？</view><view class="muted">查看进展、找到卡点、准备下一步</view></view><view wx:if="{{!messages.length}}" class="suggestions"><view wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="askSuggestion">→　{{item}}</view></view>
      <scroll-view wx:else scroll-y class="chat" scroll-into-view="{{chatAnchor}}"><view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-bubble {{item.role}}"><view class="muted">{{item.role === 'user' ? '你' : '灵小枢'}}</view><text selectable>{{item.content}}</text></view><view wx:if="{{sending}}" class="muted">正在整理回答…</view></scroll-view>
      <view class="composer"><textarea auto-height maxlength="4000" placeholder="说说你想做什么" value="{{input}}" bindinput="inputText"/><view class="composer-actions"><button size="mini" bindtap="toggleVoice" disabled="{{transcribing || sending}}">{{recording ? '停止录音' : transcribing ? '识别中…' : '语音'}}</button><button wx:if="{{recording}}" size="mini" bindtap="cancelRecording">取消</button><button size="mini" class="primary" loading="{{sending}}" disabled="{{!input || recording || transcribing || offline}}" bindtap="send">发送 ↑</button></view><button wx:if="{{workspaceKind === 'starter'}}" size="mini" disabled="{{!input || sending || recording || transcribing || offline}}" bindtap="submitInstruction">提交工作指令</button><view class="muted">{{recording ? '正在录音，最长 60 秒' : '语音识别后可编辑，再发送'}}</view></view></block>
      <view wx:else><view wx:for="{{notifications}}" wx:key="id" class="notification" data-id="{{item.id}}" bindtap="openNotification"><view class="strong">{{item.title}}</view><view class="muted">{{item.time}}</view></view><view wx:if="{{!notifications.length}}" class="empty">当前周期暂无工作通知</view></view>
    </view>
    <view class="tabs"><view class="tab {{tab === 'todo' ? 'active' : ''}}" data-tab="todo" bindtap="switchTab"><text class="tab-icon">◇</text><text>待处理 {{matters.length || ''}}</text></view><view class="tab {{tab === 'work' ? 'active' : ''}}" data-tab="work" bindtap="switchTab"><text class="tab-icon">▦</text><text>工作</text></view><view class="tab {{tab === 'assistant' ? 'active' : ''}}" data-tab="assistant" bindtap="switchTab"><text class="tab-icon">◉</text><text>助手</text></view></view>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
<view wx:if="{{sheet || detail}}" class="overlay"><view class="sheet"><view class="section-head"><view class="section-title">{{detail ? detail.title : sheet}}</view><text class="link" bindtap="closeDetail">关闭 ×</text></view><scroll-view scroll-y class="sheet-body"><block wx:if="{{detail}}"><view class="status">{{detail.statusLabel}}</view><view wx:if="{{detail.agentLabel}}" class="muted">负责：{{detail.agentLabel}}</view><view wx:if="{{detail.next}}" class="detail-text">下一步：{{detail.next}}</view><view wx:if="{{detail.output}}" class="detail-text">业务产出：{{detail.output}}</view><view class="detail-text">{{detail.reason || detail.subtitle || detail.description}}</view><view wx:if="{{detail.kind === 'inquiry'}}" class="detail-text">{{detail.body || detail.text || detail.message}}</view><view wx:for="{{detail.conversation}}" wx:key="id" class="event"><view>{{item.body}}</view><view class="muted">{{item.time}}</view></view><view wx:if="{{detail.videoUrl}}"><video src="{{detail.videoUrl}}" controls /></view><view wx:if="{{detail.stage}}" class="strong">当前阶段：{{detail.stage}}</view><view wx:for="{{detail.steps}}" wx:key="label" class="event"><text>{{item.state === 'done' ? '✓' : item.state === 'active' ? '◉' : '○'}} {{item.label}}</text></view><view wx:for="{{detail.events}}" wx:key="id" class="event"><view>{{item.summary}}</view><view class="muted">{{item.occurred_at}}</view></view><view wx:if="{{detail.loading}}" class="muted">正在读取任务的最新进展…</view><view wx:if="{{detail.loadError}}" class="warning">{{detail.loadError}}<button size="mini" bindtap="reloadDetail">重新读取详情</button></view><view wx:if="{{detail.result}}" class="result"><view class="muted">已保存的任务结果</view><text selectable>{{detail.result}}</text></view><view wx:if="{{detail.starter}}"><view wx:for="{{detail.actions}}" wx:key="id"><view wx:if="{{item.command === 'resolve_decision'}}" class="actions"><button disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" data-decision="rejected" bindtap="starterAction">退回</button><button class="primary" disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" data-decision="approved" bindtap="starterAction">确认同意</button></view><button wx:else disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" bindtap="starterAction">{{item.label}}</button><view class="muted">{{item.disabledReason}}</view></view></view><view wx:if="{{detail.approval}}" class="actions"><button disabled="{{processing || offline}}" data-decision="rejected" loading="{{processing}}" bindtap="decideApproval">退回</button><button class="primary" disabled="{{processing || offline}}" data-decision="approved" loading="{{processing}}" bindtap="decideApproval">确认批准</button></view><button wx:if="{{!detail.starter && detail.status === 'failed'}}" class="primary" disabled="{{processing || offline}}" loading="{{processing}}" bindtap="retryTask">查看确认并重试</button><view wx:if="{{detail.type === 'task' && detail.status !== 'failed'}}" class="muted">可在助手询问此任务的处理建议。</view></block><block wx:else><view wx:for="{{sheetItems}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="selectItem"><view class="strong">{{item.title}}</view><view class="muted">{{item.subtitle}}</view></view><view wx:if="{{!sheetItems.length}}" class="empty">没有符合当前范围的记录</view><view wx:if="{{sheetError}}" class="warning">{{sheetError}}</view></block></scroll-view><view wx:if="{{error}}" class="error">{{error}}</view></view></view>
