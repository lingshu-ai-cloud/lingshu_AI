<view class="page">
  <view wx:if="{{!loggedIn}}" class="login panel">
    <view class="brand">灵枢</view><view class="title">随时掌握工作的进展</view><view class="muted">使用现有企业账号登录</view>
    <input class="login-input" placeholder="邮箱或账号" value="{{email}}" bindinput="inputEmail"/><input class="login-input" placeholder="密码" password value="{{password}}" bindinput="inputPassword"/>
    <button class="primary" loading="{{loading}}" bindtap="signIn">进入工作台</button>
  </view>
  <block wx:else>
    <view wx:if="{{offline}}" class="warning network-banner">网络已断开 · 显示上次同步结果，操作需联网</view><view wx:if="{{tab !== 'assistant'}}" class="header"><view><text class="brand">灵枢</text><view class="muted">{{userName}}</view></view><text class="link" bindtap="signOut">退出</text></view>
    <view wx:if="{{tab === 'work'}}">
      <view class="section-head"><view class="title">工作播报</view><text class="link" bindtap="openShooting">＋ 拍摄上传</text></view>
      <view wx:if="{{workspaceNote}}" class="muted">{{workspaceNote}}</view><view class="week-nav"><text class="week-link" data-offset="-1" bindtap="changeWeek">‹ 上周</text><text class="week-link">{{week.start}} — {{week.end}}</text><text class="week-link" data-offset="1" bindtap="changeWeek">下周 ›</text></view>
      <view class="metrics panel"><view wx:for="{{metrics}}" wx:key="key" class="metric" data-key="{{item.key}}" bindtap="openMetric"><view class="metric-value">{{item.value}}<text class="metric-arrow">›</text></view><view class="muted">{{item.label}}</view></view></view>
      <view class="muted sync">{{loading ? '正在同步真实工作数据…' : '最近刷新 ' + (updatedAt || '尚未同步')}}</view>
      <view class="section-head agent-schedule-head"><view><view class="section-title">Agent 排期</view><view class="muted">当前安排 · 随工作台实时更新</view></view></view>
      <view class="agent-schedule panel">
        <view wx:for="{{agentScheduleGroups}}" wx:for-item="group" wx:key="role" class="schedule-group">
          <view class="schedule-group-heading"><view class="agent-avatar">枢</view><text class="strong">{{group.label}}</text><text class="muted schedule-group-count">{{group.items.length ? group.items.length + ' 项安排' : group.unavailable ? '未同步' : '空闲'}}</text></view>
          <view wx:for="{{group.items}}" wx:key="id" class="schedule-assignment" data-id="{{item.id}}" bindtap="openAgentAssignment">
            <view class="schedule-dot {{item.blockedLabel ? 'schedule-dot-blocked' : ''}}"></view>
            <view class="schedule-time">{{item.timeLabel}}<text wx:if="{{item.dueLabel}}"> · {{item.dueLabel}}</text></view>
            <view class="schedule-title-row"><text class="strong">{{item.title}}</text><text class="agent-status">{{item.statusLabel}}</text></view>
            <view class="schedule-node">当前节点 · {{item.stageLabel}}</view>
            <view class="muted">负责 · {{item.ownerLabel}}</view>
            <view wx:if="{{item.blockedLabel}}" class="schedule-blocked">阻塞 · {{item.blockedLabel}}</view>
            <view wx:if="{{item.lastEventLabel}}" class="muted">最近进展 · {{item.lastEventLabel}}</view>
            <view class="schedule-next">下一步 · {{item.nextLabel}}</view>
            <view class="schedule-footer"><text class="muted">{{item.observedLabel}}</text><text class="link">{{item.needsIntervention ? '需要你处理 ›' : '查看进展 ›'}}</text></view>
          </view>
          <view wx:if="{{!group.items.length}}" class="schedule-idle muted">{{group.unavailable ? '排期未成功同步，请刷新重试' : '当前没有安排任务'}}</view>
        </view>
        <view wx:if="{{!agentScheduleGroups.length && !loading}}" class="empty">{{error ? 'Agent 排期未成功同步，请刷新重试' : '当前没有 Agent 排期'}}</view>
      </view>
      <button class="secondary refresh-button" loading="{{loading}}" bindtap="refresh">刷新工作数据</button>
    </view>
    <view wx:elif="{{tab === 'todo'}}">
      <view class="todo-head"><button class="view-toggle" bindtap="toggleTodoView">{{todoView === 'card' ? '☷' : '◇'}}<text>{{todoView === 'card' ? '列表' : '卡片'}}</text></button><view class="title">需要你处理</view><text class="link" bindtap="showSnoozed">稍后 {{snoozed.length}}</text></view><view class="muted">{{matters.length}} 件事项 · 按紧急程度排序</view>
      <block wx:if="{{todoView === 'card'}}">
      <view wx:if="{{activeMatter}}" class="deck"><view class="deck-back"></view><view wx:if="{{swipeDirection === 'later'}}" class="swipe-cue cue-later {{swipeReady ? 'cue-ready' : ''}}"><text class="cue-icon">⌛</text><text>{{swipeReady ? '松手稍后提醒' : '稍后处理'}}</text></view><view wx:if="{{swipeDirection === 'process'}}" class="swipe-cue cue-process {{swipeReady ? 'cue-ready' : ''}}"><text class="cue-icon">{{activeMatter.type === 'shoot' || activeMatter.shootingId ? '●' : '✓'}}</text><text>{{activeMatter.type === 'shoot' || activeMatter.shootingId ? (swipeReady ? '松手打开相机' : '开始拍摄') : (swipeReady ? '松手立即处理' : '立即处理')}}</text></view><view class="matter panel" style="transform: translateX({{cardX}}px) rotate({{cardX / 25}}deg)" bindtap="viewMatter" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"><view class="eyebrow">{{activeMatter.priority === 'urgent' || activeMatter.priority === 'critical' ? '紧急处理' : activeMatter.priority === 'high' ? '优先处理' : '待你处理'}}</view><view class="matter-title">{{activeMatter.title}}</view><view class="matter-reason">{{activeMatter.reason}}</view><view wx:if="{{activeMatter.dueAt}}" class="warning">截止：{{activeMatter.dueAt}}</view><view wx:if="{{activeMatter.task}}" class="muted">{{activeMatter.task.agentLabel}} · {{activeMatter.task.statusLabel}}</view><view wx:if="{{processing}}" class="muted">正在提交并核验最新状态…</view><view class="matter-action">{{activeMatter.action}}</view><view class="swipe-label {{swipeReady ? 'ready' : ''}}">{{swipeLabel || (activeMatter.type === 'shoot' || activeMatter.shootingId ? '左滑稍后提醒　·　右滑开始拍摄' : '左滑稍后提醒　·　右滑立即处理')}}</view></view></view>
      </block>
      <view wx:if="{{todoView === 'list' && matters.length}}" class="todo-list"><view wx:for="{{matters}}" wx:key="id" class="todo-list-item panel" data-id="{{item.id}}" bindtap="openMatterFromList"><view class="todo-list-top"><text class="todo-priority {{item.priority === 'urgent' || item.priority === 'critical' ? 'urgent' : ''}}">{{item.priority === 'urgent' || item.priority === 'critical' ? '紧急' : item.priority === 'high' ? '优先' : '待处理'}}</text><text wx:if="{{item.dueAt}}" class="muted">{{item.dueAt}}</text></view><view class="todo-list-title">{{item.title}}</view><view class="todo-list-reason">{{item.reason}}</view><view class="todo-list-footer"><text class="muted">{{item.task ? item.task.agentLabel : '点击查看处理选项'}}</text><text class="link">处理 ›</text></view></view></view>
      <view wx:if="{{!matters.length}}" class="empty clear"><view class="clear-icon">✓</view><view class="section-title">{{queueAvailable ? '暂时没有需要你处理的事项' : '待处理队列尚未成功同步'}}</view><view class="muted">Agent 的工作进展可在“工作”查看</view></view>
      <view wx:if="{{todoView === 'card' && activeMatter}}" class="actions"><button class="secondary" disabled="{{processing || offline}}" bindtap="snooze">稍后</button><button class="primary" disabled="{{processing}}" bindtap="processMatter">查看并处理 ›</button></view>
      <view wx:if="{{undoVisible}}" class="undo" bindtap="undoSnooze">已移到稍后 · 撤销</view><view class="muted footnote">滑动只选择处理方式，确认或上传成功后才更新任务状态。稍后设置同步到当前账号。</view><button class="secondary" loading="{{loading}}" bindtap="refresh">刷新事项</button>
    </view>
    <view wx:else class="assistant">
      <view class="assistant-header">
        <view class="assistant-identity"><view class="assistant-avatar-small">枢</view><view><view class="assistant-name">灵小枢</view><view class="assistant-presence"><text class="presence-dot {{offline ? 'offline' : ''}}"></text>{{offline ? '离线' : assistantLoading ? '同步中' : '在线'}}</view></view></view>
        <button class="notification-button {{assistantMode === 'notifications' ? 'active' : ''}}" bindtap="toggleAssistantNotifications" aria-label="工作通知"><text>通知</text><text wx:if="{{notifications.length}}" class="notification-badge">{{notifications.length}}</text></button>
      </view>
      <block wx:if="{{assistantMode === 'chat'}}">
        <scroll-view scroll-y class="assistant-scroll" scroll-into-view="{{chatAnchor}}">
          <view wx:if="{{!messages.length}}" class="welcome"><view class="assistant-avatar">枢</view><view class="assistant-welcome-title">今天想推进什么？</view><view class="muted">我可以帮你查看进展、找到卡点并准备下一步</view></view>
          <scroll-view wx:if="{{!messages.length && suggestions.length}}" scroll-x class="suggestions" enhanced show-scrollbar="{{false}}"><view class="suggestions-track"><view class="suggestion" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="askSuggestion">{{item}}</view></view></scroll-view>
          <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message-row {{item.role}}"><view wx:if="{{item.role !== 'user'}}" class="message-avatar">枢</view><view class="message-bubble {{item.role}}"><text user-select>{{item.content}}</text><view wx:if="{{item.actions.length}}" class="assistant-actions"><button class="assistant-action-button" wx:for="{{item.actions}}" wx:for-item="action" wx:key="id" data-id="{{action.id}}" bindtap="assistantAction"><view class="assistant-action-label">{{action.label}}</view><view class="assistant-action-hint">{{action.hint}} ›</view></button></view></view></view>
          <view wx:if="{{sending}}" class="assistant-thinking"><text class="presence-dot"></text>灵小枢正在整理回答…</view>
          <view wx:for="{{assistantLinks}}" wx:key="id" class="assistant-structured-card" data-index="{{index}}" bindtap="assistantAction"><view class="structured-label">工作证据</view><view class="strong">{{item.title || '查看相关工作证据'}}</view><text class="structured-arrow">›</text></view>
          <view wx:for="{{assistantActions}}" wx:key="id" class="assistant-structured-card" data-index="{{index}}" bindtap="previewAssistantAction"><view class="structured-label">建议操作</view><view class="strong">{{item.label || '查看操作方案'}}</view><text class="structured-arrow">›</text></view>
          <view wx:if="{{assistantReceipts.length}}" class="assistant-receipts"><view class="structured-label">执行记录</view><view wx:for="{{assistantReceipts}}" wx:key="id" class="receipt-row"><view class="strong">{{item.statusLabel}}</view><view wx:if="{{item.errorLabel}}" class="warning">{{item.errorLabel}}</view><view class="muted">{{item.acceptedAt}}</view></view><text class="link" bindtap="refreshAssistantReceipts">刷新状态</text></view>
          <view wx:if="{{assistantLoading}}" class="assistant-thinking">正在恢复企业对话与执行状态…</view>
          <view class="assistant-scroll-spacer"></view>
        </scroll-view>
        <view class="composer"><view class="composer-box"><textarea class="composer-input" auto-height maxlength="4000" placeholder="给灵小枢发消息" value="{{input}}" bindinput="inputText"/><view class="composer-actions"><button class="voice-button" bindtap="toggleVoice" disabled="{{transcribing || sending}}">{{recording ? '停止' : transcribing ? '识别中' : '语音'}}</button><button class="send-button" loading="{{sending}}" disabled="{{!input || recording || transcribing || offline}}" bindtap="send">↑</button></view></view><view wx:if="{{recording}}" class="recording-hint">正在录音，最长 60 秒 · <text bindtap="cancelRecording">取消</text></view></view>
      </block>
      <scroll-view wx:else scroll-y class="assistant-scroll notification-list"><view class="notification-title">工作通知</view><view wx:for="{{notifications}}" wx:key="id" class="notification" data-id="{{item.id}}" bindtap="openNotification"><view class="strong">{{item.title}}</view><view class="muted">{{item.time}}</view><text class="structured-arrow">›</text></view><view wx:if="{{!notifications.length}}" class="empty">当前周期暂无工作通知</view></scroll-view>
    </view>
    <view class="tabs"><view class="tab {{tab === 'todo' ? 'active' : ''}}" data-tab="todo" bindtap="switchTab"><text class="tab-icon">◇</text><text>待处理 {{matters.length || ''}}</text></view><view class="tab {{tab === 'work' ? 'active' : ''}}" data-tab="work" bindtap="switchTab"><text class="tab-icon">▦</text><text>工作</text></view><view class="tab {{tab === 'assistant' ? 'active' : ''}}" data-tab="assistant" bindtap="switchTab"><text class="tab-icon">◉</text><text>助手</text></view></view>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
<view wx:if="{{assistantPreview}}" class="assistant-confirm-overlay">
  <view class="assistant-confirm-sheet">
    <view class="confirm-handle"></view>
    <view class="confirm-header"><view><view class="structured-label">执行前确认</view><view class="section-title">{{assistantPreview.target.title}}</view></view><text class="link" bindtap="dismissAssistantPreview">关闭</text></view>
    <scroll-view scroll-y class="confirm-body"><view class="confirm-impact">{{assistantPreview.impact}}</view><view class="confirm-section-title">将执行以下步骤</view><view wx:for="{{assistantPreview.steps}}" wx:key="*this" class="confirm-step"><text class="confirm-step-number">{{index + 1}}</text><text>{{item}}</text></view><view wx:if="{{assistantPreview.cost.note}}" class="warning">{{assistantPreview.cost.note}}</view></scroll-view>
    <view class="confirm-actions"><button class="secondary" disabled="{{assistantConfirming}}" bindtap="dismissAssistantPreview">取消</button><button class="primary" disabled="{{offline || assistantConfirming}}" loading="{{assistantConfirming}}" bindtap="confirmAssistantAction">确认执行</button></view>
  </view>
</view>
<view wx:if="{{sheet || detail}}" class="overlay"><view class="sheet"><view class="section-head"><view class="section-title">{{detail ? detail.title : sheet}}</view><text class="link" bindtap="closeDetail">关闭 ×</text></view><scroll-view scroll-y class="sheet-body"><block wx:if="{{detail}}"><view class="status">{{detail.statusLabel}}</view><view wx:if="{{detail.route}}" class="route panel"><view class="strong">{{detail.route.title}}</view><view wx:for="{{detail.route.steps}}" wx:key="*this" class="event"><text>{{index + 1}}. {{item}}</text></view></view><view wx:if="{{detail.agentLabel}}" class="muted">负责：{{detail.agentLabel}}</view><view wx:if="{{detail.execution.blocker}}" class="warning">当前卡点：{{detail.execution.blocker}}</view><view wx:if="{{detail.next}}" class="detail-text">下一步：{{detail.next}}</view><view class="detail-text">{{detail.reason || detail.subtitle || detail.description}}</view><view wx:if="{{detail.interventionType === 'quality_recovery'}}" class="quality-flow"><view class="flow-head"><view class="strong">质检证据与失败分镜</view><text class="muted">已选 {{detail.selectedShotIds.length}} / {{detail.failedShots.length}}</text></view><video class="media-preview" wx:if="{{detail.videoUrl}}" src="{{detail.videoUrl}}" controls /><checkbox-group bindchange="selectFailedShots"><label wx:for="{{detail.failedShots}}" wx:key="id" class="shot-option"><checkbox class="shot-checkbox" value="{{item.id}}" checked="{{item.selected}}" color="#2563EB"/><view class="grow"><view class="strong">{{item.label}}</view><view class="warning-inline">{{item.reason}}</view><view wx:if="{{item.evidence}}" class="muted">证据：{{item.evidence}}</view><video class="media-preview" wx:if="{{item.previewUrl}}" src="{{item.previewUrl}}" controls /></view></label></checkbox-group><view wx:if="{{!detail.failedShots.length}}" class="warning">后端未返回可选的失败分镜，当前不能安全发起局部重做。请刷新证据或在电脑端处理。</view><view wx:for="{{detail.evidence}}" wx:key="id" class="evidence-row">{{item.label}}</view><view class="impact panel"><view class="strong">提交后的影响</view><view wx:for="{{detail.impact}}" wx:key="*this" class="event">{{item}}</view></view><view wx:if="{{detail.canSubmitShotRetry}}" class="action-stack"><button class="primary action-button" disabled="{{processing || offline || !detail.selectedShotIds.length}}" data-mode="current" bindtap="submitQualityRetry">仅重做选中分镜</button><view class="budget-row"><input class="budget-input" type="digit" placeholder="可选：本次费用上限（元）" value="{{detail.costLimitInput}}" bindinput="inputCostLimit"/><button class="budget-button" disabled="{{processing || offline || !detail.selectedShotIds.length}}" data-mode="budget" bindtap="submitQualityRetry">按上限重做</button></view></view><view wx:if="{{detail.receipt}}" class="receipt"><view class="strong">✓ {{detail.receipt.statusLabel}}</view><view>{{detail.receipt.summary}}</view><view class="muted">回执 {{detail.receipt.id}}</view></view></view><view wx:if="{{detail.kind === 'inquiry'}}" class="detail-text">{{detail.body || detail.text || detail.message}}</view><view wx:for="{{detail.conversation}}" wx:key="id" class="event"><view>{{item.body}}</view><view class="muted">{{item.time}}</view></view><view wx:if="{{detail.videoUrl}}"><video class="media-preview" src="{{detail.videoUrl}}" controls /></view><view wx:if="{{detail.stage}}" class="strong">当前阶段：{{detail.stage}}</view><view wx:for="{{detail.steps}}" wx:key="label" class="event"><text>{{item.state === 'done' ? '✓' : item.state === 'active' ? '◉' : '○'}} {{item.label}}</text></view><view wx:for="{{detail.events}}" wx:key="id" class="event"><view>{{item.summary}}</view><view class="muted">{{item.occurred_at}}</view></view><view wx:if="{{detail.loading}}" class="muted">正在读取任务的最新进展…</view><view wx:if="{{detail.loadError}}" class="warning">{{detail.loadError}}<button size="mini" bindtap="reloadDetail">重新读取详情</button></view><view wx:if="{{detail.result}}" class="result"><view class="muted">已保存的任务结果</view><text user-select>{{detail.result}}</text></view><view wx:if="{{detail.starter}}"><view wx:for="{{detail.actions}}" wx:key="id"><view wx:if="{{item.command === 'resolve_decision'}}" class="actions"><button disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" data-decision="rejected" bindtap="starterAction">退回</button><button class="primary" disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" data-decision="approved" bindtap="starterAction">确认同意</button></view><button wx:else disabled="{{processing || offline || item.disabledReason}}" data-id="{{item.id}}" bindtap="starterAction">{{item.label}}</button><view class="muted">{{item.disabledReason}}</view></view></view><view wx:if="{{detail.approval}}" class="actions"><button disabled="{{processing || offline}}" data-decision="rejected" loading="{{processing}}" bindtap="decideApproval">退回</button><button class="primary" disabled="{{processing || offline}}" data-decision="approved" loading="{{processing}}" bindtap="decideApproval">接受当前结果</button></view><view wx:if="{{detail.route.kind === 'authorization'}}" class="action-stack"><button class="primary action-button" data-mode="authorization_fixed" bindtap="retryWithMode">我已重新授权，校验并重试</button></view><view wx:if="{{detail.route.kind === 'budget'}}" class="action-stack"><button class="primary action-button" data-mode="increase_cost_limit" bindtap="retryWithMode">设置单次费用上限</button></view><view wx:if="{{detail.route.kind === 'recovery_choice'}}" class="action-stack"><button class="action-button" data-mode="retry_failed_step" bindtap="retryWithMode">只重试失败步骤</button><button class="action-button" data-mode="rerun_downstream" bindtap="retryWithMode">重跑失败节点及下游</button></view><view wx:if="{{detail.route.kind === 'instruction'}}" class="action-stack"><button class="primary action-button" data-mode="supply_instruction" bindtap="retryWithMode">在本页补充指令并继续</button></view></block><block wx:else><view wx:for="{{sheetItems}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="selectItem"><view class="strong">{{item.title}}</view><view class="muted">{{item.subtitle}}</view></view><view wx:if="{{!sheetItems.length}}" class="empty">没有符合当前范围的记录</view><view wx:if="{{sheetError}}" class="warning">{{sheetError}}</view></block></scroll-view><view wx:if="{{error}}" class="error">{{error}}</view></view></view>
