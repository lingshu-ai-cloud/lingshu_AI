page{background:var(--ls-bg);color:var(--ls-text);font-size:28rpx}.page{padding:32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}.title{font-size:40rpx;font-weight:700;line-height:1.4}.reason{color:var(--ls-text-secondary);line-height:1.6;margin-top:12rpx}.impact,.warning{background:var(--ls-warning-bg);color:var(--ls-warning);padding:24rpx;border-radius:16rpx;margin:20rpx 0;line-height:1.6}.meta{font-size:23rpx;color:var(--ls-text-secondary);line-height:1.6;margin:12rpx 0}.panel{background:white;border:1rpx solid var(--ls-border-secondary);border-radius:24rpx;padding:28rpx;margin:24rpx 0}.heading{font-size:31rpx;font-weight:650;margin-bottom:20rpx}.row{padding:20rpx 0;border-bottom:1rpx solid var(--ls-fill)}.row:last-child{border-bottom:0}.scene{display:flex;align-items:flex-start;gap:18rpx}.grow{flex:1;min-width:0}.video,.evidence-image{width:100%;margin-top:20rpx}.field{margin:24rpx 0}.field input,.field textarea{border:1rpx solid var(--ls-border);border-radius:14rpx;padding:22rpx;margin-top:12rpx;box-sizing:border-box;width:100%}.primary{background:var(--ls-primary);color:white;margin-top:24rpx}.secondary{background:white;color:var(--ls-primary)}.empty{text-align:center;padding:70rpx 0;color:var(--ls-text-secondary)}.receipt{border-color:var(--ls-primary)}button{border-radius:16rpx;min-height:88rpx;font-size:28rpx}
.replacement{background:var(--ls-info-bg);color:var(--ls-primary);padding:22rpx;border-radius:12rpx;margin:16rpx 0;min-height:48rpx}

@import "../../styles/components.wxss";
