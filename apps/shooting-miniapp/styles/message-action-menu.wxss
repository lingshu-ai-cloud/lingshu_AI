.message-action-menu{position:absolute;z-index:5;left:28rpx;width:620rpx;max-width:calc(100vw - 76rpx);height:480rpx;max-height:calc(100vh - 280rpx);padding:16rpx;box-sizing:border-box;border:1rpx solid rgba(255,255,255,.9);border-radius:50rpx;background:rgba(250,250,252,.88);-webkit-backdrop-filter:blur(30rpx) saturate(145%);backdrop-filter:blur(30rpx) saturate(145%);box-shadow:0 34rpx 90rpx rgba(23,35,61,.22),inset 0 1rpx 0 rgba(255,255,255,.96);overflow:hidden}
.message-action-option{min-height:112rpx;padding:0 28rpx;display:flex;align-items:center;gap:28rpx;border-radius:30rpx;box-sizing:border-box;color:#111318}
.message-action-option:active{background:rgba(118,118,128,.11)}
.message-action-icon{width:68rpx;height:68rpx;flex:0 0 68rpx;display:flex;align-items:center;justify-content:center;border-radius:21rpx;background:linear-gradient(145deg,#4c7df0,#315bea);color:#fff;font-size:28rpx;font-weight:700;box-shadow:0 5rpx 14rpx rgba(23,35,61,.13)}
.message-action-icon.violet{background:linear-gradient(145deg,#9b63f5,#7047dc)}.message-action-icon.green{background:linear-gradient(145deg,#31c98d,#079a6a)}.message-action-icon.orange{background:linear-gradient(145deg,#ffc44c,#e98a00)}.message-action-icon.blue{background:linear-gradient(145deg,#55a8ff,#3478f6)}
.message-action-title{font-size:34rpx;font-weight:520;line-height:48rpx;letter-spacing:.2rpx}
