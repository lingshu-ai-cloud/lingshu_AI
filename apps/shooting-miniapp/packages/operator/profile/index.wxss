page{background:#f6f7fa}.profile-page{padding:32rpx 32rpx 160rpx}.profile-card{display:flex;align-items:center;gap:22rpx;padding:30rpx;border-radius:24rpx;background:#fff}.avatar{width:86rpx;height:86rpx;border-radius:28rpx;background:var(--ls-action-gradient);color:#fff;font-size:36rpx;line-height:86rpx;text-align:center}.name{display:block;font-size:31rpx;font-weight:650}.organization{display:block;margin-top:5rpx;color:var(--ls-text-tertiary);font-size:23rpx}.settings{margin-top:22rpx;border-radius:24rpx;background:#fff;overflow:hidden}.row{display:flex;justify-content:space-between;padding:28rpx;border-bottom:1rpx solid var(--ls-border-secondary);font-size:27rpx}.row:last-child{border:0}.sign-out{margin-top:28rpx;background:#fff;color:var(--ls-error);font-size:27rpx}
