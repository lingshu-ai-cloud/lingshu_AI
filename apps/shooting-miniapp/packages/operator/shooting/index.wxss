.page{min-height:100vh;padding:28rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;color:var(--ls-text)}
.surface{border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;background:#fff}
.login{margin-top:10vh;padding:32rpx}.eyebrow{margin-bottom:8rpx;color:var(--ls-text-secondary);font-size:24rpx;font-weight:600}.page-title{font-size:40rpx;line-height:1.35;font-weight:700;overflow-wrap:break-word}.muted{color:var(--ls-text-tertiary);font-size:24rpx;line-height:1.5}.field{width:100%;height:88rpx;margin-top:20rpx;padding:0 20rpx;border:1rpx solid var(--ls-border);border-radius:12rpx;box-sizing:border-box;background:#fff}.primary,.secondary{min-height:88rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;font-weight:650}.primary{margin-top:24rpx;background:var(--ls-action-gradient);color:#fff}.secondary{border:1rpx solid var(--ls-border);background:#fff;color:var(--ls-primary)}
.asset-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.asset-title,.asset-note{display:block}.asset-title{font-size:40rpx;line-height:54rpx;font-weight:680}.asset-note{margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:32rpx}.header-action{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;color:var(--ls-text-secondary);font-size:24rpx}.asset-toolbar{min-height:88rpx;margin-top:22rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid var(--ls-border-secondary);border-bottom:1rpx solid var(--ls-border-secondary)}.view-toggle{display:flex;align-items:center;gap:6rpx}.view-icon{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;color:var(--ls-text-tertiary);font-size:28rpx}.view-icon.active{background:var(--ls-fill);color:var(--ls-text)}.asset-total{color:var(--ls-text-secondary);font-size:22rpx}.task-filter-scroll{width:100%;margin:18rpx 0 8rpx;white-space:nowrap}.task-filters{display:inline-flex;gap:10rpx}.task-filter{min-height:60rpx;padding:0 20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:30rpx;color:var(--ls-text-secondary);font-size:22rpx;line-height:60rpx}.task-filter.active{border-color:var(--ls-primary);background:var(--ls-selected);color:var(--ls-primary);font-weight:600}
.date-section{margin-top:26rpx}.date-heading{display:flex;align-items:baseline;gap:12rpx;margin-bottom:14rpx;font-size:29rpx;font-weight:650}.date-text{color:var(--ls-text-tertiary);font-size:21rpx;font-weight:500}.shoot-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.shoot-card{position:relative;min-width:0;overflow:hidden;border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;background:#fff}.shoot-card:active{background:var(--ls-selected)}.shoot-card-done{background:#fbfdfc}.shot-media{position:relative;width:100%;height:230rpx;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--ls-fill);color:var(--ls-text-secondary)}.shot-media-done{background:var(--ls-success-bg);color:var(--ls-success)}.shot-media-label{font-size:24rpx;font-weight:650}.shot-media-ratio{margin-top:8rpx;font-size:20rpx}.shot-preview{display:block;width:100%;height:230rpx;background:#111827}.shot-preview-badge,.shot-ratio{position:absolute;bottom:10rpx;z-index:2;padding:3rpx 8rpx;border-radius:6rpx;background:rgba(17,24,39,.76);color:#fff;font-size:17rpx;line-height:25rpx;pointer-events:none}.shot-preview-badge{left:10rpx}.shot-ratio{right:10rpx}.shoot-content{padding:16rpx}.shoot-title,.shoot-context{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.shoot-title{font-size:25rpx;line-height:36rpx;font-weight:650}.shoot-context{margin-top:4rpx;color:var(--ls-text-tertiary);font-size:20rpx}.asset-field{min-height:72rpx;margin-top:12rpx;padding:10rpx 12rpx;display:flex;flex-direction:column;justify-content:center;gap:7rpx;border:1rpx solid var(--ls-border-secondary);border-radius:12rpx;box-sizing:border-box}.asset-field-label{color:var(--ls-text-tertiary);font-size:18rpx}.status{align-self:flex-start;padding:3rpx 10rpx;border-radius:7rpx;background:var(--ls-warning-bg);color:var(--ls-warning);font-size:19rpx;line-height:28rpx}.status-done{background:var(--ls-success-bg);color:var(--ls-success)}.assignee{min-width:0;display:flex;align-items:center;gap:8rpx;color:var(--ls-text-secondary);font-size:20rpx}.assignee-avatar{width:30rpx;height:30rpx;flex:none;border-radius:50%;background:var(--ls-fill);color:var(--ls-text);font-size:16rpx;line-height:30rpx;text-align:center}.card-more{position:absolute;right:12rpx;top:244rpx;color:var(--ls-text-tertiary);font-size:21rpx;letter-spacing:2rpx}.empty{padding:56rpx 30rpx;text-align:center}.empty-check{width:64rpx;height:64rpx;margin:0 auto 20rpx;border-radius:50%;background:var(--ls-success-bg);color:var(--ls-success);font-size:38rpx;line-height:64rpx}.empty-title{margin-bottom:8rpx;font-size:29rpx;font-weight:700}.refresh{min-height:88rpx;margin-top:16rpx;background:transparent;color:var(--ls-text-secondary);font-size:24rpx}.refresh::after,.primary::after,.secondary::after{border:0}
.detail-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}.back{min-width:88rpx;min-height:88rpx;display:flex;align-items:center;color:var(--ls-primary);font-weight:600}.detail-status{padding:8rpx 16rpx;border-radius:999rpx;background:var(--ls-warning-bg);color:var(--ls-warning);font-size:23rpx}.detail-status-done{background:var(--ls-success-bg);color:var(--ls-success)}.detail-hero,.uploads{margin-bottom:16rpx;padding:24rpx}.detail-columns{display:flex;flex-direction:column;gap:16rpx;margin-bottom:16rpx}.detail-guidance,.reference-panel{min-width:0;padding:24rpx}.reference-video{width:100%;height:720rpx;max-height:62vh;overflow:hidden;border-radius:16rpx;background:var(--ls-text)}.reference-range{margin:14rpx 0 8rpx;color:var(--ls-primary);font-size:23rpx;font-weight:650}.reference-empty{min-height:280rpx;padding:20rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;color:var(--ls-text-tertiary);font-size:23rpx;text-align:center}.guidance-divider{height:1rpx;margin:24rpx 0;background:var(--ls-border-secondary)}.detail-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--ls-border-secondary)}.detail-facts>view{min-width:0;display:flex;flex-direction:column;gap:7rpx;font-size:24rpx;overflow-wrap:break-word}.fact-label{color:var(--ls-text-tertiary);font-size:22rpx}.section-title{margin-bottom:14rpx;font-size:28rpx;font-weight:700}.detail-text{color:var(--ls-text-secondary);font-size:26rpx;line-height:1.65;white-space:pre-wrap;overflow-wrap:break-word}.narration{margin-top:16rpx;padding:18rpx;border-radius:12rpx;background:var(--ls-fill);color:var(--ls-text-secondary);line-height:1.6}.upload-row{padding:16rpx 0;display:flex;align-items:center;gap:14rpx;border-top:1rpx solid var(--ls-border-secondary);font-size:25rpx}.upload-icon{width:40rpx;height:40rpx;border-radius:8rpx;background:var(--ls-success-bg);color:var(--ls-success);line-height:40rpx;text-align:center}.binding{margin-top:12rpx;color:var(--ls-text-secondary);font-size:23rpx;line-height:1.5}.latest-upload{padding:14rpx 4rpx;color:var(--ls-text-secondary);font-size:24rpx}.upload-progress{margin:16rpx 0;padding:22rpx}.progress-head{display:flex;justify-content:space-between;color:var(--ls-text-secondary);font-size:24rpx}.progress-track{height:8rpx;margin-top:16rpx;overflow:hidden;border-radius:4rpx;background:var(--ls-border-secondary)}.progress-fill{height:100%;background:var(--ls-progress-gradient)}.detail-actions{position:sticky;z-index:5;bottom:0;padding:16rpx 0 calc(4rpx + env(safe-area-inset-bottom));display:flex;gap:14rpx;background:#fff}.action-button{flex:1;margin-top:0}.message{position:fixed;z-index:20;left:24rpx;right:24rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));padding:18rpx 22rpx;border-radius:12rpx;background:var(--ls-text);box-shadow:0 12rpx 30rpx rgba(20,25,35,.2);color:#fff;font-size:24rpx;text-align:center}
