<view class="page" style="padding-bottom:calc(224rpx + env(safe-area-inset-bottom))">
  <view wx:if="{{!loggedIn}}" class="login surface">
    <view class="eyebrow">运营工作台</view>
    <view class="page-title">登录灵枢</view>
    <view class="muted">使用与网页端相同的账号</view>
    <input class="field" type="text" placeholder="邮箱或账号" value="{{email}}" bindinput="inputEmail" />
    <input class="field" type="password" password placeholder="密码" value="{{password}}" bindinput="inputPassword" />
    <button class="primary" loading="{{loading}}" bindtap="signIn">登录</button>
  </view>

  <block wx:else>
    <view wx:if="{{!selected}}">
      <view class="asset-head"><view><text class="asset-title">素材拍摄</text><text class="asset-note">按任务状态和负责人完成镜头采集</text></view><view class="header-action" bindtap="signOut">退出</view></view>
      <view class="asset-toolbar"><view class="view-toggle"><view class="view-icon active">▦</view><view class="view-icon">☷</view></view><text class="asset-total">{{tasks.length}} 个任务</text></view>
      <scroll-view scroll-x class="task-filter-scroll" show-scrollbar="false"><view class="task-filters"><view wx:for="{{taskFilters}}" wx:key="key" class="task-filter {{taskFilter === item.key ? 'active' : ''}}" data-filter="{{item.key}}" bindtap="selectTaskFilter">{{item.label}} {{item.count}}</view></view></scroll-view>

      <view wx:for="{{visibleTaskGroups}}" wx:for-item="group" wx:key="key" class="date-section">
        <view class="date-heading"><text>{{group.label}}</text><text class="date-text">{{group.dateText}}</text></view>
        <view class="shoot-grid">
          <view wx:for="{{group.tasks}}" wx:for-item="item" wx:key="id" class="shoot-card {{item.done ? 'shoot-card-done' : ''}}" data-id="{{item.id}}" bindtap="selectTask">
            <view wx:if="{{!item.done && item.cardPreview}}" class="shot-media shot-preview-shell" catchtap="ignoreCardTap"><video id="{{item.previewPlayerId}}" class="shot-preview" src="{{item.cardPreview.url}}" poster="{{item.cardPreview.poster}}" initial-time="{{item.cardPreview.start}}" controls="{{false}}" show-center-play-btn object-fit="cover" data-player="{{item.previewPlayerId}}" data-start="{{item.cardPreview.start}}" data-end="{{item.cardPreview.end}}" bindplay="cardPreviewPlay" bindtimeupdate="cardPreviewTimeUpdate"></video><text class="shot-preview-badge">预览 3 秒</text><text class="shot-ratio">{{item.ratio || '9:16'}}</text></view>
            <view wx:else class="shot-media {{item.done ? 'shot-media-done' : ''}}"><text class="shot-media-label">{{item.done ? '已拍' : '分镜'}}</text><text class="shot-media-ratio">{{item.ratio || '9:16'}}</text></view>
            <view class="shoot-content"><text class="shoot-title">{{item.title}}</text><text class="shoot-context">{{item.productLabel || item.themeTitle || '拍摄素材任务'}}</text><view class="asset-field"><text class="asset-field-label">状态</text><text class="status {{item.done ? 'status-done' : ''}}">{{item.reviewLabel}}</text></view><view class="asset-field"><text class="asset-field-label">负责人</text><view class="assignee"><text class="assignee-avatar">{{item.assigneeInitial}}</text><text>{{item.assigneeLabel}}</text></view></view></view>
            <view class="card-more">•••</view>
          </view>
        </view>
      </view>

      <view wx:if="{{!visibleTaskGroups.length && !loading}}" class="empty surface">
        <view class="empty-check">✓</view>
        <view class="empty-title">没有待拍任务</view>
        <view class="muted">新的拍摄任务会由网页端或 Agent 排期生成</view>
      </view>
      <button class="refresh" loading="{{loading}}" bindtap="refresh">刷新任务</button>
    </view>

    <view wx:else class="detail-page">
      <view class="detail-header">
        <view class="back" bindtap="back">‹ 返回</view>
        <view class="detail-status {{selected.done ? 'detail-status-done' : ''}}">{{selected.done ? '✓ 已完成' : '待拍摄'}}</view>
      </view>
      <view class="surface detail-hero">
        <view class="eyebrow">{{selected.productLabel || selected.themeTitle || '拍摄任务'}}</view>
        <view class="page-title">{{selected.title}}</view>
        <view class="detail-facts">
          <view><text class="fact-label">建议时长</text><text>{{selected.durationText}}</text></view>
          <view><text class="fact-label">画面比例</text><text>{{selected.ratio || '不限'}}</text></view>
          <view><text class="fact-label">收音要求</text><text>{{selected.soundText}}</text></view>
        </view>
      </view>
      <view class="detail-columns">
        <view class="surface detail-guidance">
          <view class="section-title">画面与动作</view>
          <view class="detail-text">{{selected.shotBrief}}</view>
          <view class="guidance-divider"></view>
          <view class="section-title">声音与口播</view>
          <view class="detail-text">{{selected.soundInstructions}}</view>
          <view wx:if="{{selected.expectedNarration}}" class="narration">{{selected.expectedNarration}}</view>
        </view>
        <view class="surface reference-panel">
          <view class="section-title">对标素材再现</view>
          <block wx:if="{{referencePreview}}">
            <video id="reference-preview" class="reference-video" src="{{referencePreview.url}}" poster="{{referencePreview.poster}}" initial-time="{{referencePreview.start}}" controls object-fit="cover" show-center-play-btn bindtimeupdate="referenceTimeUpdate"></video>
            <view class="reference-range">参考区间 {{referencePreview.rangeText}}</view>
            <view class="muted">按左侧要求再现镜头语言，不复制原素材中的品牌或产品。</view>
          </block>
          <view wx:elif="{{referenceLoading}}" class="reference-empty">正在读取对标素材…</view>
          <view wx:else>
            <image src="/assets/factory-benchmark-frame.jpg" mode="aspectFill" style="display:block;width:100%;height:520rpx;border-radius:16rpx;background:#111827;" />
            <view style="margin:14rpx 0 8rpx;font-size:25rpx;font-weight:650;">工厂镜头构图参考</view>
            <view class="muted">参考人物站位、工厂环境与竖屏构图，不复制原素材中的品牌或产品。</view>
          </view>
        </view>
      </view>
      <view wx:if="{{selected.done}}" class="surface uploads">
        <view class="section-title">已上传素材</view>
        <view class="upload-row" wx:for="{{selected.uploadedMaterialIds}}" wx:key="*this">
          <view class="upload-icon">✓</view><view><view>素材 {{index + 1}}</view><view class="muted">已保存并关联任务</view></view>
        </view>
        <view class="binding">{{selected.bindingText}}</view>
      </view>
      <view wx:if="{{uploadedMaterialSummary}}" class="latest-upload">本次素材：{{uploadedMaterialSummary}}</view>
      <view wx:if="{{busy}}" class="upload-progress surface">
        <view class="progress-head"><text>{{progressStep}}</text><text>{{progress}}%</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{progress}}%"></view></view>
      </view>
      <button wx:if="{{pendingMaterialId && !busy}}" class="secondary" bindtap="retryAttach">重新关联已保存素材</button>
      <view class="detail-actions">
        <button class="secondary action-button" disabled="{{busy}}" bindtap="chooseExisting">从相册选择</button>
        <button class="primary action-button" disabled="{{busy}}" bindtap="shoot">{{selected.done ? '追加拍摄' : '打开相机'}}</button>
      </view>
    </view>
  </block>
  <view wx:if="{{message}}" class="message">{{message}}</view>
  <lingxiaoshu-sheet wx:if="{{loggedIn && !selected}}" id="lingxiaoshu-sheet"></lingxiaoshu-sheet>
  <operator-nav wx:if="{{loggedIn && !selected}}" active="shooting" bindassistant="openAssistant"></operator-nav>
</view>
