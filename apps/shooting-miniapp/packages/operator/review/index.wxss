@import "../../../styles/components.wxss";
page{height:100%;background:#f5f7fb;color:var(--ls-text)}.review-page{height:100%;box-sizing:border-box;padding:calc(24rpx + env(safe-area-inset-top)) 28rpx 0}.review-header{height:108rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx}.title{font-size:38rpx;font-weight:700}.subtitle{margin-top:6rpx;font-size:22rpx;color:var(--ls-text-secondary)}.view-switch{display:flex;padding:6rpx;border-radius:12rpx;background:#e9edf5}.switch-item{min-width:76rpx;padding:12rpx 16rpx;border-radius:10rpx;text-align:center;color:var(--ls-text-secondary);font-size:23rpx}.switch-item.selected{background:#fff;color:var(--ls-primary);font-weight:650}.queue{height:calc(100vh - 108rpx - env(safe-area-inset-top))}.film-card{overflow:hidden;margin:16rpx 0 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:16rpx;background:#fff}.queue-video{width:100%;height:390rpx;background:#0a0b0e}.film-info{padding:24rpx}.film-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.film-title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:30rpx;font-weight:650}.badge{flex:none;padding:7rpx 14rpx;border-radius:999rpx;background:#fff3dd;color:#a55a00;font-size:21rpx}.badge.approved{background:#e8f8f1;color:#087a58}.film-subject{margin-top:12rpx;color:var(--ls-text-secondary);font-size:24rpx}.film-time{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:21rpx}.empty{padding:24vh 20rpx;text-align:center;color:var(--ls-text-secondary)}.empty-mark{margin:auto auto 24rpx;width:80rpx;height:80rpx;border-radius:50%;background:#e8f8f1;color:#087a58;font-size:48rpx;line-height:80rpx}.empty-title{margin-bottom:10rpx;color:var(--ls-text);font-size:30rpx;font-weight:650}.error{margin:40rpx 0;padding:24rpx;border-radius:20rpx;background:var(--ls-warning-bg);color:var(--ls-warning);text-align:center}.error button{margin-top:18rpx}.queue-bottom{height:170rpx}.feed-page{padding-left:0;padding-right:0;background:#000}.feed-page .review-header{position:absolute;z-index:12;top:env(safe-area-inset-top);left:24rpx;right:24rpx;color:#fff}.feed-page .subtitle{color:rgba(255,255,255,.72)}.feed-page .view-switch{background:rgba(15,15,18,.58);backdrop-filter:blur(16rpx)}.feed-page .switch-item{color:rgba(255,255,255,.72)}.feed-page .switch-item.selected{background:#fff;color:#111}.feed{height:calc(100vh - 124rpx - env(safe-area-inset-bottom));background:#000}.feed-item,.feed-video{width:100%;height:100%}.feed-item{position:relative}.feed-gradient{position:absolute;inset:auto 0 0;height:42%;background:linear-gradient(transparent,rgba(0,0,0,.78));pointer-events:none}.feed-copy{position:absolute;z-index:3;left:28rpx;right:28rpx;bottom:42rpx;color:#fff}.feed-title{font-size:34rpx;font-weight:700}.feed-subject{margin-top:12rpx;font-size:25rpx}.feed-meta{margin-top:10rpx;color:rgba(255,255,255,.72);font-size:22rpx}.feed-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.78)}
