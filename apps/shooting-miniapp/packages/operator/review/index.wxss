@import "../../../styles/components.wxss";
page{height:100%;background:#fff;color:var(--ls-text)}.review-page{height:100%;box-sizing:border-box;padding:calc(24rpx + env(safe-area-inset-top)) 28rpx 0}.review-header{height:112rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx}.heading{min-width:0}.title{font-size:38rpx;font-weight:700}.subtitle{margin-top:6rpx;font-size:24rpx;color:var(--ls-text-secondary)}.view-switch{display:flex;flex:none;padding:4rpx;border:1rpx solid var(--ls-border-secondary);border-radius:12rpx;background:var(--ls-fill)}.switch-item{min-width:88rpx;min-height:88rpx;padding:0 14rpx;border-radius:10rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;text-align:center;color:var(--ls-text-secondary);font-size:24rpx}.switch-item.selected{background:#fff;color:var(--ls-text);font-weight:650}.queue{height:calc(100vh - 112rpx - env(safe-area-inset-top))}.film-card{overflow:hidden;margin:16rpx 0 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:16rpx;background:#fff}.media-frame{position:relative;width:100%;height:0;padding-bottom:56.25%;overflow:hidden;background:var(--ls-fill)}.queue-video{position:absolute;inset:0;width:100%;height:100%;background:#111}.film-info{padding:24rpx}.film-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.film-title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:30rpx;font-weight:650}.badge{flex:none;padding:7rpx 14rpx;border-radius:999rpx;background:var(--ls-warning-bg);color:var(--ls-warning);font-size:22rpx}.badge.approved{background:var(--ls-success-bg);color:var(--ls-success)}.film-subject{margin-top:12rpx;color:var(--ls-text-secondary);font-size:24rpx}.film-time{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:22rpx}.empty{padding:24vh 20rpx;text-align:center;color:var(--ls-text-secondary);font-size:24rpx}.empty-title{margin-bottom:10rpx;color:var(--ls-text);font-size:30rpx;font-weight:650}.error{margin:40rpx 0;padding:24rpx;border:1rpx solid var(--ls-warning);border-radius:16rpx;background:var(--ls-warning-bg);color:var(--ls-warning);text-align:left;font-size:24rpx}.error button{min-height:88rpx;margin-top:18rpx;border:1rpx solid currentColor;border-radius:12rpx;background:transparent;color:inherit;font-size:24rpx}.error button::after{border:0}.queue-bottom{height:170rpx}.feed-page{padding:0;background:#000}.feed{height:100vh;background:#000}.feed-item,.feed-video{width:100%;height:100%}.feed-item{position:relative}.feed-gradient{position:absolute;inset:auto 0 0;height:42%;background:linear-gradient(transparent,rgba(0,0,0,.78));pointer-events:none}.feed-copy{position:absolute;z-index:3;left:32rpx;right:32rpx;bottom:calc(42rpx + env(safe-area-inset-bottom));color:#fff}.feed-title{font-size:36rpx;font-weight:700}.feed-subject{margin-top:12rpx;font-size:25rpx;line-height:38rpx}.feed-meta{margin-top:10rpx;color:rgba(255,255,255,.72);font-size:22rpx}.feed-back{position:absolute;z-index:20;top:calc(22rpx + env(safe-area-inset-top));left:24rpx;width:72rpx;height:72rpx;border-radius:50%;background:rgba(0,0,0,.4);color:#fff;font-size:56rpx;line-height:64rpx;text-align:center}.feed-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.78)}
