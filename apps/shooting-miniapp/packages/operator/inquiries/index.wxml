<view class="page">
  <view class="summary">
    <view><text class="page-kicker">客户会话</text><text class="page-note">集中处理回复、跟进和高意向客户</text></view>
    <view class="total">{{customers.length}}<text>个会话</text></view>
  </view>
  <view class="search-row">
    <view class="search"><text class="search-icon">⌕</text><input placeholder="搜索客户或消息" value="{{query}}" bindinput="inputQuery"/></view>
    <button class="filter-button {{filterOpen ? 'selected' : ''}}" bindtap="toggleFilters" aria-label="渠道筛选">≡</button>
  </view>
  <scroll-view scroll-x class="quick-scroll" show-scrollbar="false"><view class="quick-filters"><view class="chip {{active === 'all' && !unreadOnly ? 'selected' : ''}}" data-tab="all" bindtap="switchTab">全部</view><view class="chip {{unreadOnly ? 'selected' : ''}}" bindtap="toggleUnread">未读 {{counts.unread}}</view><view class="chip {{active === 'confirm' && !unreadOnly ? 'selected' : ''}}" data-tab="confirm" bindtap="switchTab">待回复 {{counts.confirm}}</view><view class="chip {{active === 'followup' && !unreadOnly ? 'selected' : ''}}" data-tab="followup" bindtap="switchTab">待跟进 {{counts.followup}}</view></view></scroll-view>
  <view class="filter-panel" wx:if="{{filterOpen}}">
    <view class="filter-title">渠道</view><view class="chips"><view class="chip {{channel === '' ? 'selected' : ''}}" data-channel="" bindtap="setChannel">全部渠道</view><view class="chip {{channel === 'Messenger' ? 'selected' : ''}}" data-channel="Messenger" bindtap="setChannel">Messenger</view><view class="chip {{channel === 'Instagram' ? 'selected' : ''}}" data-channel="Instagram" bindtap="setChannel">Instagram</view><view class="chip {{channel === 'WhatsApp' ? 'selected' : ''}}" data-channel="WhatsApp" bindtap="setChannel">WhatsApp</view></view>
  </view>
  <view class="state" wx:if="{{loading}}">正在同步客户会话…</view>
  <view class="state error" wx:elif="{{error}}"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
  <view class="conversation-list" wx:elif="{{visible.length}}">
    <view class="conversation-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="openConversation">
      <view class="avatar">{{item.initial}}</view>
      <view class="conversation-main"><view class="conversation-head"><text class="name">{{item.name}}</text><text class="time {{item.unread ? 'unread-time' : ''}}">{{item.timeLabel}}</text></view><view class="preview {{item.unread ? 'unread-preview' : ''}}">{{item.preview}}</view><view class="metadata"><text class="channel">{{item.channel}}</text><text wx:for="{{item.labels}}" wx:key="*this" class="customer-label">{{item}}</text></view></view>
      <text wx:if="{{item.unread}}" class="unread-count">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</text>
    </view>
  </view>
  <view class="empty" wx:else><view class="empty-mark">✓</view><view class="section-title">这一栏已经处理完了</view><view class="muted">新询盘到达后会显示在这里</view></view>
</view>
