.page{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box}.summary{display:flex;justify-content:flex-end;padding:0 4rpx 18rpx}.muted{color:var(--ls-text-secondary);font-size:26rpx}.total{font-size:40rpx;font-weight:700;text-align:right}.total text{display:block;font-size:22rpx;color:var(--ls-text-secondary);font-weight:400}.segmented{display:flex;background:var(--ls-fill);border-radius:20rpx;padding:8rpx;margin-bottom:20rpx}.segment{flex:1;text-align:center;padding:18rpx;border-radius:16rpx;color:var(--ls-text-secondary);font-weight:600}.segment.active{background:#fff;color:var(--ls-text);box-shadow:0 4rpx 16rpx rgba(22,34,58,.08)}.search-row{display:flex;gap:14rpx}.search{height:88rpx;flex:1;background:#fff;border:1rpx solid var(--ls-border-secondary);border-radius:20rpx;display:flex;align-items:center;padding:0 22rpx}.search input{flex:1}.search-icon{font-size:40rpx;color:var(--ls-text-tertiary);margin-right:12rpx}.filter-button{width:132rpx;padding:0}.filter-button.selected,.chip.selected{color:var(--ls-primary);background:var(--ls-info-bg);border-color:var(--ls-primary)}.filter-panel{background:#fff;padding:24rpx;margin-top:14rpx;border-radius:20rpx}.filter-title{font-weight:600;margin-bottom:18rpx}.chips{display:flex;gap:12rpx;flex-wrap:wrap}.chip{border:1rpx solid var(--ls-border);border-radius:999rpx;padding:12rpx 20rpx;color:var(--ls-text-secondary);font-size:24rpx}.conversation-list{margin-top:20rpx}.conversation-card{display:flex;align-items:center;background:#fff;border:1rpx solid var(--ls-border-secondary);border-radius:24rpx;padding:26rpx 22rpx;margin-bottom:16rpx}.avatar{width:88rpx;height:88rpx;border-radius:28rpx;background:var(--ls-primary-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;position:relative}.unread-dot{position:absolute;right:-3rpx;top:-3rpx;width:18rpx;height:18rpx;background:var(--ls-error);border:5rpx solid #fff;border-radius:50%}.conversation-main{flex:1;min-width:0;margin-left:20rpx}.conversation-head{display:flex;justify-content:space-between;align-items:center}.name{font-size:30rpx;font-weight:650}.time{font-size:22rpx;color:var(--ls-text-tertiary)}.preview{color:var(--ls-text-secondary);font-size:26rpx;margin:10rpx 0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.metadata{display:flex;gap:12rpx;align-items:center;font-size:21rpx;color:var(--ls-text-tertiary)}.channel,.status{padding:5rpx 10rpx;border-radius:8rpx;background:var(--ls-fill);color:var(--ls-text-secondary)}.status{color:var(--ls-primary);background:var(--ls-info-bg)}.chevron{font-size:40rpx;color:var(--ls-text-tertiary);padding-left:12rpx}.state,.empty{text-align:center;padding:100rpx 30rpx;color:var(--ls-text-secondary)}.state button{margin-top:24rpx}.empty-mark{width:92rpx;height:92rpx;border-radius:30rpx;background:var(--ls-success-bg);color:var(--ls-success);display:flex;align-items:center;justify-content:center;font-size:48rpx;margin:0 auto 24rpx}.empty .section-title{margin-bottom:10rpx}
