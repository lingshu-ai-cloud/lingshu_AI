.page{min-height:100vh;padding:28rpx 24rpx calc(224rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;color:var(--ls-text)}
.page-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:24rpx}.page-head>view{min-width:0;flex:1}.page-title,.page-note{display:block}.page-title{font-size:40rpx;line-height:56rpx;font-weight:650}.page-note{margin-top:2rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:34rpx}.add-button{width:88rpx;min-width:88rpx;max-width:88rpx;height:88rpx;min-height:88rpx;max-height:88rpx;flex:0 0 88rpx;margin:0;padding:0!important;border:0;border-radius:22rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;background:var(--ls-action-gradient);color:#fff;font-size:42rpx;font-weight:300;line-height:1}.add-button::after{border:0}
.notice,.progress-card,.empty{margin-bottom:20rpx;padding:22rpx 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);font-size:24rpx}.notice.success{border-color:var(--ls-success);background:var(--ls-success-bg);color:var(--ls-success)}.notice.error{border-color:var(--ls-error);background:var(--ls-error-bg);color:var(--ls-error)}.progress-copy{display:flex;justify-content:space-between;color:var(--ls-text-secondary);font-size:23rpx}.progress-track{height:8rpx;margin-top:14rpx;overflow:hidden;border-radius:4rpx;background:var(--ls-border-secondary)}.progress-fill{height:100%;background:var(--ls-progress-gradient)}
.search{height:82rpx;padding:0 20rpx;display:flex;align-items:center;gap:12rpx;border-radius:18rpx;box-sizing:border-box;background:var(--ls-fill);font-size:25rpx}.search-icon{color:var(--ls-text-tertiary);font-size:34rpx}.search input{min-width:0;flex:1}.library-tools{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}.library-tool{min-height:104rpx;padding:16rpx 18rpx;display:flex;align-items:center;gap:14rpx;border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;background:#fff;box-sizing:border-box}.library-tool.active{border-color:var(--ls-primary);background:var(--ls-selected)}.tool-icon{width:48rpx;height:48rpx;flex:none;display:flex;align-items:center;justify-content:center;color:var(--ls-primary);font-size:29rpx}.tool-label,.tool-count{display:block}.tool-label{font-size:24rpx;font-weight:600}.tool-count{margin-top:2rpx;color:var(--ls-text-tertiary);font-size:19rpx}.tool-ready{color:var(--ls-success)}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:34rpx 0 16rpx}.section-title{font-size:30rpx;font-weight:650}.section-count{color:var(--ls-primary);font-size:22rpx}.folder-scroll{width:calc(100% + 24rpx);margin-right:-24rpx;white-space:nowrap}.folder-row{display:inline-flex;gap:16rpx;padding-right:24rpx}.folder{width:210rpx;display:inline-flex;flex-direction:column;vertical-align:top;white-space:normal}.folder-cover{display:block;width:210rpx;height:150rpx;border-radius:18rpx;background:var(--ls-fill)}.folder.active .folder-cover{box-shadow:inset 0 0 0 4rpx var(--ls-primary)}.folder-empty{display:flex;align-items:center;justify-content:center;color:var(--ls-text-tertiary);font-size:22rpx}.folder-name{margin-top:10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24rpx;font-weight:600}.folder-count{margin-top:2rpx;color:var(--ls-text-tertiary);font-size:20rpx}.material-grid{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.material-card{position:relative;min-width:0;overflow:hidden;background:#fff}.material-media{display:block;width:100%;height:250rpx;border-radius:14rpx;background:var(--ls-fill)}.material-empty{display:flex;align-items:center;justify-content:center;color:var(--ls-text-tertiary);font-size:24rpx}.media-overlay{position:absolute;top:10rpx;left:10rpx;right:10rpx;display:flex;align-items:center;justify-content:space-between}.media-type{padding:4rpx 9rpx;border-radius:7rpx;background:rgba(15,23,42,.72);color:#fff;font-size:17rpx}.analysis-dot{width:14rpx;height:14rpx;border:3rpx solid #fff;border-radius:50%;background:var(--ls-text-tertiary)}.analysis-dot.ready{background:var(--ls-success)}.analysis-dot.running{background:var(--ls-primary)}.analysis-dot.warning{background:var(--ls-warning)}.material-body{padding:12rpx 4rpx 18rpx}.material-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24rpx;font-weight:600}.material-product{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:4rpx;color:var(--ls-text-secondary);font-size:20rpx}.analysis{display:block;margin-top:5rpx;font-size:19rpx}.analysis.ready{color:var(--ls-success)}.analysis.running{color:var(--ls-primary)}.analysis.warning{color:var(--ls-warning)}
.analysis.pending{color:var(--ls-text-tertiary)}.empty{display:flex;min-height:200rpx;flex-direction:column;align-items:center;justify-content:center;text-align:center}.empty-title{font-size:27rpx;font-weight:600}.empty-note{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:22rpx}.refresh{min-height:80rpx;margin-top:22rpx;background:transparent;color:var(--ls-text-secondary);font-size:23rpx}.refresh::after{border:0}
