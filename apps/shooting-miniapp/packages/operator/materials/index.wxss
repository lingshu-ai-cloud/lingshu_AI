.page{min-height:100vh;padding:32rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;color:var(--ls-text)}
.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;margin-bottom:28rpx}.eyebrow,.page-title,.page-note{display:block}.eyebrow{color:var(--ls-primary);font-size:22rpx;font-weight:600}.page-title{margin-top:4rpx;font-size:40rpx;line-height:56rpx;font-weight:600}.page-note{margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:34rpx}.upload-button{flex:none;width:196rpx;min-height:80rpx;margin:0;padding:16rpx 20rpx}
.notice,.progress-card,.empty{margin-bottom:20rpx;padding:22rpx 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);font-size:24rpx}.notice.success{border-color:var(--ls-success);background:var(--ls-success-bg);color:var(--ls-success)}.notice.error{border-color:var(--ls-error);background:var(--ls-error-bg);color:var(--ls-error)}.progress-copy{display:flex;justify-content:space-between;color:var(--ls-text-secondary);font-size:23rpx}.progress-track{height:8rpx;margin-top:14rpx;overflow:hidden;border-radius:4rpx;background:var(--ls-border-secondary)}.progress-fill{height:100%;background:var(--ls-progress-gradient)}
.organizer{padding:20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel)}.search{height:76rpx;padding:0 20rpx;border:1rpx solid var(--ls-border);border-radius:var(--ls-radius-control);box-sizing:border-box;background:#fff;font-size:25rpx}.filters{display:flex;gap:12rpx;margin-top:16rpx}.filter{min-height:60rpx;padding:0 20rpx;border-radius:999rpx;background:var(--ls-fill);color:var(--ls-text-secondary);font-size:22rpx;line-height:60rpx}.filter.active{background:var(--ls-info-bg);color:var(--ls-primary);font-weight:600}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 18rpx}.section-title{font-size:30rpx;font-weight:600}.section-count{color:var(--ls-text-tertiary);font-size:23rpx}.material-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.material-card{min-width:0;overflow:hidden;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff}.material-media{display:block;width:100%;height:228rpx;background:var(--ls-fill)}.material-empty{display:flex;align-items:center;justify-content:center;color:var(--ls-text-tertiary);font-size:24rpx}.material-body{padding:18rpx}.material-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:25rpx;font-weight:600}.material-product{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:6rpx;color:var(--ls-text-secondary);font-size:21rpx}.material-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:12rpx}.tag{padding:3rpx 10rpx;border-radius:999rpx;background:var(--ls-info-bg);color:var(--ls-primary);font-size:19rpx;line-height:28rpx}.tag.neutral{background:var(--ls-fill);color:var(--ls-text-secondary)}.analysis{display:block;margin-top:12rpx;font-size:20rpx}.analysis.ready{color:var(--ls-success)}.analysis.running{color:var(--ls-primary)}.analysis.warning{color:var(--ls-warning)}
.analysis.pending{color:var(--ls-text-tertiary)}.empty{display:flex;min-height:200rpx;flex-direction:column;align-items:center;justify-content:center;text-align:center}.empty-title{font-size:27rpx;font-weight:600}.empty-note{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:22rpx}.refresh{min-height:80rpx;margin-top:22rpx;background:transparent;color:var(--ls-text-secondary);font-size:23rpx}.refresh::after{border:0}
