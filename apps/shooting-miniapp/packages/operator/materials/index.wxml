<view class="page">
  <view class="page-head">
    <view>
      <text class="eyebrow">企业素材库</text>
      <text class="page-title">素材上传与整理</text>
      <text class="page-note">上传后自动识别产品、场景与镜头用途</text>
    </view>
    <button class="primary upload-button" loading="{{busy}}" disabled="{{busy}}" bindtap="chooseMaterial">上传素材</button>
  </view>

  <view wx:if="{{message}}" class="notice {{messageType}}">{{message}}</view>
  <view wx:if="{{busy}}" class="progress-card">
    <view class="progress-copy"><text>{{progressStep}}</text><text>{{progress}}%</text></view>
    <view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"></view></view>
  </view>

  <view class="organizer">
    <input class="search" type="text" value="{{query}}" placeholder="搜索素材、产品或标签" bindinput="search" confirm-type="search" />
    <view class="filters" aria-label="素材类型筛选">
      <view wx:for="{{filters}}" wx:key="key" class="filter {{filter === item.key ? 'active' : ''}}" data-filter="{{item.key}}" bindtap="selectFilter">{{item.label}} {{item.count}}</view>
    </view>
  </view>

  <view class="section-head"><text class="section-title">我的素材</text><text class="section-count">{{visibleMaterials.length}} 项</text></view>
  <view wx:if="{{loading && !loaded}}" class="empty">正在读取素材库…</view>
  <view wx:elif="{{!visibleMaterials.length}}" class="empty">
    <text class="empty-title">还没有符合条件的素材</text>
    <text class="empty-note">上传产品图、工厂图或视频，系统会自动整理。</text>
  </view>
  <view wx:else class="material-grid">
    <view wx:for="{{visibleMaterials}}" wx:key="id" class="material-card">
      <video wx:if="{{item.type === 'video' && item.url}}" class="material-media" src="{{item.url}}" poster="{{item.poster}}" controls="{{false}}" show-center-play-btn object-fit="cover"></video>
      <image wx:elif="{{item.url}}" class="material-media" src="{{item.url}}" mode="aspectFill"></image>
      <view wx:else class="material-media material-empty">{{item.typeLabel}}</view>
      <view class="material-body">
        <text class="material-name">{{item.name}}</text>
        <text wx:if="{{item.productName}}" class="material-product">{{item.productName}}</text>
        <view class="material-tags"><text class="tag">{{item.typeLabel}}</text><text wx:for="{{item.tags}}" wx:key="*this" class="tag neutral">{{item}}</text></view>
        <text class="analysis {{item.analysisTone}}">{{item.analysisLabel}}</text>
      </view>
    </view>
  </view>
  <button class="refresh" loading="{{loading}}" bindtap="refresh">刷新素材</button>
  <operator-nav active="materials"></operator-nav>
</view>
