.conversation-page{height:100vh;display:flex;flex-direction:column;background:#f3f6fa;box-sizing:border-box}.nav{padding:calc(env(safe-area-inset-top) + 14rpx) 24rpx 16rpx;display:flex;align-items:center;background:rgba(255,255,255,.96);border-bottom:1rpx solid var(--ls-border-secondary)}.back,.more{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;font-size:48rpx}.more{font-size:26rpx}.identity{flex:1;display:flex;align-items:center;justify-content:center}.mini-avatar{width:62rpx;height:62rpx;border-radius:20rpx;background:var(--ls-primary-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;margin-right:14rpx}.nav-name{font-size:29rpx;font-weight:650}.nav-meta{font-size:21rpx;color:var(--ls-text-secondary);margin-top:3rpx}.online{display:inline-block;width:10rpx;height:10rpx;border-radius:50%;background:var(--ls-success);margin-right:8rpx}.messages{flex:1;min-height:0;padding:20rpx 28rpx;box-sizing:border-box}.date-divider{text-align:center;color:var(--ls-text-tertiary);font-size:21rpx;margin:12rpx 0 28rpx}.message-row{display:flex;margin-bottom:24rpx;padding-right:90rpx}.message-row.mine{justify-content:flex-end;padding-right:0;padding-left:90rpx}.bubble{background:#fff;border-radius:8rpx 24rpx 24rpx 24rpx;padding:20rpx 22rpx;line-height:1.55;box-shadow:0 2rpx 8rpx rgba(30,43,64,.04)}.mine .bubble{background:var(--ls-primary);color:#fff;border-radius:24rpx 8rpx 24rpx 24rpx}.bubble-time{font-size:20rpx;color:var(--ls-text-tertiary);margin-top:10rpx}.mine .bubble-time{color:rgba(255,255,255,.72);text-align:right}.scroll-tail{height:20rpx}.composer{display:flex;align-items:flex-end;gap:14rpx;padding:18rpx 22rpx;background:#fff;border-top:1rpx solid var(--ls-border-secondary)}.plus{width:68rpx;height:68rpx;border-radius:22rpx;background:var(--ls-fill);display:flex;align-items:center;justify-content:center;font-size:42rpx;color:var(--ls-text-secondary);flex:none}.plus.active{background:var(--ls-info-bg);color:var(--ls-primary)}.composer textarea{flex:1;min-height:44rpx;max-height:180rpx;background:var(--ls-fill);border-radius:22rpx;padding:17rpx 20rpx;box-sizing:border-box}.send{min-height:68rpx;height:68rpx;padding:0 20rpx;border:0;background:var(--ls-fill);color:var(--ls-text-tertiary)}.send.ready{background:var(--ls-primary);color:#fff}.plus-menu{background:#fff;border-top:1rpx solid var(--ls-border-secondary);padding:28rpx}.plus-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx}.plus-item{text-align:center;font-size:22rpx;color:var(--ls-text-secondary)}.plus-icon{width:82rpx;height:82rpx;border-radius:24rpx;background:var(--ls-info-bg);color:var(--ls-primary);display:flex;align-items:center;justify-content:center;margin:0 auto 12rpx;font-size:30rpx;font-weight:650}.plus-icon.violet{background:#f2edff;color:#7457d5}.plus-icon.green{background:var(--ls-success-bg);color:var(--ls-success)}.plus-icon.orange{background:var(--ls-warning-bg);color:var(--ls-warning)}.sheet-mask{position:fixed;inset:0;background:rgba(15,23,42,.34);z-index:20}.detail-sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;background:#fff;border-radius:34rpx 34rpx 0 0;padding:12rpx 28rpx calc(env(safe-area-inset-bottom) + 32rpx);max-height:72vh;overflow:auto}.sheet-handle{width:72rpx;height:8rpx;border-radius:9rpx;background:var(--ls-border);margin:0 auto 18rpx}.sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:700;padding-bottom:26rpx}.sheet-close{font-size:42rpx;color:var(--ls-text-secondary);padding:8rpx 16rpx}.profile-hero{display:flex;align-items:center;padding:10rpx 0 28rpx}.profile-avatar{width:96rpx;height:96rpx;border-radius:30rpx;background:var(--ls-primary-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:700;margin-right:20rpx}.profile-name{font-size:32rpx;font-weight:650}.info-row{display:flex;justify-content:space-between;padding:22rpx 0;border-top:1rpx solid var(--ls-border-secondary)}.info-row text:first-child{color:var(--ls-text-secondary)}.tag-row{display:flex;gap:10rpx;flex-wrap:wrap}.tag-row text{background:var(--ls-fill);padding:8rpx 14rpx;border-radius:10rpx;font-size:22rpx}.helper{padding:18rpx 20rpx;background:var(--ls-fill);border-radius:16rpx;color:var(--ls-text-secondary);font-size:24rpx;margin-bottom:18rpx}.reply-card{border:1rpx solid var(--ls-border);border-radius:20rpx;padding:22rpx;margin-bottom:14rpx;line-height:1.5}.reply-label{display:block;color:var(--ls-primary);font-size:22rpx;font-weight:650;margin-bottom:8rpx}.full{width:100%;margin-top:18rpx}.media-action{display:flex;align-items:center;border:1rpx solid var(--ls-border);padding:24rpx;border-radius:20rpx;margin-bottom:20rpx}.media-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:var(--ls-info-bg);color:var(--ls-primary);font-size:40rpx;display:flex;align-items:center;justify-content:center;margin-right:18rpx}.panel-search{display:flex;align-items:center;background:var(--ls-fill);padding:18rpx;border-radius:18rpx}.panel-search input{flex:1;margin-left:12rpx}.search-result{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 4rpx;border-bottom:1rpx solid var(--ls-border-secondary)}.search-result text:first-child{flex:1}.state,.empty-chat{text-align:center;padding:120rpx 30rpx;color:var(--ls-text-secondary)}
