<view class="conversation-page" style="padding-bottom:{{safeBottom}}px"><view class="nav" style="padding-top:{{statusBarHeight}}px;padding-left:12rpx"><view class="back" style="width:58rpx;justify-content:center;padding-right:0;margin-right:4rpx;color:#1f2937" bindtap="back" aria-label="返回会话列表"><text class="back-arrow" style="font-size:58rpx;font-weight:300;line-height:1">‹</text></view><view class="identity" wx:if="{{customer}}" bindtap="openProfile"><view class="mini-avatar">{{customer.initial}}</view><view class="identity-copy"><view class="nav-name">{{customer.name}}</view><view class="nav-meta"><text class="online"></text>{{customer.channel}} · {{customer.statusLabel}}</view></view><text class="identity-arrow">›</text></view><view class="nav-spacer"></view></view><view class="state" wx:if="{{loading}}">正在载入会话…</view><view class="state error" wx:elif="{{error}}">{{error}}</view><scroll-view class="messages" scroll-y wx:else scroll-into-view="{{scrollTo}}" enhanced show-scrollbar="{{false}}"><view class="date-divider">最近会话</view><view id="message-{{index}}" class="message-row {{item.mine ? 'mine' : 'theirs'}}" wx:for="{{messages}}" wx:key="id"><view class="message-stack"><view class="bubble"><text selectable>{{item.body}}</text></view><view class="message-note" wx:if="{{item.note}}">译文·{{item.note}}</view><view class="bubble-time">{{item.time}}{{item.mine ? ' · 已送达' : ''}}</view></view></view><view class="empty-chat" wx:if="{{!messages.length}}">还没有消息记录</view><view class="scroll-tail"></view></scroll-view><view class="plus-menu" wx:if="{{plusOpen}}"><view class="plus-grid"><view class="plus-item" data-panel="reply" bindtap="openPanel"><view class="plus-icon violet">AI</view><text>AI 推荐回复</text></view><view class="plus-item" data-panel="quote" bindtap="openPanel"><view class="plus-icon green">价</view><text>智能报价</text></view><view class="plus-item" data-panel="search" bindtap="openPanel"><view class="plus-icon orange">搜</view><text>会话搜索</text></view><view class="plus-item" bindtap="openProfile"><view class="plus-icon">…</view><text>更多</text></view></view></view><view class="composer"><view class="translation-preview" wx:if="{{translating || translatedDraft}}"><text class="translation-label">{{translating ? '正在自动翻译…' : '将发送·' + targetLanguage}}</text><text wx:if="{{translatedDraft}}">{{translatedDraft}}</text></view><view class="composer-row"><view class="plus {{plusOpen ? 'active' : ''}}" bindtap="togglePlus">{{plusOpen ? '×' : '+'}}</view><view class="input-shell"><textarea auto-height maxlength="2000" confirm-type="send" placeholder="输入中文，自动翻译后发送" value="{{draft}}" bindinput="inputDraft" bindconfirm="send"></textarea></view><view class="send {{draft && !sending && !translating ? 'ready' : ''}}" role="button" aria-label="发送消息" bindtap="send"><text>{{sending ? '…' : '↑'}}</text></view></view></view></view><view class="sheet-mask" wx:if="{{panel}}" bindtap="closePanel"></view><view class="detail-sheet" wx:if="{{panel}}"><view class="sheet-handle"></view><view class="sheet-head"><text>{{panelTitle}}</text><text class="sheet-close" bindtap="closePanel">×</text></view><view wx:if="{{panel === 'profile' && customer}}" class="profile"><view class="profile-hero"><view class="profile-avatar">{{customer.initial}}</view><view><view class="profile-name">{{customer.name}}</view><view class="muted">{{customer.channel}}</view></view></view><view class="info-row"><text>客户阶段</text><text>{{customer.stage || '待识别'}}</text></view><view class="info-row"><text>国家或地区</text><text>{{customer.country || '待补充'}}</text></view><view class="info-row"><text>沟通语言</text><text>{{customer.language || '待识别'}}</text></view><view class="tag-row"><text wx:for="{{customer.tags}}" wx:key="*this">{{item}}</text></view></view><view wx:elif="{{panel === 'reply'}}" class="reply-panel"><view class="reply-loading" wx:if="{{recommending}}">正在生成两个回复版本和中文释义…</view><view class="reply-card" wx:for="{{recommendations}}" wx:key="body" data-index="{{index}}" bindtap="useReply"><text class="reply-label">AI 推荐 {{index + 1}}</text><text class="reply-body">{{item.body}}</text><text class="reply-translation" wx:if="{{item.translation}}">中文释义：{{item.translation}}</text></view><button class="secondary full" bindtap="loadRecommendations" disabled="{{recommending}}">换一批回复</button></view><view wx:elif="{{panel === 'quote'}}" class="quote-panel"><view class="reply-loading" wx:if="{{quoteLoading}}">正在同步完整报价数据…</view><view class="quote-error" wx:if="{{quoteError}}">{{quoteError}}</view><block wx:if="{{quoteDraft}}"><view class="quote-status"><text>{{quoteDraft.delivery.status === 'sent' ? '已发送' : quoteDraft.status === 'ready_for_review' ? '待人工确认' : quoteDraft.status === 'confirmed' ? '已确认' : '待补充信息'}}</text><text>{{quoteDraft.quoteNumber}} · V{{quoteDraft.version}}</text></view><view class="quote-main"><view class="quote-product">{{quoteDraft.productName || '待识别产品'}}</view><view class="quote-price" wx:if="{{quoteDraft.subtotal}}">{{quoteDraft.currency}} {{quoteDraft.subtotal}}<text>总额</text></view><view class="quote-price pending" wx:else>{{quoteDraft.unitPrice ? quoteDraft.currency + ' ' + quoteDraft.unitPrice + '/' + quoteDraft.unit : '价格待确认'}}</view></view><view class="quote-grid"><view><text>数量</text><text class="quote-value">{{quoteDraft.quantity ? quoteDraft.quantity + ' ' + quoteDraft.unit : '待补充'}}</text></view><view><text>贸易条款</text><text class="quote-value">{{quoteDraft.incoterm || '待补充'}}</text></view><view><text>目的地</text><text class="quote-value">{{quoteDraft.destination || '待补充'}}</text></view><view><text>有效期</text><text class="quote-value">{{quoteDraft.validityDays}} 天</text></view></view><view class="quote-missing" wx:if="{{quoteDraft.missingFields.length || quoteDraft.blockers.length}}"><text class="quote-section-title">还需确认</text><text wx:for="{{quoteDraft.missingFields}}" wx:key="*this">• 缺少：{{item}}</text><text wx:for="{{quoteDraft.blockers}}" wx:key="*this">• {{item}}</text></view><view class="quote-actions" wx:if="{{!quoteEditing}}"><button class="quote-small" bindtap="toggleQuoteEdit" wx:if="{{quoteDraft.status !== 'confirmed'}}">编辑报价</button><button class="quote-small" bindtap="insertQuoteQuestions" wx:if="{{quoteDraft.clarificationQuestions.length && quoteDraft.status !== 'confirmed'}}">插入澄清问题</button><button class="quote-small primary" bindtap="confirmQuote" wx:if="{{quoteDraft.status === 'ready_for_review'}}">人工确认</button><button class="quote-small" bindtap="previewQuote">预览卡片</button><button class="quote-small" bindtap="insertQuoteReply" wx:if="{{quoteDraft.status === 'confirmed'}}">插入报价回复</button><button class="quote-small primary" bindtap="sendQuoteCard" disabled="{{quoteSending}}" wx:if="{{quoteDraft.status === 'confirmed' && !quoteDraft.delivery}}">{{quoteSending ? '发送中…' : '发送报价卡'}}</button><button class="quote-small" data-clone="true" bindtap="regenerateQuote" wx:if="{{quoteDraft.status === 'confirmed'}}">新建版本</button></view><view class="quote-edit" wx:else><picker mode="selector" range="{{quoteCatalog}}" range-key="name" bindchange="selectQuoteCatalog"><view class="quote-catalog">从企业产品目录选择 ›</view></picker><view class="quote-field"><text>产品名称</text><input value="{{quoteForm.productName}}" data-field="productName" bindinput="inputQuoteField"/></view><view class="quote-field-row"><view class="quote-field"><text>SKU</text><input value="{{quoteForm.sku}}" data-field="sku" bindinput="inputQuoteField"/></view><view class="quote-field"><text>材料/规格</text><input value="{{quoteForm.material}}" data-field="material" bindinput="inputQuoteField"/></view></view><view class="quote-field-row"><view class="quote-field"><text>数量</text><input type="digit" value="{{quoteForm.quantity}}" data-field="quantity" bindinput="inputQuoteField"/></view><view class="quote-field"><text>单位</text><input value="{{quoteForm.unit}}" data-field="unit" bindinput="inputQuoteField"/></view></view><view class="quote-field-row"><view class="quote-field"><text>币种</text><input value="{{quoteForm.currency}}" data-field="currency" bindinput="inputQuoteField"/></view><view class="quote-field"><text>单价</text><input type="digit" value="{{quoteForm.unitPrice}}" data-field="unitPrice" bindinput="inputQuoteField"/></view></view><view class="quote-field-row"><view class="quote-field"><text>贸易条款</text><input value="{{quoteForm.incoterm}}" data-field="incoterm" bindinput="inputQuoteField"/></view><view class="quote-field"><text>目的地</text><input value="{{quoteForm.destination}}" data-field="destination" bindinput="inputQuoteField"/></view></view><view class="quote-field-row"><view class="quote-field"><text>交期</text><input value="{{quoteForm.leadTime}}" data-field="leadTime" bindinput="inputQuoteField"/></view><view class="quote-field"><text>有效期（天）</text><input type="number" value="{{quoteForm.validityDays}}" data-field="validityDays" bindinput="inputQuoteField"/></view></view><view class="quote-field"><text>付款条款</text><input value="{{quoteForm.paymentTerms}}" data-field="paymentTerms" bindinput="inputQuoteField"/></view><view class="quote-field"><text>包装要求</text><input value="{{quoteForm.packaging}}" data-field="packaging" bindinput="inputQuoteField"/></view><view class="quote-actions"><button class="quote-small" bindtap="toggleQuoteEdit">取消</button><button class="quote-small primary" bindtap="saveQuote">保存报价</button></view></view><view class="quote-preview" wx:if="{{quotePreview}}"><image src="{{quotePreview}}" mode="widthFix"/><view class="quote-preview-actions"><button class="quote-small" bindtap="closeQuotePreview">返回修改</button><button class="quote-small primary" bindtap="sendQuoteCard" disabled="{{quoteDraft.status !== 'confirmed' || quoteSending || quoteDraft.delivery}}">{{quoteSending ? '发送中…' : quoteDraft.delivery ? '该版本已发送' : quoteDraft.status === 'confirmed' ? '发送报价卡' : '确认后可发送'}}</button></view><view class="quote-preview-tip" wx:if="{{quoteDraft.status !== 'confirmed'}}">请先补齐必填信息并完成人工确认，确认后即可在这里发送。</view></view><view class="quote-warning">价格、折扣、付款条款和交期必须由人工确认</view><button class="secondary full" bindtap="regenerateQuote" disabled="{{quoteLoading}}" wx:if="{{quoteDraft.status !== 'confirmed'}}">按最新会话重新整理</button></block></view><view wx:elif="{{panel === 'search'}}" class="search-panel"><view class="panel-search"><text>⌕</text><input focus placeholder="搜索当前会话" value="{{search}}" bindinput="inputSearch"/></view><view class="search-result" wx:for="{{searchResults}}" wx:key="id"><text>{{item.body}}</text><text class="muted">{{item.time}}</text></view><view class="helper" wx:if="{{search && !searchResults.length}}">没有找到相关消息</view></view></view>
