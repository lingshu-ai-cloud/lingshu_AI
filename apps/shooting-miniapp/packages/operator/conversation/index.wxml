<view class="conversation-page" style="padding-bottom:{{safeBottom}}px">
  <view class="nav"><view class="back" bindtap="back">‹</view><view class="identity" wx:if="{{customer}}"><view class="mini-avatar">{{customer.initial}}</view><view><view class="nav-name">{{customer.name}}</view><view class="nav-meta"><text class="online"></text>{{customer.channel}} · {{customer.statusLabel}}</view></view></view><view class="more">•••</view></view>
  <view class="state" wx:if="{{loading}}">正在载入会话…</view><view class="state error" wx:elif="{{error}}">{{error}}</view>
  <scroll-view class="messages" scroll-y wx:else scroll-into-view="{{scrollTo}}" enhanced show-scrollbar="{{false}}">
    <view class="date-divider">最近会话</view>
    <view id="message-{{index}}" class="message-row {{item.mine ? 'mine' : ''}}" wx:for="{{messages}}" wx:key="id"><view class="bubble"><text selectable>{{item.body}}</text><view class="bubble-time">{{item.time}}{{item.mine ? ' · 已送达' : ''}}</view></view></view>
    <view class="empty-chat" wx:if="{{!messages.length}}">还没有消息记录</view><view class="scroll-tail"></view>
  </scroll-view>
  <view class="plus-menu" wx:if="{{plusOpen}}"><view class="plus-grid"><view class="plus-item" data-panel="profile" bindtap="openPanel"><view class="plus-icon">客</view><text>客户资料</text></view><view class="plus-item" data-panel="reply" bindtap="openPanel"><view class="plus-icon violet">答</view><text>回复与报价</text></view><view class="plus-item" data-panel="media" bindtap="openPanel"><view class="plus-icon green">件</view><text>文件和媒体</text></view><view class="plus-item" data-panel="search" bindtap="openPanel"><view class="plus-icon orange">搜</view><text>会话搜索</text></view></view></view>
  <view class="composer"><view class="plus {{plusOpen ? 'active' : ''}}" bindtap="togglePlus">{{plusOpen ? '×' : '+'}}</view><textarea auto-height maxlength="2000" confirm-type="send" placeholder="输入消息" value="{{draft}}" bindinput="inputDraft" bindconfirm="send"></textarea><button class="send {{draft ? 'ready' : ''}}" disabled="{{!draft || sending}}" bindtap="send">{{sending ? '…' : '发送'}}</button></view>
</view>
<view class="sheet-mask" wx:if="{{panel}}" bindtap="closePanel"></view><view class="detail-sheet" wx:if="{{panel}}"><view class="sheet-handle"></view><view class="sheet-head"><text>{{panelTitle}}</text><text class="sheet-close" bindtap="closePanel">×</text></view>
  <view wx:if="{{panel === 'profile' && customer}}" class="profile"><view class="profile-hero"><view class="profile-avatar">{{customer.initial}}</view><view><view class="profile-name">{{customer.name}}</view><view class="muted">{{customer.channel}}</view></view></view><view class="info-row"><text>客户阶段</text><text>{{customer.stage || '待识别'}}</text></view><view class="info-row"><text>国家或地区</text><text>{{customer.country || '待补充'}}</text></view><view class="info-row"><text>沟通语言</text><text>{{customer.language || '待识别'}}</text></view><view class="tag-row"><text wx:for="{{customer.tags}}" wx:key="*this">{{item}}</text></view></view>
  <view wx:elif="{{panel === 'reply'}}" class="reply-panel"><view class="helper">选择后会填入输入框，发送前仍可编辑。</view><view class="reply-card" data-text="您好，已经收到您的需求。我先确认一下产品规格和预计数量，稍后给您完整回复。" bindtap="useReply"><text class="reply-label">确认需求</text><text>您好，已经收到您的需求。我先确认一下产品规格和预计数量，稍后给您完整回复。</text></view><view class="reply-card" data-text="可以的。为了给您准确报价，请告诉我数量、目的地和期望交期。" bindtap="useReply"><text class="reply-label">询价补充</text><text>可以的。为了给您准确报价，请告诉我数量、目的地和期望交期。</text></view><button class="secondary full">打开报价工具</button></view>
  <view wx:elif="{{panel === 'media'}}" class="media-panel"><view class="media-action" bindtap="chooseMedia"><view class="media-icon">＋</view><view><view class="section-title">选择文件</view><view class="muted">从微信会话中选择图片或文件</view></view></view><view class="helper">发送媒体前会显示预览和确认步骤。</view></view>
  <view wx:elif="{{panel === 'search'}}" class="search-panel"><view class="panel-search"><text>⌕</text><input focus placeholder="搜索当前会话" value="{{search}}" bindinput="inputSearch"/></view><view class="search-result" wx:for="{{searchResults}}" wx:key="id"><text>{{item.body}}</text><text class="muted">{{item.time}}</text></view><view class="helper" wx:if="{{search && !searchResults.length}}">没有找到相关消息</view></view>
</view>
