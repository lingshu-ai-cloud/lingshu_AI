<view class="conversation-page" style="padding-bottom:{{safeBottom}}px">
  <view class="nav" style="padding-top:{{statusBarHeight}}px;padding-left:12rpx"><view class="back" style="width:58rpx;justify-content:center;padding-right:0;margin-right:4rpx;color:#1f2937" bindtap="back" aria-label="返回会话列表"><text class="back-arrow" style="font-size:58rpx;font-weight:300;line-height:1">‹</text></view><view class="identity" wx:if="{{customer}}" bindtap="openProfile"><view class="mini-avatar">{{customer.initial}}</view><view class="identity-copy"><view class="nav-name">{{customer.name}}</view><view class="nav-meta"><text class="online"></text>{{customer.channel}} · {{customer.statusLabel}}</view></view><text class="identity-arrow">›</text></view><view class="nav-spacer"></view></view>
  <view class="state" wx:if="{{loading}}">正在载入会话…</view><view class="state error" wx:elif="{{error}}">{{error}}</view>
  <scroll-view class="messages" scroll-y wx:else scroll-into-view="{{scrollTo}}" enhanced show-scrollbar="{{false}}">
    <view class="date-divider">最近会话</view>
    <view id="message-{{index}}" class="message-row {{item.mine ? 'mine' : 'theirs'}}" wx:for="{{messages}}" wx:key="id"><view class="message-stack"><view class="bubble"><text selectable>{{item.body}}</text></view><view class="message-note" wx:if="{{item.note}}">译文·{{item.note}}</view><view class="bubble-time">{{item.time}}{{item.mine ? ' · 已送达' : ''}}</view></view></view>
    <view class="empty-chat" wx:if="{{!messages.length}}">还没有消息记录</view><view class="scroll-tail"></view>
  </scroll-view>
  <view class="plus-menu" wx:if="{{plusOpen}}"><view class="plus-grid"><view class="plus-item" data-panel="reply" bindtap="openPanel"><view class="plus-icon violet">AI</view><text>AI 推荐回复</text></view><view class="plus-item" data-panel="media" bindtap="openPanel"><view class="plus-icon green">件</view><text>文件和媒体</text></view><view class="plus-item" data-panel="search" bindtap="openPanel"><view class="plus-icon orange">搜</view><text>会话搜索</text></view><view class="plus-item" bindtap="openProfile"><view class="plus-icon">…</view><text>更多</text></view></view></view>
  <view class="composer"><view class="translation-preview" wx:if="{{translating || translatedDraft}}"><text class="translation-label">{{translating ? '正在自动翻译…' : '将发送·' + targetLanguage}}</text><text wx:if="{{translatedDraft}}">{{translatedDraft}}</text></view><view class="composer-row"><view class="plus {{plusOpen ? 'active' : ''}}" bindtap="togglePlus">{{plusOpen ? '×' : '+'}}</view><view class="input-shell"><textarea auto-height maxlength="2000" confirm-type="send" placeholder="输入中文，自动翻译后发送" value="{{draft}}" bindinput="inputDraft" bindconfirm="send"></textarea></view><view class="send {{draft && !sending && !translating ? 'ready' : ''}}" role="button" aria-label="发送消息" bindtap="send"><text>{{sending ? '…' : '↑'}}</text></view></view></view>
</view>
<view class="sheet-mask" wx:if="{{panel}}" bindtap="closePanel"></view><view class="detail-sheet" wx:if="{{panel}}"><view class="sheet-handle"></view><view class="sheet-head"><text>{{panelTitle}}</text><text class="sheet-close" bindtap="closePanel">×</text></view>
  <view wx:if="{{panel === 'profile' && customer}}" class="profile"><view class="profile-hero"><view class="profile-avatar">{{customer.initial}}</view><view><view class="profile-name">{{customer.name}}</view><view class="muted">{{customer.channel}}</view></view></view><view class="info-row"><text>客户阶段</text><text>{{customer.stage || '待识别'}}</text></view><view class="info-row"><text>国家或地区</text><text>{{customer.country || '待补充'}}</text></view><view class="info-row"><text>沟通语言</text><text>{{customer.language || '待识别'}}</text></view><view class="tag-row"><text wx:for="{{customer.tags}}" wx:key="*this">{{item}}</text></view></view>
  <view wx:elif="{{panel === 'reply'}}" class="reply-panel"><view class="reply-loading" wx:if="{{recommending}}">正在生成两个回复版本和中文释义…</view><view class="reply-card" wx:for="{{recommendations}}" wx:key="body" data-index="{{index}}" bindtap="useReply"><text class="reply-label">AI 推荐 {{index + 1}}</text><text class="reply-body">{{item.body}}</text><text class="reply-translation" wx:if="{{item.translation}}">中文释义：{{item.translation}}</text></view><button class="secondary full" bindtap="loadRecommendations" disabled="{{recommending}}">换一批回复</button></view>
  <view wx:elif="{{panel === 'media'}}" class="media-panel"><view class="media-action" bindtap="chooseMedia"><view class="media-icon">＋</view><view><view class="section-title">选择文件</view><view class="muted">从微信会话中选择图片或文件</view></view></view><view class="helper">发送媒体前会显示预览和确认步骤。</view></view>
  <view wx:elif="{{panel === 'search'}}" class="search-panel"><view class="panel-search"><text>⌕</text><input focus placeholder="搜索当前会话" value="{{search}}" bindinput="inputSearch"/></view><view class="search-result" wx:for="{{searchResults}}" wx:key="id"><text>{{item.body}}</text><text class="muted">{{item.time}}</text></view><view class="helper" wx:if="{{search && !searchResults.length}}">没有找到相关消息</view></view>
</view>
