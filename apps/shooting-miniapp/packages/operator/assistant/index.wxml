<view class="assistant-page">
  <view class="top-safe" style="height:{{statusBarHeight}}px"></view>
  <view class="assistant-header" style="height:{{headerHeight}}px"><button class="session-entry" bindtap="openSessions">我的会话</button><view><text class="title">{{agentTitle}}</text><view class="online"><view></view><text>{{agentNote}}</text></view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <scroll-view scroll-y class="conversation" style="top:{{contentTop}}px" scroll-into-view="{{anchor}}">
    <view wx:if="{{!messages.length && !loading}}" class="welcome"><view class="welcome-copy"><text class="welcome-title">{{welcomeTitle}}</text><text class="welcome-note">{{welcomeNote}}</text></view><view wx:if="{{suggestions.length}}" class="suggestion-entry" bindtap="toggleSuggestions"><text>常用问题</text><text>{{showSuggestions ? '收起' : '展开'}}</text></view><view wx:if="{{showSuggestions}}" class="suggestions"><view class="suggestion-row"><view wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-text="{{item}}" bindtap="ask">{{item}}</view></view></view></view>
    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message {{item.role}}"><text class="speaker">{{item.role === 'user' ? '你' : agentTitle}}</text><text user-select class="message-text">{{item.content}}</text></view>
    <view wx:if="{{sending}}" class="thinking">正在整理真实工作信息…</view>
    <view wx:if="{{contentTask}}" class="content-task-card">
      <view class="content-task-head"><text class="content-task-state">{{contentTask.stateLabel}}</text><text wx:if="{{contentTask.progress}}" class="content-task-progress">{{contentTask.progress}}</text></view>
      <text class="content-task-title">{{contentTask.title}}</text>
      <text class="content-task-node">{{contentTask.currentNode.label}} · {{contentTask.currentNode.userFacingSummary}}</text>
      <view wx:if="{{contentTask.blockingItems.length}}" class="content-task-list"><text wx:for="{{contentTask.blockingItems}}" wx:key="key">{{item.label}}：{{item.value}}</text></view>
      <view wx:elif="{{contentTask.knownItems.length}}" class="content-task-list muted"><text wx:for="{{contentTask.knownItems}}" wx:key="key">已确定 · {{item.label}}：{{item.value}}</text></view>
      <text wx:if="{{contentTask.costLabel}}" class="content-task-time">{{contentTask.costLabel}}</text>
      <text class="content-task-time">最近确认 {{contentTask.lastConfirmedAt}}</text>
      <button class="content-task-action" bindtap="openContentTask">{{contentTask.actionLabel}}</button>
    </view>
    <view wx:for="{{actions}}" wx:key="id" class="action-card" data-index="{{index}}" bindtap="previewAction"><text>{{item.label || '查看操作方案'}}</text><text>›</text></view>
    <view wx:if="{{preview}}" class="preview-card"><text class="preview-title">执行前确认 · {{preview.target.title}}</text><text class="preview-impact">{{preview.impact}}</text><view wx:for="{{preview.steps}}" wx:key="*this" class="step">{{index + 1}}. {{item}}</view><view class="preview-buttons"><button bindtap="dismissPreview">取消</button><button class="confirm" loading="{{confirming}}" bindtap="confirmAction">确认执行</button></view></view>
    <view wx:if="{{receipts.length}}" class="receipts"><text class="receipt-heading">执行记录</text><view wx:for="{{receipts}}" wx:key="id" class="receipt"><text>{{item.statusLabel}}</text><text>{{item.acceptedAt}}</text></view></view>
  </scroll-view>
  <view wx:if="{{inputMode === 'voice'}}" class="voice-prompt {{recording ? 'recording' : ''}}" bindtouchstart="holdVoiceStart" bindtouchmove="holdVoiceMove" bindtouchend="holdVoiceEnd" bindtouchcancel="cancelRecording">
    <view class="voice-glyph"><text></text><text></text></view>
    <view class="voice-copy"><text class="voice-title">{{transcribing ? '正在识别…' : recording ? '松开发送' : '长按问灵小枢'}}</text><text class="voice-note">{{recording ? '上滑取消' : '可按住提问或者派活'}}</text></view>
    <view class="keyboard-switch" data-mode="text" bindtap="switchInputMode">⌨</view>
  </view>
  <view wx:else class="composer"><button class="mode" data-mode="voice" bindtap="switchInputMode">🎙</button><input value="{{input}}" bindinput="inputText" confirm-type="send" bindconfirm="send" placeholder="输入消息"/><button wx:if="{{input}}" class="send" disabled="{{sending}}" bindtap="send">↑</button></view>
  <view wx:if="{{recording}}" class="voice-status"><text>正在聆听，松开发送</text><text>上滑可取消</text></view>
  <operator-nav active="assistant" mode="{{serviceMode ? 'service' : 'operator'}}"></operator-nav>
  <view wx:if="{{showSessions}}" class="session-overlay">
    <view class="session-sheet">
      <view class="session-head"><text wx:if="{{historySession}}" class="session-back" bindtap="backToSessions">‹ 会话列表</text><text class="session-title">{{historySession ? historySession.displayTitle : '我的会话'}}</text><text class="session-close" bindtap="closeSessions">关闭</text></view>
      <scroll-view scroll-y class="session-body">
        <view wx:if="{{sessionsLoading}}" class="session-empty">正在读取本地账号的会话…</view>
        <block wx:elif="{{historySession}}"><view wx:for="{{historyMessages}}" wx:key="id" class="history-message {{item.role}}"><text class="history-speaker">{{item.role === 'user' ? '你' : agentTitle}}</text><text user-select>{{item.content}}</text></view><view wx:if="{{!historyMessages.length}}" class="session-empty">该会话还没有消息</view></block>
        <block wx:else><view wx:for="{{sessions}}" wx:key="id" class="session-row" data-id="{{item.id}}" bindtap="viewSession"><view><text class="session-row-title">{{item.displayTitle}}</text><text class="session-row-time">{{item.displayTime}}</text></view><text>{{item.archivedAt ? '已归档' : '进行中'}} ›</text></view><view wx:if="{{!sessions.length}}" class="session-empty">还没有历史会话</view></block>
      </scroll-view>
    </view>
  </view>
</view>
