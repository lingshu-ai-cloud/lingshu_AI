<view class="assistant-page">
  <view class="top-safe" style="height:{{statusBarHeight}}px"></view>
  <view class="assistant-header" style="height:{{headerHeight}}px"><view><text class="title">经营 Agent</text><view class="online"><view></view><text>企业工作助手</text></view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <scroll-view scroll-y class="conversation" style="top:{{contentTop}}px" scroll-into-view="{{anchor}}">
    <view wx:if="{{!messages.length && !loading}}" class="welcome"><view class="welcome-copy"><text class="welcome-title">今天想推进什么？</text><text class="welcome-note">我会基于真实任务、询盘与执行状态回答</text></view><view class="suggestions"><view class="suggestion-row"><view wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-text="{{item}}" bindtap="ask">{{item}}</view></view></view></view>
    <view wx:for="{{messages}}" wx:key="id" id="{{item.id}}" class="message {{item.role}}"><text class="speaker">{{item.role === 'user' ? '你' : '经营 Agent'}}</text><text user-select class="message-text">{{item.content}}</text></view>
    <view wx:if="{{sending}}" class="thinking">正在整理真实工作信息…</view>
    <view wx:for="{{actions}}" wx:key="id" class="action-card" data-index="{{index}}" bindtap="previewAction"><text>{{item.label || '查看操作方案'}}</text><text>›</text></view>
    <view wx:if="{{preview}}" class="preview-card"><text class="preview-title">执行前确认 · {{preview.target.title}}</text><text class="preview-impact">{{preview.impact}}</text><view wx:for="{{preview.steps}}" wx:key="*this" class="step">{{index + 1}}. {{item}}</view><view class="preview-buttons"><button bindtap="dismissPreview">取消</button><button class="confirm" loading="{{confirming}}" bindtap="confirmAction">确认执行</button></view></view>
    <view wx:if="{{receipts.length}}" class="receipts"><text class="receipt-heading">执行记录</text><view wx:for="{{receipts}}" wx:key="id" class="receipt"><text>{{item.statusLabel}}</text><text>{{item.acceptedAt}}</text></view></view>
  </scroll-view>
  <view class="composer {{recording ? 'recording' : ''}}"><button class="mode" data-mode="{{inputMode === 'text' ? 'voice' : 'text'}}" bindtap="switchInputMode">{{inputMode === 'text' ? '🎙' : '⌨'}}</button><block wx:if="{{inputMode === 'text'}}"><input value="{{input}}" bindinput="inputText" confirm-type="send" bindconfirm="send" placeholder="输入消息"/><button wx:if="{{input}}" class="send" disabled="{{sending}}" bindtap="send">↑</button></block><button wx:else class="hold-to-talk {{recording ? 'holding' : ''}}" disabled="{{transcribing || sending}}" bindtouchstart="holdVoiceStart" bindtouchmove="holdVoiceMove" bindtouchend="holdVoiceEnd" bindtouchcancel="cancelRecording">{{transcribing ? '正在识别…' : recording ? '松开发送' : '按住说话'}}</button></view>
  <view wx:if="{{recording}}" class="voice-status"><text>正在聆听，松开发送</text><text>上滑可取消</text></view>
  <operator-nav active="assistant"></operator-nav>
</view>
