page{height:100%;overflow:hidden;background:var(--ls-bg)}
.assistant-page{height:100vh;background:var(--ls-bg);color:var(--ls-text)}
.assistant-header{position:relative;display:flex;align-items:center;padding:0 28rpx;gap:18rpx;box-sizing:border-box;background:var(--ls-bg)}
.menu-button{margin:0;padding:0;width:88rpx;height:88rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;border:0;background:transparent}.menu-button::after,button::after{border:0}.menu-lines{width:34rpx;height:24rpx;border-top:3rpx solid var(--ls-text);border-bottom:3rpx solid var(--ls-text);position:relative}.menu-lines::after{content:'';position:absolute;left:0;top:9rpx;width:24rpx;border-top:3rpx solid var(--ls-text)}.header-title{font-size:29rpx;font-weight:650;letter-spacing:.4rpx}
.conversation{position:fixed;left:0;right:0;bottom:calc(338rpx + env(safe-area-inset-bottom));width:100%;padding:28rpx 32rpx 0;box-sizing:border-box}.welcome{min-height:100%;padding:20rpx 12rpx 70rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;text-align:center}.welcome-greeting{font-size:38rpx;line-height:58rpx;font-weight:650}.welcome-note{margin-top:18rpx;color:var(--ls-text-tertiary);font-size:23rpx;line-height:36rpx}.message{max-width:94%;margin:0 0 28rpx;padding:12rpx 0;box-sizing:border-box}.message.user{width:fit-content;max-width:86%;margin-left:auto;padding:22rpx 26rpx;border-radius:26rpx 26rpx 6rpx 26rpx;background:var(--ls-action-gradient);color:#fff}.speaker{display:block;margin-bottom:10rpx;font-size:21rpx;color:var(--ls-text-tertiary)}.message.user .speaker{display:none}.message-text{font-size:28rpx;line-height:46rpx;white-space:pre-wrap}.thinking{padding:12rpx 0;color:var(--ls-text-tertiary);font-size:23rpx}.error{padding:18rpx 22rpx;border-radius:16rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:24rpx}.scroll-end{height:24rpx}
.conversation-dock{position:fixed;z-index:30;bottom:calc(132rpx + env(safe-area-inset-bottom));left:0;right:0;background:var(--ls-bg);padding:0 28rpx 22rpx;box-sizing:border-box}.quick-cards{width:calc(100% + 28rpx);height:92rpx;margin-bottom:16rpx;white-space:nowrap}.quick-card-row{display:inline-flex;gap:12rpx;padding-right:28rpx}.quick-card{display:inline-flex;align-items:center;gap:12rpx;flex-shrink:0;min-height:76rpx;margin:0;padding:0 24rpx;border:0;border-radius:40rpx;background:var(--ls-fill);color:var(--ls-text);font-size:24rpx;line-height:76rpx}.quick-card:active{background:var(--ls-selected)}.quick-icon{font-size:27rpx}.quick-card[disabled]{opacity:.5}.composer{display:flex;align-items:center;gap:8rpx;min-height:104rpx;padding:8rpx 10rpx;box-sizing:border-box;border:1rpx solid var(--ls-border);border-radius:56rpx;background:var(--ls-bg);box-shadow:0 10rpx 30rpx rgba(23,35,61,.045)}.composer input{flex:1;min-width:0;height:76rpx;font-size:27rpx;padding:0 8rpx}.composer button{display:flex;align-items:center;justify-content:center;flex:0 0 80rpx;width:80rpx;height:80rpx;min-height:80rpx;margin:0;padding:0;border:0;border-radius:50%;background:transparent;color:var(--ls-text);line-height:1}.composer-more{font-size:48rpx;font-weight:300}.composer .send{flex-basis:68rpx;width:68rpx;height:68rpx;min-height:68rpx;background:var(--ls-action-gradient);color:#fff;font-size:36rpx}.voice-bars{display:flex;align-items:center;justify-content:center;gap:4rpx;width:48rpx;height:48rpx;border:3rpx solid var(--ls-text);border-radius:50%}.voice-bars text{width:3rpx;height:12rpx;border-radius:4rpx;background:var(--ls-text)}.voice-bars text:nth-child(2),.voice-bars text:nth-child(4){height:21rpx}.voice-bars text:nth-child(3){height:30rpx}.voice-hold{flex:1;min-width:0;min-height:80rpx;display:flex;align-items:center;justify-content:center;font-size:27rpx}.voice-status{padding:12rpx 20rpx;margin-bottom:12rpx;border-radius:18rpx;background:var(--ls-selected);color:var(--ls-primary);font-size:23rpx}.suggestions{max-height:220rpx;overflow:auto;margin-bottom:16rpx;display:flex;flex-wrap:wrap;gap:10rpx}.suggestion{margin:0;padding:14rpx 20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:20rpx;background:var(--ls-bg);font-size:23rpx;line-height:36rpx}
.action-card{display:flex;justify-content:space-between;margin:16rpx 0;padding:22rpx;border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;color:var(--ls-primary);font-size:26rpx}.preview-card{padding:24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:20rpx}.preview-title,.preview-impact,.step{display:block;margin-bottom:12rpx;font-size:25rpx;line-height:40rpx}.preview-title{font-weight:650}.preview-buttons{display:flex;gap:16rpx}.preview-buttons button{flex:1;font-size:25rpx;min-height:88rpx}.preview-buttons .confirm{background:var(--ls-action-gradient);color:#fff}.receipt{display:flex;justify-content:space-between;padding:16rpx 0;font-size:23rpx;color:var(--ls-text-secondary)}.receipt-heading{font-size:24rpx}
.session-overlay{position:fixed;z-index:90;inset:0;background:var(--ls-mask);animation:menu-fade var(--ls-motion-enter) var(--ls-ease-enter)}.session-sheet{position:absolute;top:0;bottom:0;left:0;width:82%;max-width:640rpx;background:var(--ls-bg);box-shadow:16rpx 0 48rpx rgba(0,0,0,.08);display:flex;flex-direction:column;animation:menu-enter var(--ls-motion-enter) var(--ls-ease-enter)}.session-head{flex:none;display:flex;align-items:center;justify-content:space-between;padding-right:22rpx;padding-left:32rpx;padding-bottom:28rpx;min-height:120rpx}.session-brand,.session-subtitle{display:block}.session-brand{font-size:36rpx;font-weight:650;line-height:54rpx}.session-subtitle{color:var(--ls-text-tertiary);font-size:23rpx;line-height:34rpx}.session-close{width:88rpx;height:88rpx;margin:0;padding:0;background:transparent;border:0;font-size:46rpx;font-weight:300;line-height:88rpx}.session-body{flex:1;min-height:0;height:0;padding:0 24rpx 40rpx;box-sizing:border-box}.workspace-link{display:flex;align-items:center;gap:24rpx;width:100%;min-height:96rpx;margin:0 0 12rpx;padding:0 24rpx;background:transparent;color:var(--ls-text);text-align:left;border:0;border-radius:20rpx;font-size:28rpx;line-height:96rpx}.workspace-link text:first-child{width:32rpx;font-size:32rpx}.workspace-link.new-conversation{background:var(--ls-fill)}.history-heading{margin:40rpx 24rpx 18rpx;color:var(--ls-text-tertiary);font-size:24rpx}.session-row{width:100%;padding:20rpx 24rpx;margin:0;background:transparent;text-align:left;border:0;border-radius:16rpx;line-height:38rpx}.session-row:active{background:var(--ls-fill)}.session-row-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:26rpx;color:var(--ls-text)}.session-row-time{display:block;font-size:20rpx;color:var(--ls-text-tertiary)}.session-empty{padding:44rpx 20rpx;color:var(--ls-text-tertiary);font-size:24rpx;text-align:center}.session-back{margin:0 0 24rpx;background:var(--ls-fill);font-size:25rpx;min-height:88rpx}.history-title{display:block;font-size:28rpx;font-weight:600;margin-bottom:24rpx}.history-message{padding:20rpx;margin-bottom:20rpx;border-radius:18rpx;background:var(--ls-fill);font-size:24rpx;line-height:40rpx;white-space:pre-wrap}.history-speaker{display:block;font-size:20rpx;color:var(--ls-text-tertiary);margin-bottom:8rpx}
@keyframes menu-fade{from{opacity:0}to{opacity:1}}@keyframes menu-enter{from{transform:translateX(-8px);opacity:0}to{transform:translateX(0);opacity:1}}@media(prefers-reduced-motion:reduce){.session-overlay,.session-sheet{animation:none}}
.content-task-card{margin:16rpx 0;padding:24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:18rpx;background:#fff;text-align:left}.content-task-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.content-task-state{padding:6rpx 14rpx;border-radius:999rpx;background:var(--ls-selected);color:var(--ls-primary);font-size:21rpx;font-weight:600}.content-task-progress,.content-task-time{color:var(--ls-text-tertiary);font-size:21rpx}.content-task-title{display:block;margin-top:16rpx;color:var(--ls-text);font-size:29rpx;font-weight:650}.content-task-node{display:block;margin-top:8rpx;color:var(--ls-text-secondary);font-size:24rpx;line-height:38rpx}.content-task-list{margin-top:14rpx;padding:14rpx 16rpx;border-radius:12rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:23rpx}.content-task-list.muted{background:var(--ls-fill);color:var(--ls-text-secondary)}.content-task-list text{display:block;line-height:36rpx}.content-task-time{display:block;margin-top:14rpx}.content-task-action{min-height:88rpx;margin-top:18rpx;border:0;border-radius:12rpx;background:var(--ls-action-gradient);color:#fff;font-size:25rpx;font-weight:600}.content-task-action::after{border:0}
/* Native buttons have platform sizing; pin compact navigation and card widths. */
.menu-button{position:absolute;left:0;top:50%;transform:translateY(-50%);flex:none}.header-title{position:absolute;left:88rpx;top:50%;transform:translateY(-50%);max-width:300rpx;white-space:nowrap}.quick-card-row{width:max-content}.quick-card{width:180rpx;flex:0 0 180rpx;justify-content:center;padding:0 16rpx}.session-close{flex:0 0 88rpx}

.menu-glyph{display:block;font-size:36rpx;font-weight:400;color:var(--ls-text);line-height:1}

/* Keep native scrolling without the simulator's persistent gray scrollbar. */
::-webkit-scrollbar{display:none;width:0;height:0;color:transparent}
.menu-unread,.session-unread{display:flex;align-items:center;justify-content:center;background:var(--ls-error,#ef4444);color:#fff;border-radius:50%;font-size:22rpx;min-width:36rpx;height:36rpx;flex-shrink:0}.menu-unread{position:absolute;top:0;right:0;min-width:30rpx;height:30rpx;font-size:20rpx}
.session-sheet{display:flex;flex-direction:column;background:#fff}.session-head,.session-tools{flex-shrink:0}.session-tools{padding:0 28rpx}.session-body{flex:1;min-height:0;height:0;padding:0 28rpx 32rpx;box-sizing:border-box}.session-tools .workspace-link{padding-left:20rpx}.session-tools .history-heading{margin:32rpx 8rpx 16rpx}.session-search{display:flex;align-items:center;gap:16rpx;background:#f5f5f5;border-radius:20rpx;padding:0 24rpx;margin:8rpx 0 20rpx;min-height:88rpx}.session-search input{flex:1;min-width:0;font-size:28rpx}.session-search:focus-within{box-shadow:0 0 0 2rpx #6366f1}.session-row-head{display:flex;align-items:center;gap:16rpx;width:100%}.session-row-title{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.session-row-meta{display:flex;align-items:center;gap:16rpx;width:100%;margin-top:8rpx}.session-row-time{margin-top:0}.session-status{font-size:22rpx;color:#737373}.session-status.processing{color:#5254dc}.session-status.failed,.session-status.unconfirmed{color:#b45309}
button.workspace-link{width:100%;max-width:none;justify-content:flex-start;font-weight:500}button.session-row{display:block;width:100%;max-width:none;text-align:left;font-weight:400}.session-row-title{font-weight:500}.session-search{background:var(--ls-fill)}.session-sheet{background:var(--ls-bg)}.session-status{color:var(--ls-text-tertiary)}.session-status.processing{color:var(--ls-primary)}.session-status.failed{color:var(--ls-error)}.session-status.unconfirmed{color:var(--ls-warning)}
button.menu-button{flex:0 0 88rpx;width:88rpx;min-width:88rpx;max-width:88rpx;margin:0;padding:0}button.session-close{flex:0 0 88rpx;width:88rpx;min-width:88rpx;max-width:88rpx;margin:0;padding:0}
