page{background:#fff}.assistant-page{min-height:100vh}.top-safe{height:calc(env(safe-area-inset-top) + 20rpx);background:#fff}.assistant-header{height:104rpx;padding:0 32rpx;display:flex;align-items:center;justify-content:center;position:relative;background:#fff;border-bottom:1rpx solid var(--ls-border-secondary);text-align:center}.assistant-header>view:first-child{display:flex;flex-direction:column;align-items:center;justify-content:center}.title{display:block;font-size:36rpx;font-weight:650}.online{display:flex;align-items:center;justify-content:center;gap:8rpx;color:var(--ls-text-tertiary);font-size:22rpx}.online view{width:10rpx;height:10rpx;border-radius:50%;background:var(--ls-success)}.error{margin:16rpx 32rpx;padding:16rpx 20rpx;border:1rpx solid var(--ls-error);border-radius:12rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:24rpx;text-align:left}.conversation{position:fixed;top:calc(env(safe-area-inset-top) + 124rpx);bottom:calc(230rpx + env(safe-area-inset-bottom));left:0;right:0;padding:26rpx 32rpx;box-sizing:border-box}.welcome{height:100%;min-height:600rpx;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;padding:88rpx 0 30rpx}.welcome-copy{display:flex;flex-direction:column;align-items:center;text-align:center}.welcome-title{font-size:34rpx;font-weight:650}.welcome-note{margin-top:10rpx;color:var(--ls-text-tertiary);font-size:24rpx}.suggestion-entry{width:100%;min-height:88rpx;margin-top:auto;padding:0 24rpx;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;border:1rpx solid var(--ls-border-secondary);border-radius:12rpx;background:#fff;color:var(--ls-text-secondary);font-size:24rpx}.suggestions{width:100%;margin-top:12rpx}.suggestion-row{width:100%;display:flex;flex-direction:column;align-items:stretch;gap:12rpx}.suggestion{min-height:88rpx;padding:16rpx 24rpx;display:flex;align-items:center;justify-content:flex-start;box-sizing:border-box;border-radius:12rpx;background:#fff