page{background:#f6f7fa}.assistant-page{min-height:100vh}.top-safe{height:calc(env(safe-area-inset-top) + 20rpx);background:#fff}.assistant-header{height:104rpx;padding:0 32rpx;display:flex;align-items:center;justify-content:center;position:relative;background:#fff;border-bottom:1rpx solid var(--ls-border-secondary);text-align:center}.assistant-header>view:first-child{display:flex;flex-direction:column;align-items:center;justify-content:center}.title{display:block;font-size:36rpx;font-weight:650}.online{display:flex;align-items:center;justify-content:center;gap:8rpx;color:var(--ls-text-tertiary);font-size:21rpx}.online view{width:10rpx;height:10rpx;border-radius:50%;background:var(--ls-success)}.status{position:absolute;right:32rpx;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;padding:6rpx 14rpx;border-radius:16rpx;background:var(--ls-success-bg);color:var(--ls-success);font-size:21rpx;text-align:center}.error{margin:16rpx 32rpx;padding:16rpx 20rpx;border-radius:14rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:22rpx;text-align:center}.conversation{position:fixed;top:calc(env(safe-area-inset-top) + 124rpx);bottom:calc(230rpx + env(safe-area-inset-bottom));left:0;right:0;padding:26rpx 32rpx;box-sizing:border-box}.welcome{height:100%;min-height:720rpx;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;padding:36rpx 0 30rpx}.welcome-copy{display:flex;flex-direction:column;align-items:center;text-align:center}.welcome-title{font-size:34rpx;font-weight:650}.welcome-note{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:23rpx}.suggestions{width:100%;margin-top:auto;margin-bottom:28rpx}.suggestion-row{width:100%;display:flex;flex-direction:column;align-items:stretch;gap:16rpx}.suggestion{min-height:76rpx;padding:14rpx 24rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border-radius:22rpx;background:#fff;border:1rpx solid var(--ls-border-secondary);font-size:24rpx;text-align:center}.message{max-width:82%;margin-bottom:20rpx;padding:20rpx 23rpx;border-radius:22rpx;background:#fff}.message.user{margin-left:auto;background:var(--ls-action-gradient);color:#fff}.speaker{display:block;margin-bottom:5rpx;font-size:20rpx;opacity:.7}.message-text{font-size:27rpx;line-height:42rpx;white-space:pre-wrap}.thinking{padding:18rpx;color:var(--ls-text-tertiary);font-size:23rpx;text-align:center}.action-card{min-height:76rpx;display:flex;align-items:center;justify-content:center;gap:12rpx;margin:12rpx 0;padding:22rpx;box-sizing:border-box;border-radius:18rpx;background:#fff;color:var(--ls-primary);font-size:24rpx;text-align:center}.preview-card,.receipts{margin:16rpx 0;padding:24rpx;border-radius:22rpx;background:#fff}.preview-title,.receipt-heading{display:block;font-size:28rpx;font-weight:600;text-align:center}.preview-impact{display:block;margin:10rpx 0;color:var(--ls-text-secondary);font-size:24rpx;text-align:center}.step{padding:7rpx 0;font-size:23rpx;text-align:center}.preview-buttons{display:flex;gap:14rpx;margin-top:20rpx}.preview-buttons button{flex:1;display:flex;align-items:center;justify-content:center;font-size:24rpx;text-align:center}.preview-buttons .confirm{background:var(--ls-primary);color:#fff}.receipt{display:flex;justify-content:center;gap:20rpx;padding-top:14rpx;color:var(--ls-text-secondary);font-size:22rpx;text-align:center}.composer{position:fixed;z-index:30;left:20rpx;right:20rpx;bottom:calc(136rpx + env(safe-area-inset-bottom));min-height:88rpx;display:flex;align-items:center;gap:12rpx;padding:10rpx 12rpx;background:#fff;border:1rpx solid var(--ls-border-secondary);border-radius:28rpx;box-shadow:0 10rpx 30rpx rgba(21,34,66,.08)}.composer.recording{border-color:var(--ls-primary)}.composer input{flex:1;height:68rpx;padding:0 8rpx;font-size:26rpx}.composer button{width:68rpx;height:68rpx;min-width:68rpx;margin:0;padding:0;border:0;border-radius:50%;display:flex;align-items:center;justify-content:center;fon