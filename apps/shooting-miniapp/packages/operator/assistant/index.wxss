page{background:#f6f7fa}.assistant-page{min-height:100vh}.top-safe{height:calc(env(safe-area-inset-top) + 16rpx)}.assistant-header{height:104rpx;padding:0 32rpx;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1rpx solid var(--ls-border-secondary)}.title{display:block;font-size:36rpx;font-weight:650}.online{display:flex;align-items:center;gap:8rpx;color:var(--ls-text-tertiary);font-size:21rpx}.online view{width:10rpx;height:10rpx;border-radius:50%;background:var(--ls-success)}.status{padding:6rpx 14rpx;border-radius:16rpx;background:var(--ls-success-bg);color:var(--ls-success);font-size:21rpx}.error{margin:16rpx 32rpx;padding:16rpx 20rpx;border-radius:14rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:22rpx}.conversation{position:fixed;top:calc(env(safe-area-inset-top) + 120rpx);bottom:calc(236rpx + env(safe-area-inset-bottom));left:0;right:0;padding:26rpx 32rpx;box-sizing:border-box}.welcome{display:flex;flex-direction:column;align-items:center;padding:80rpx 0 32rpx}.avatar{width:76rpx;height:76rpx;border-radius:24rpx;background:var(--ls-action-gradient);color:#fff;font-size:34rpx;font-weight:650;line-height:76rpx;text-align:center}.welcome-title{margin-top:22rpx;font-size:34rpx;font-weight:650}.welcome-note{margin-top:8rpx;color:var(--ls-text-tertiary);font-size:23rpx}.suggestions{width:100%;margin-top:32rpx;white-space:nowrap}.suggestion-row{display:inline-flex;gap:12rpx}.suggestion{padding:16rpx 22rpx;border-radius:28rpx;background:#fff;border:1rpx solid var(--ls-border-secondary);font-size:23rpx}.message{max-width:82%;margin-bottom:20rpx;padding:20rpx 23rpx;border-radius:22rpx;background:#fff}.message.user{margin-left:auto;background:var(--ls-action-gradient);color:#fff}.speaker{display:block;margin-bottom:5rpx;font-size:20rpx;opacity:.7}.message-text{font-size:27rpx;line-height:42rpx;white-space:pre-wrap}.thinking{padding:18rpx;color:var(--ls-text-tertiary);font-size:23rpx}.action-card{display:flex;justify-content:space-between;margin:12rpx 0;padding:22rpx;border-radius:18rpx;background:#fff;color:var(--ls-primary);font-size:24rpx}.preview-card,.receipts{margin:16rpx 0;padding:24rpx;border-radius:22rpx;background:#fff}.preview-title,.receipt-heading{display:block;font-size:28rpx;font-weight:600}.preview-impact{display:block;margin:10rpx 0;color:var(--ls-text-secondary);font-size:24rpx}.step{padding:7rpx 0;font-size:23rpx}.preview-buttons{display:flex;gap:14rpx;margin-top:20rpx}.preview-buttons button{flex:1;font-size:24rpx}.preview-buttons .confirm{background:var(--ls-primary);color:#fff}.receipt{display:flex;justify-content:space-between;padding-top:14rpx;color:var(--ls-text-secondary);font-size:22rpx}.composer{position:fixed;z-index:30;left:0;right:0;bottom:calc(124rpx + env(safe-area-inset-bottom));display:flex;gap:14rpx;padding:16rpx 24rpx;background:#fff;border-top:1rpx solid var(--ls-border-secondary)}.composer input{flex:1;height:76rpx;padding:0 22rpx;border-radius:20rpx;background:var(--ls-fill);font-size:26rpx}.composer button{width:120rpx;height:76rpx;margin:0;padding:0;border:0;background:var(--ls-primary);color:#fff;font-size:24rpx;line-height:76rpx}.composer button::after{border:0}
