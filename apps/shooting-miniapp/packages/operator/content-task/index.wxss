.task-page{min-height:100vh;padding:32rpx 32rpx 72rpx;box-sizing:border-box;background:var(--ls-bg)}
.loading{padding:80rpx 24rpx;text-align:center;color:var(--ls-text-secondary)}
.error{display:flex;flex-direction:column;gap:24rpx;padding:28rpx;border:1rpx solid var(--ls-error);border-radius:var(--ls-radius-panel);background:var(--ls-error-bg);color:var(--ls-error)}
.task-content{display:flex;flex-direction:column;gap:24rpx}.task-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.status{padding:8rpx 16rpx;border-radius:999rpx;font-size:24rpx;font-weight:600;background:var(--ls-fill);color:var(--ls-text-secondary)}
.status.needs_input,.status.needs_approval{background:var(--ls-warning-bg);color:var(--ls-warning)}.status.processing{background:var(--ls-info-bg);color:var(--ls-primary)}.status.failed{background:var(--ls-error-bg);color:var(--ls-error)}.status.completed{background:var(--ls-success-bg);color:var(--ls-success)}
.time{font-size:24rpx;color:var(--ls-text-tertiary);text-align:right}.title{font-size:40rpx;line-height:1.4;font-weight:600;overflow-wrap:break-word}.section{display:flex;flex-direction:column;gap:14rpx;padding:24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:var(--ls-bg)}.current{background:var(--ls-fill)}
.section-label,.metric-label{font-size:24rpx;color:var(--ls-text-tertiary)}.section-title{font-size:30rpx;line-height:1.5;font-weight:600}.body{font-size:28rpx;line-height:1.6;color:var(--ls-text-secondary);overflow-wrap:break-word}
.facts{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.facts>view{display:flex;flex-direction:column;gap:8rpx;padding:22rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel)}.metric-value{font-size:30rpx;line-height:1.4;font-weight:600;font-variant-numeric:tabular-nums}.metric-value.cost{font-size:26rpx}
.row{display:flex;justify-content:space-between;gap:24rpx;padding:16rpx 0;border-bottom:1rpx solid var(--ls-border-secondary);font-size:27rpx;line-height:1.5}.row:last-child{border-bottom:0}.row text:last-child{min-width:0;text-align:right;overflow-wrap:break-word}.row.warning{padding:18rpx;background:var(--ls-warning-bg);border:0;border-radius:var(--ls-radius-control);color:var(--ls-warning)}
.refresh{width:100%;margin-top:8rpx}
