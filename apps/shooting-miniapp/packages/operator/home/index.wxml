<view class="page-shell">
  <view class="top-safe" style="height:{{statusBarHeight}}px"></view>
  <view class="identity-bar" style="height:{{navBarHeight}}px;padding-right:{{headerRightInset}}px"><text class="organization">{{organization}}</text></view>

  <view class="content">
    <view wx:if="{{error}}" class="notice error">{{error}}<text bindtap="refresh">重试</text></view>
    <view class="week-card {{calendarExpanded ? 'expanded' : 'collapsed'}}">
      <view class="week-heading" bindtap="toggleCalendar" aria-role="button" aria-label="{{calendarExpanded ? '收起周日历' : '展开周日历'}}" aria-expanded="{{calendarExpanded}}"><view class="week-action" data-offset="-1" catchtap="changeWeek">上一周</view><view class="week-summary"><text class="week-range">{{week.start}} — {{week.end}}</text><text class="week-chevron">{{calendarExpanded ? '⌃' : '⌄'}}</text></view><view class="week-action" data-offset="1" catchtap="changeWeek">下一周</view></view>
      <view wx:if="{{calendarExpanded}}" class="days"><view wx:for="{{days}}" wx:key="date" class="day {{item.selected ? 'selected' : ''}}" data-date="{{item.date}}" bindtap="selectDay"><text class="weekday">{{item.label}}</text><text class="day-number">{{item.number}}</text><view wx:if="{{item.count}}" class="day-indicator"></view></view></view>
    </view>

    <view class="today-heading"><view class="today-title-row"><view class="today-star">★</view><view><text class="today-title">今天</text><text class="today-date">{{selectedDay}} · 只看你今天需要推进的事情</text></view></view><text class="section-count">{{loading ? '同步中' : todayTotal + ' 项'}}</text></view>
    <view wx:if="{{loading && !loaded}}" class="state-card">正在同步真实工作数据…</view>
    <view wx:elif="{{!todayGroups.length}}" class="state-card success"><view class="check">✓</view><view><text class="state-title">今天没有需要你处理的事项</text><text class="state-note">新的审批、询盘和任务卡点会显示在这里</text></view></view>
    <view wx:else class="focus-list">
      <view wx:for="{{todayGroups}}" wx:for-item="group" wx:key="key" class="focus-group {{index > 0 ? 'with-divider' : ''}}">
        <view class="focus-row" aria-role="button" aria-label="{{group.title}}，{{group.action}}" data-key="{{group.key}}" bindtap="openTodayGroup"><view class="focus-mark {{group.tone}}"></view><view class="focus-copy"><view class="focus-title-row"><text class="focus-title">{{group.title}}</text><text wx:if="{{group.badge}}" class="focus-badge">{{group.badge > 99 ? '99+' : group.badge}} 条新消息</text></view><text class="focus-note">{{group.note}}</text></view><text class="focus-action">{{group.action}} ›</text></view>
        <view wx:if="{{expandedGroup === group.key && group.key === 'matters'}}" class="focus-details"><view wx:for="{{focusMatters}}" wx:for-item="matter" wx:for-index="detailIndex" wx:key="id" class="focus-detail {{detailIndex > 0 ? 'with-divider' : ''}}" aria-role="button" data-id="{{matter.id}}" bindtap="openMatter"><view class="detail-copy"><text class="detail-title">{{matter.title}}</text><text class="detail-note">{{matter.kindLabel}}</text></view><text class="detail-arrow">›</text></view></view>
        <view wx:if="{{expandedGroup === group.key && group.key === 'acceptance'}}" class="focus-details"><view wx:for="{{todayAcceptance}}" wx:for-item="film" wx:for-index="detailIndex" wx:key="id" class="focus-detail {{detailIndex > 0 ? 'with-divider' : ''}}" aria-role="button" data-id="{{film.id}}" bindtap="openAcceptance"><view class="detail-copy"><text class="detail-title">{{film.title}}</text><text class="detail-note">待验收</text></view><text class="detail-arrow">›</text></view></view>
      </view>
    </view>

    <view class="overview-heading"><text class="overview-title">工作数据</text><text class="overview-note">本周实时概况</text></view>
    <view class="metric-band" aria-label="运营与客服六项工作数据">
      <view wx:for="{{metricGroups}}" wx:for-item="group" wx:key="key" class="metric-group {{group.key}}">
        <text class="metric-group-title">{{group.title}}</text>
        <view class="metric-row">
          <view wx:for="{{group.metrics}}" wx:for-item="metric" wx:key="key" class="overview-metric {{metric.tone}} {{metric.active ? 'active' : ''}}" aria-label="{{metric.label}} {{metric.value}}，{{metric.comparedLabel}} {{metric.compared}}"><text class="overview-label">{{metric.label}}</text><text class="overview-value">{{metric.value}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <operator-nav active="today" today-badge="{{customerUnreadCount}}" bindassistant="openAssistant"></operator-nav>
</view>
