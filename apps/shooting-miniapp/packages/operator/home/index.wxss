page{background:#fff;color:var(--ls-text)}
.page-shell{min-height:100vh;padding-bottom:calc(224rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff}
.top-safe{background:#fff}
.identity-bar{display:flex;align-items:center;min-height:88rpx;padding:0 32rpx;border-bottom:1rpx solid var(--ls-border-secondary);box-sizing:border-box;background:#fff}
.organization{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:40rpx;line-height:56rpx;font-weight:650;color:var(--ls-text)}
.content{padding:24rpx 32rpx 0}
.notice{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:88rpx;margin-bottom:20rpx;padding:16rpx 24rpx;border-radius:var(--ls-radius-panel);box-sizing:border-box;font-size:24rpx}.notice.error{background:var(--ls-error-bg);color:var(--ls-error)}.notice text{flex:none;min-width:80rpx;text-align:right;text-decoration:underline}
.week-card{margin-bottom:24rpx;padding:0 20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;transition:padding-bottom .18s ease}.week-card.expanded{padding-bottom:20rpx}
.week-heading{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;color:var(--ls-text-tertiary);font-size:22rpx}.week-action{min-width:112rpx;min-height:88rpx;display:flex;align-items:center}.week-action:last-child{justify-content:flex-end}.week-summary{min-width:0;flex:1;display:flex;align-items:center;justify-content:center;gap:10rpx}.week-range{color:var(--ls-text);font-weight:600;text-align:center}.week-chevron{width:24rpx;color:var(--ls-text-tertiary);font-size:20rpx;text-align:center}
.days{display:flex;justify-content:space-between}.day{position:relative;width:72rpx;min-height:88rpx;border-radius:var(--ls-radius-control);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ls-text-tertiary)}.day.selected{background:var(--ls-selected);color:var(--ls-text)}.weekday{font-size:20rpx}.day-number{font-size:28rpx;font-weight:600}.day-indicator{position:absolute;bottom:6rpx;width:6rpx;height:6rpx;border-radius:50%;background:var(--ls-warning)}
.today-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;margin:34rpx 0 18rpx}.today-title-row{min-width:0;display:flex;align-items:flex-start;gap:16rpx}.today-star{flex:none;width:44rpx;height:44rpx;color:#f6c445;font-size:40rpx;line-height:44rpx}.today-title,.today-date{display:block}.today-title{font-size:38rpx;line-height:46rpx;font-weight:680}.today-date{margin-top:4rpx;color:var(--ls-text-tertiary);font-size:21rpx;line-height:32rpx}.overview-heading{display:flex;align-items:baseline;justify-content:space-between;margin:42rpx 0 14rpx}.overview-title{font-size:29rpx;line-height:42rpx;font-weight:650}.overview-note{color:var(--ls-text-tertiary);font-size:21rpx}
.metric-band{overflow:hidden;border:1rpx solid var(--ls-border-secondary);border-radius:22rpx;background:#fff}
.metric-group{padding:18rpx 14rpx 20rpx}.metric-group.customer{border-top:1rpx solid var(--ls-border-secondary)}.metric-group-title{display:block;padding-left:12rpx;color:var(--ls-text-tertiary);font-size:20rpx;line-height:30rpx;font-weight:600}.metric-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.overview-metric{min-width:0;padding:12rpx 12rpx 0;display:flex;flex-direction:column;gap:8rpx}.overview-label{display:block;min-height:30rpx;color:var(--ls-text-secondary);font-size:21rpx;line-height:30rpx}.overview-value{display:block;color:var(--ls-text);font-size:44rpx;line-height:52rpx;font-weight:650;font-variant-numeric:tabular-nums}.overview-metric.active.blue .overview-value{color:var(--ls-primary)}.overview-metric.active.violet .overview-value{color:var(--ls-violet)}.overview-metric.active.amber .overview-value{color:var(--ls-warning)}.overview-metric.active.green .overview-value{color:var(--ls-success)}
.section-count{flex:none;min-height:44rpx;color:var(--ls-text-secondary);font-size:22rpx;line-height:44rpx}
.state-card{min-height:144rpx;padding:28rpx 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;color:var(--ls-text-secondary);box-sizing:border-box}.state-card.success{display:flex;align-items:center;gap:24rpx}.check{flex:none;width:56rpx;height:56rpx;border-radius:50%;background:var(--ls-success-bg);color:var(--ls-success);font-size:30rpx;line-height:56rpx;text-align:center}.state-title,.state-note{display:block}.state-title{color:var(--ls-text);font-size:28rpx;line-height:44rpx;font-weight:600}.state-note{margin-top:2rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:36rpx}
.focus-list{overflow:hidden;border-top:1rpx solid var(--ls-border-secondary);border-bottom:1rpx solid var(--ls-border-secondary);background:#fff}.focus-group.with-divider{border-top:1rpx solid var(--ls-border-secondary)}.focus-row{min-height:126rpx;padding:18rpx 4rpx;display:flex;align-items:center;gap:18rpx;box-sizing:border-box}.focus-row:active,.focus-detail:active{background:var(--ls-selected)}.focus-mark{width:34rpx;height:34rpx;flex:none;border:3rpx solid var(--ls-border);border-radius:10rpx;background:#fff;box-sizing:border-box}.focus-mark.shooting{border-color:var(--ls-warning)}.focus-mark.acceptance{border-color:var(--ls-violet)}.focus-mark.customers{border-color:var(--ls-primary)}.focus-mark.matters{border-color:var(--ls-warning)}.focus-copy{min-width:0;flex:1}.focus-title,.focus-note{display:block}.focus-title{color:var(--ls-text);font-size:28rpx;line-height:40rpx;font-weight:600}.focus-note{margin-top:4rpx;color:var(--ls-text-tertiary);font-size:21rpx;line-height:32rpx}.focus-action{flex:none;color:var(--ls-primary);font-size:21rpx;line-height:32rpx;font-weight:600}.focus-details{padding-left:56rpx;border-top:1rpx solid var(--ls-border-secondary);background:#fff}.focus-detail{min-height:84rpx;padding:14rpx 4rpx 14rpx 0;display:flex;align-items:center;gap:14rpx;box-sizing:border-box}.focus-detail.with-divider{border-top:1rpx solid var(--ls-border-secondary)}.detail-copy{min-width:0;flex:1}.detail-title,.detail-note{display:block}.detail-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24rpx;line-height:34rpx;font-weight:550}.detail-note{color:var(--ls-text-tertiary);font-size:19rpx;line-height:28rpx}.detail-arrow{color:var(--ls-text-tertiary);font-size:30rpx}
.focus-title-row{display:flex;align-items:center;gap:12rpx;min-width:0}.focus-badge{flex:none;padding:3rpx 10rpx;border-radius:999rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:18rpx;line-height:28rpx;font-weight:600}
@media (prefers-reduced-motion:reduce){.week-card{transition:none}}
