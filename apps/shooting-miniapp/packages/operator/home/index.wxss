page{background:#f4f7fb}.page-shell{min-height:100vh;padding-bottom:150rpx;box-sizing:border-box}.ambient{position:absolute;top:0;left:0;right:0;height:330rpx;background:linear-gradient(145deg,#e7f4ff 0%,#f3f0ff 60%,#f4f7fb 100%)}.top-safe{height:calc(env(safe-area-inset-top) + 20rpx)}.identity-bar{position:relative;display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 30rpx}.identity-copy{min-width:0}.organization{display:block;max-width:560rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:38rpx;line-height:52rpx;font-weight:650;color:var(--ls-text)}.edition{display:inline-flex;margin-top:8rpx;padding:5rpx 14rpx;border-radius:18rpx;background:rgba(255,255,255,.75);font-size:22rpx;color:var(--ls-primary)}.message-button{position:relative;width:80rpx;height:80rpx;margin:0;padding:0;border:0;border-radius:40rpx;background:rgba(255,255,255,.88);display:flex;align-items:center;justify-content:center}.message-button::after{border:0}.bell{width:27rpx;height:30rpx;border:4rpx solid var(--ls-text);border-top-left-radius:16rpx;border-top-right-radius:16rpx;border-bottom:0}.bell::after{content:'';display:block;width:10rpx;height:4rpx;margin:30rpx auto 0;background:var(--ls-text);border-radius:4rpx}.badge{position:absolute;top:-2rpx;right:-2rpx;min-width:30rpx;height:30rpx;padding:0 5rpx;border-radius:15rpx;background:var(--ls-error);color:#fff;font-size:18rpx;line-height:30rpx}.content{position:relative;padding:0 32rpx}.notice{display:flex;justify-content:space-between;margin-bottom:16rpx;padding:18rpx 22rpx;border-radius:var(--ls-radius-panel);font-size:24rpx}.notice.error{background:var(--ls-error-bg);color:var(--ls-error)}.week-card{padding:22rpx 20rpx 18rpx;border:1rpx solid rgba(212,212,216,.65);border-radius:24rpx;background:rgba(255,255,255,.96)}.week-heading{display:flex;justify-content:space-between;color:var(--ls-text-tertiary);font-size:22rpx}.week-range{color:var(--ls-text);font-weight:600}.days{display:flex;margin-top:20rpx;justify-content:space-between}.day{position:relative;width:72rpx;height:88rpx;border-radius:28rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ls-text-tertiary)}.day.selected{background:var(--ls-text);color:#fff}.weekday{font-size:20rpx}.day-number{font-size:28rpx;font-weight:600}.day-indicator{position:absolute;bottom:7rpx;width:7rpx;height:7rpx;border-radius:50%;background:var(--ls-warning)}.metric-band{display:flex;margin-top:22rpx;padding:24rpx 0;background:#fff;border-radius:24rpx;border:1rpx solid var(--ls-border-secondary)}.metric{flex:1;display:flex;flex-direction:column;align-items:center;border-right:1rpx solid var(--ls-border-secondary)}.metric:last-child{border-right:0}.metric-value{font-size:44rpx;line-height:54rpx;font-weight:650;font-variant-numeric:tabular-nums}.metric-label{margin-top:3rpx;color:var(--ls-text-secondary);font-size:24rpx}.primary-actions{display:flex;gap:20rpx;margin-top:22rpx}.primary-action{flex:1;min-height:168rpx;padding:24rpx;border-radius:24rpx;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between}.primary-action.shoot{background:#eaf4ff;color:#145dba}.primary-action.inquiry{background:#f0edff;color:#5635d6}.action-icon{width:48rpx;height:42rpx}.frame{border:5rpx solid currentColor;border-radius:10rpx;box-sizing:border-box}.frame view{width:20rpx;height:12rpx;margin:10rpx auto;background:currentColor;border-radius:5rpx}.chat-icon{position:relative;border:5rpx solid currentColor;border-radius:14rpx;box-sizing:border-box}.chat-icon::after{content:'';position:absolute;left:4rpx;bottom:-11rpx;border-width:9rpx 9rpx 0 0;border-style:solid;border-color:currentColor transparent transparent transparent}.action-title{display:block;font-size:31rpx;line-height:44rpx;font-weight:650}.action-note{display:block;margin-top:3rpx;font-size:21rpx;opacity:.75}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;margin:38rpx 2rpx 18rpx}.section-title{display:block;font-size:32rpx;font-weight:650}.section-note{display:block;margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx}.section-count{color:var(--ls-text-secondary);font-size:24rpx}.state-card{min-height:142rpx;padding:32rpx;border-radius:24rpx;background:#fff;color:var(--ls-text-secondary);box-sizing:border-box}.state-card.success{display:flex;align-items:center;gap:22rpx}.check{width:58rpx;height:58rpx;border-radius:50%;background:var(--ls-success-bg);color:var(--ls-success);font-size:32rpx;line-height:58rpx;text-align:center}.state-title{display:block;color:var(--ls-text);font-size:28rpx;font-weight:600}.state-note{display:block;margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx}.blocker-list{display:flex;flex-direction:column;gap:16rpx}.blocker-card{padding:26rpx 28rpx;border-radius:24rpx;background:#fff;border:1rpx solid var(--ls-border-secondary)}.blocker-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.blocker-title{font-size:29rpx;line-height:42rpx;font-weight:600}.status{flex:none;padding:4rpx 12rpx;border-radius:14rpx;background:var(--ls-warning-bg);color:var(--ls-warning);font-size:20rpx}.blocker-agent,.blocker-reason{display:block;margin-top:10rpx;font-size:23rpx;color:var(--ls-text-tertiary)}.blocker-reason{font-size:25rpx;color:var(--ls-text-secondary)}.blocker-action{display:flex;justify-content:space-between;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid var(--ls-border-secondary);color:var(--ls-primary);font-size:25rpx;font-weight:600}
