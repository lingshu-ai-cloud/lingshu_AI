page{background:#fff}
.page-shell{min-height:100vh;padding-bottom:152rpx;box-sizing:border-box;background:#fff}
.top-safe{background:#fff}
.identity-bar{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx;min-height:88rpx;padding:8rpx 32rpx 20rpx;border-bottom:1rpx solid var(--ls-border-secondary);box-sizing:border-box}
.identity-copy{min-width:0}.organization{display:block;max-width:540rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:40rpx;line-height:56rpx;font-weight:600;color:var(--ls-text)}
.edition{display:flex;align-items:center;justify-content:flex-end;gap:6rpx;min-width:120rpx;min-height:56rpx;color:var(--ls-text-secondary);font-size:24rpx}.edition-chevron{font-size:19rpx}
.content{padding:24rpx 32rpx 0}.notice{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;margin-bottom:24rpx;padding:16rpx 24rpx;border-radius:var(--ls-radius-panel);box-sizing:border-box;font-size:24rpx}.notice.error{background:var(--ls-error-bg);color:var(--ls-error)}
.week-card{padding:0 20rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;transition:padding-bottom .18s ease}.week-card.expanded{padding-bottom:20rpx}.week-heading{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;color:var(--ls-text-tertiary);font-size:22rpx}.week-action{min-width:112rpx;min-height:88rpx;display:flex;align-items:center}.week-action:last-child{justify-content:flex-end}.week-summary{min-width:0;flex:1;display:flex;align-items:center;justify-content:center;gap:10rpx}.week-range{color:var(--ls-text);font-weight:600;text-align:center}.week-chevron{width:24rpx;color:var(--ls-text-tertiary);font-size:20rpx;text-align:center}
.days{display:flex;justify-content:space-between}.day{position:relative;width:72rpx;min-height:88rpx;border-radius:var(--ls-radius-control);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ls-text-tertiary)}.day.selected{background:var(--ls-selected);color:var(--ls-text)}.weekday{font-size:20rpx}.day-number{font-size:28rpx;font-weight:600}.day-indicator{position:absolute;bottom:6rpx;width:6rpx;height:6rpx;border-radius:50%;background:var(--ls-warning)}
.metric-band{display:grid;grid-template-columns:repeat(3,1fr);margin-top:24rpx;border-top:1rpx solid var(--ls-border-secondary);border-bottom:1rpx solid var(--ls-border-secondary);background:#fff}.metric{position:relative;min-width:0;min-height:154rpx;padding:24rpx 18rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;box-sizing:border-box}.metric.active{background:linear-gradient(180deg,#fff 0%,var(--ls-selected) 100%)}.metric.active::after{content:'';position:absolute;left:18rpx;right:18rpx;bottom:0;height:4rpx;border-radius:4rpx 4rpx 0 0;background:currentColor}.metric+.metric::before{content:'';position:absolute;left:0;top:28rpx;bottom:28rpx;width:1rpx;background:var(--ls-border-secondary)}.metric-fraction{display:flex;align-items:baseline;gap:8rpx;font-variant-numeric:tabular-nums}.metric-value{font-size:48rpx;line-height:56rpx;font-weight:600;color:var(--ls-text)}.metric-denominator{font-size:24rpx;line-height:32rpx;font-weight:500;color:var(--ls-text-tertiary)}.metric:nth-child(1){color:var(--ls-primary)}.metric:nth-child(2){color:var(--ls-violet)}.metric:nth-child(3){color:var(--ls-warning)}.metric:nth-child(1) .metric-value{color:var(--ls-primary)}.metric:nth-child(2) .metric-value{color:var(--ls-violet)}.metric:nth-child(3) .metric-value{color:var(--ls-warning)}.metric-label{display:block;max-width:190rpx;margin-top:8rpx;color:var(--ls-text-secondary);font-size:21rpx;line-height:30rpx;text-align:left}
.content-template{min-height:520rpx}
.section-heading{display:flex;justify-content:space-between;align-items:flex-start;margin:40rpx 0 20rpx}.section-title{display:block;font-size:32rpx;line-height:48rpx;font-weight:600}.section-note{display:block;margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:36rpx}.section-count{min-height:44rpx;color:var(--ls-text-secondary);font-size:24rpx;line-height:44rpx}
.state-card{min-height:144rpx;padding:28rpx 24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;color:var(--ls-text-secondary);box-sizing:border-box}.state-card.success{display:flex;align-items:center;gap:24rpx}.check{flex:none;width:56rpx;height:56rpx;border-radius:50%;background:var(--ls-success-bg);color:var(--ls-success);font-size:30rpx;line-height:56rpx;text-align:center}.state-title{display:block;color:var(--ls-text);font-size:28rpx;line-height:44rpx;font-weight:600}.state-note{display:block;margin-top:2rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:36rpx}
.shot-list{display:flex;flex-direction:column;gap:16rpx}.shot-card{display:flex;align-items:center;gap:20rpx;min-height:144rpx;padding:24rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);background:#fff;box-sizing:border-box}.shot-card:active{background:var(--ls-selected)}.shot-index{flex:none;width:56rpx;height:56rpx;border-radius:var(--ls-radius-control);background:var(--ls-info-bg);color:var(--ls-primary);font-size:26rpx;font-weight:600;line-height:56rpx;text-align:center}.shot-content{min-width:0;flex:1}.shot-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.shot-title{font-size:28rpx;line-height:40rpx;font-weight:600}.status{flex:none;padding:4rpx 12rpx;border-radius:999rpx;background:var(--ls-warning-bg);color:var(--ls-warning);font-size:20rpx;line-height:30rpx}.shot-requirement{display:-webkit-box;overflow:hidden;margin-top:8rpx;color:var(--ls-text-secondary);font-size:24rpx;line-height:36rpx;-webkit-box-orient:vertical;-webkit-line-clamp:2}.shot-meta{display:flex;flex-wrap:wrap;gap:8rpx 20rpx;margin-top:12rpx;color:var(--ls-text-tertiary);font-size:21rpx;line-height:32rpx}.shot-arrow{flex:none;width:44rpx;color:var(--ls-text-tertiary);font-size:40rpx;text-align:right}
.acceptance-list{display:flex;flex-direction:column;gap:16rpx}.acceptance-card{display:flex;align-items:center;gap:20rpx;min-height:128rpx;padding:18rpx;border:1rpx solid var(--ls-border-secondary);border-radius:var(--ls-radius-panel);box-sizing:border-box}.acceptance-preview{flex:none;width:92rpx;height:92rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#ecf2ff,#e9e5ff);color:var(--ls-primary);font-size:28rpx}.acceptance-copy{min-width:0;flex:1}.acceptance-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:27rpx;line-height:40rpx;font-weight:600}.acceptance-subject{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:4rpx;color:var(--ls-text-tertiary);font-size:22rpx;line-height:34rpx}.status.review{background:#f0ebff;color:var(--ls-violet)}
.video-scroll{width:100%;padding-bottom:12rpx;white-space:nowrap}.video-row{display:inline-flex;gap:20rpx;padding-right:32rpx}.video-card{width:300rpx;overflow:hidden;border:1rpx solid var(--ls-border-secondary);border-radius:24rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(31,41,55,.06);white-space:normal}.video-cover{display:block;width:300rpx;height:184rpx;background:#eef1f6}.video-cover-empty{display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#eaf1ff,#eee8ff);color:var(--ls-primary);font-size:38rpx}.video-info{padding:20rpx}.video-tags{display:flex;align-items:center;gap:8rpx}.platform,.mock-tag{display:inline-block;padding:4rpx 12rpx;border-radius:999rpx;background:var(--ls-info-bg);color:var(--ls-primary);font-size:19rpx;line-height:28rpx}.mock-tag{background:#f1edff;color:var(--ls-violet)}.video-title{display:-webkit-box;overflow:hidden;height:72rpx;margin-top:12rpx;color:var(--ls-text);font-size:25rpx;line-height:36rpx;font-weight:600;-webkit-box-orient:vertical;-webkit-line-clamp:2}.video-views{display:block;margin-top:10rpx;color:var(--ls-text-tertiary);font-size:21rpx;line-height:32rpx}
