page{background:#f4f7fb}.management-page{min-height:100vh;padding-bottom:140rpx}.top-safe{height:calc(env(safe-area-inset-top) + 18rpx);background:linear-gradient(145deg,#e7f4ff,#f3f0ff)}.header{display:flex;align-items:center;justify-content:space-between;padding:24rpx 32rpx 30rpx;background:linear-gradient(145deg,#e7f4ff,#f3f0ff)}.organization{display:block;font-size:38rpx;font-weight:650}.edition{display:inline-block;margin-top:8rpx;padding:5rpx 14rpx;border-radius:18rpx;background:rgba(255,255,255,.8);color:var(--ls-violet);font-size:22rpx}.message-mark{width:24rpx;height:28rpx;border:4rpx solid var(--ls-text);border-radius:14rpx 14rpx 4rpx 4rpx}.content{padding:26rpx 32rpx}.error{display:flex;justify-content:space-between;margin-bottom:18rpx;padding:18rpx;border-radius:16rpx;background:var(--ls-error-bg);color:var(--ls-error);font-size:23rpx}.section-title{font-size:32rpx;font-weight:650}.metric-scroll{width:100%;margin-top:16rpx}.metric-row{display:inline-flex;gap:14rpx;padding-right:32rpx}.metric{width:220rpx;padding:24rpx;border-radius:22rpx;background:#fff;box-sizing:border-box}.metric-label,.metric-note{display:block;color:var(--ls-text-tertiary);font-size:22rpx}.metric-value{display:block;margin:7rpx 0;font-size:42rpx;font-weight:650}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:36rpx 0 16rpx}.section-note{color:var(--ls-text-tertiary);font-size:21rpx}.state{padding:50rpx 24rpx;border-radius:22rpx;background:#fff;color:var(--ls-text-tertiary);text-align:center}.agent-list{display:flex;flex-direction:column;gap:16rpx}.agent-card{padding:24rpx;border-radius:22rpx;background:#fff}.agent-heading{display:flex;align-items:center;gap:14rpx}.agent-avatar{width:52rpx;height:52rpx;border-radius:18rpx;background:var(--ls-info-bg);color:var(--ls-primary);line-height:52rpx;text-align:center;font-weight:650}.agent-name{font-size:27rpx;font-weight:600}.agent-count{margin-left:auto;color:var(--ls-text-tertiary);font-size:21rpx}.agent-empty{padding:24rpx 0 8rpx;color:var(--ls-text-tertiary);font-size:23rpx}.task-row{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;border-top:1rpx solid var(--ls-border-secondary)}.task-title,.task-stage,.task-status,.task-time{display:block}.task-title{font-size:25rpx;font-weight:600}.task-stage,.task-time{color:var(--ls-text-tertiary);font-size:21rpx}.task-status{text-align:right;color:var(--ls-primary);font-size:22rpx}.management-nav{position:fixed;left:0;right:0;bottom:0;display:flex;padding:24rpx 12rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--ls-border-secondary)}.nav{flex:1;text-align:center;color:var(--ls-text-tertiary);font-size:22rpx}.nav.active{color:var(--ls-violet);font-weight:650}
