<view class="management-page"><view class="top-safe"></view><view class="header"><view><text class="organization">{{organization}}</text><view class="edition" bindtap="switchEdition">管理版⌄</view></view><view class="message-mark"></view></view><view class="content"><view wx:if="{{error}}" class="error">{{error}}<text bindtap="load">重试</text></view><view class="section-title">经营概览</view><scroll-view scroll-x class="metric-scroll"><view class="metric-row"><view wx:for="{{metrics}}" wx:key="label" class="metric"><text class="metric-label">{{item.label}}</text><text class="metric-value">{{item.value}}</text><text class="metric-note">{{item.note}}</text></view></view></scroll-view><view class="section-heading"><text class="section-title">Agent 排期</text><text class="section-note">{{week.start}} — {{week.end}}</text></view><view wx:if="{{loading}}" class="state">正在同步经营数据…</view><view wx:elif="{{!groups.length}}" class="state">Agent 排期暂未同步</view><view wx:else class="agent-list"><view wx:for="{{groups}}" wx:key="role" class="agent-card"><view class="agent-heading"><view class="agent-avatar">枢</view><text class="agent-name">{{item.label}}</text><text class="agent-count">{{item.items.length}} 项</text></view><view wx:if="{{!item.items.length}}" class="agent-empty">当前没有安排任务</view><view wx:for="{{item.items}}" wx:for-item="task" wx:key="id" class="task-row"><view><text class="task-title">{{task.title}}</text><text class="task-stage">{{task.stageLabel}}</text></view><view><text class="task-status">{{task.statusLabel}}</text><text class="task-time">{{task.timeLabel}}</text></view></view></view></view></view><view class="management-nav"><view class="nav active">总览</view><view class="nav">Agent</view><view class="nav">审批</view><view class="nav">消息</view><view class="nav">我的</view></view></view>
